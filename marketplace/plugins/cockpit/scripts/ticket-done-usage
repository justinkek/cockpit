#!/usr/bin/env bash
set -euo pipefail

card_id="${1:-}"
if [ -z "$card_id" ]; then
  echo "usage: ticket-done-usage <card-id>" >&2
  exit 1
fi

STATE_DIR="$HOME/.local/state/claude-ticket-sessions"
cost_sum=0
tokens_sum=0
has_cost=false
has_tokens=false

if [ -d "$STATE_DIR" ]; then
  for marker in "$STATE_DIR"/*.ticket; do
    [ -f "$marker" ] || continue

    marker_card=$(cat "$marker" 2>/dev/null) || continue
    [ "$marker_card" = "$card_id" ] || continue

    usage_file="${marker%.ticket}.usage"
    [ -f "$usage_file" ] || continue

    _cost=""; _tok_cumul=""; _tok_legacy=""
    while IFS='=' read -r key val; do
      case "$key" in
        cost_usd)       _cost="$val" ;;
        tokens_k_cumul) _tok_cumul="$val" ;;
        tokens_k)       _tok_legacy="$val" ;;
      esac
    done < "$usage_file"

    if [ -n "$_cost" ]; then
      has_cost=true
      cost_sum=$(printf '%s + %s\n' "$cost_sum" "$_cost" | bc)
    fi

    _tok="${_tok_cumul:-$_tok_legacy}"
    if [ -n "$_tok" ]; then
      has_tokens=true
      tokens_sum=$(printf '%s + %s\n' "$tokens_sum" "$_tok" | bc)
    fi
  done
fi

as_json_total() {
  local recorded="$1" sum="$2"
  if [ "$recorded" != true ]; then
    printf 'null'
    return
  fi
  case "$sum" in
    .*) printf '0%s' "$sum" ;;
    *) printf '%s' "$sum" ;;
  esac
}

printf '{"cost_usd": %s, "tokens_k": %s}\n' "$(as_json_total "$has_cost" "$cost_sum")" "$(as_json_total "$has_tokens" "$tokens_sum")"
