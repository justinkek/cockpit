#!/usr/bin/env bash
#
# board-card - the cockpit board, kept as one markdown file per record.
#
#   board-card init
#   board-card create [--kind card|epic|project|sprint|reference] --name <name> [--type Feature|Bug|Timebox]
#                     [--status <column>] [--epic <EPIC-n>] [--icon <emoji>] [--timebox-mins <n>] [--body -]
#                     [--start <date>] [--end <date>] [--dev-days <n>] [--speed <n>] [--priority <n>] [--repo <url>]
#   board-card show <id> [--json | --section <heading> | <property>...]
#   board-card list [--kind card|epic|project|sprint|reference] [--status <column>] [--epic <EPIC-n>] [--archived] [--json]
#   board-card statuses [--kind card|epic]
#   board-card set <id> <field> <value>
#   board-card section <id> <heading> [--before <heading> | --after <heading>] [--under <heading>] < <content>
#   board-card bounce <id> <gate>
#   board-card move <id> <column>
#   board-card walk <id> <column> [--skip <column>]...
#   board-card link <parent-id> <child-id>
#   board-card unlink <parent-id> <child-id>
#   board-card claim <id>
#   board-card release <id>
#   board-card release-session <session-id>
#   board-card comment <id> [--anchor <text> | --reply <comment-id>] [--author <name>] < <text>
#   board-card comments <id> [--all] [--json]
#   board-card resolve <id> <comment-id>
#   board-card attach <id> <file>
#   board-card usage <id>
#   board-card archive <id>
#   board-card unarchive <id>
#   board-card duplicate <id> [--name <name>] [--status <column>]
#   board-card history <id>
#   board-card undo <id>
#   board-card path [<id>]
#
# Exit codes:
#   0  done
#   1  claimed by another session
#   2  usage, or a value the field refuses
#   3  no such record
#   4  a walk that would go backwards
#   5  the board directory could not be locked
#   6  written, but the board's git repository refused the commit
#   7  no such section
#   8  a record whose file does not parse
#
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
source "${CLAUDE_SHARED_DIR:-$HOME/.claude-shared}/ticket-state-lib.sh"

BOARD_DIR="${COCKPIT_BOARD_DIR:-$HOME/.local/state/cockpit/board}"
CLAIM_LOCK="${TICKET_CLAIM_LOCK:-$here/ticket-claim-lock}"
DONE_USAGE="${TICKET_DONE_USAGE:-$here/ticket-done-usage}"

CARD_COLUMNS=(
  "Backlog"
  "Ready for BR by AI" "In BR by AI" "Ready for BR" "In BR"
  "Ready for TR by AI" "In TR by AI" "Ready for TR" "In TR"
  "Ready for Sprint" "Sprint Backlog" "Daily Plan"
  "In Dev"
  "In CR by AI" "Ready for CR" "In CR"
  "Ready for FR" "In FR"
  "Ready for Validation" "Done"
)

CARD_PARKED=("Deprioritised")

CARD_STAMPED=(
  "Ready for BR" "In BR" "Ready for TR" "In TR" "Ready for Sprint" "In Dev"
  "Ready for CR" "In CR" "Ready for FR" "In FR" "Ready for Validation" "Done"
)

EPIC_COLUMNS=(
  "Ready for FD by AI" "In FD by AI" "Ready for FD" "In FD"
  "Ready for TD by AI" "In TD by AI" "Ready for TD" "In TD"
  "Ready for Ticket Breakdown by AI" "In Ticket Breakdown by AI" "Ready for Ticket Breakdown" "In Ticket Breakdown"
  "Tickets In Dev" "Epic Done"
)

FIBONACCI=" 0 1 2 3 5 8 13 21 34 "
GATES=" BR TR Dev CR FR Validation "
MODEL_STAGES=" BR TR Dev CR "

die() {
  local status="$1"
  shift
  echo "[board-card] $*" >&2
  exit "$status"
}

now() { printf '%s\n' "${COCKPIT_NOW:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"; }

prefix_of_type() {
  case "$1" in
    Feature) printf '%s\n' FEAT ;;
    Bug) printf '%s\n' BUG ;;
    Timebox) printf '%s\n' TIME ;;
    *) die 2 "type is Feature, Bug or Timebox, not '$1'" ;;
  esac
}

prefix_of_kind() {
  case "$1" in
    card) printf '%s\n' FEAT ;;
    epic) printf '%s\n' EPIC ;;
    project) printf '%s\n' PRJ ;;
    sprint) printf '%s\n' SPR ;;
    reference) printf '%s\n' REF ;;
    *) die 2 "kind is card, epic, project, sprint or reference, not '$1'" ;;
  esac
}

kind_of() {
  case "${1%%-*}" in
    FEAT|BUG|TIME) printf '%s\n' card ;;
    EPIC) printf '%s\n' epic ;;
    PRJ) printf '%s\n' project ;;
    SPR) printf '%s\n' sprint ;;
    REF) printf '%s\n' reference ;;
    *) die 2 "no board holds ids starting '${1%%-*}-'" ;;
  esac
}

directory_of_kind() {
  case "$1" in
    card) printf '%s\n' "$BOARD_DIR/cards" ;;
    epic) printf '%s\n' "$BOARD_DIR/epics" ;;
    project) printf '%s\n' "$BOARD_DIR/projects" ;;
    sprint) printf '%s\n' "$BOARD_DIR/sprints" ;;
    reference) printf '%s\n' "$BOARD_DIR/references" ;;
  esac
}

walk_columns() {
  case "$1" in
    card) printf '%s\n' "${CARD_COLUMNS[@]}" ;;
    epic) printf '%s\n' "${EPIC_COLUMNS[@]}" ;;
  esac
}

parked_columns() {
  case "$1" in
    card) printf '%s\n' "${CARD_PARKED[@]}" ;;
  esac
}

column_index() {
  local kind="$1" wanted="$2" index=0 column
  while IFS= read -r column; do
    if [ "$column" = "$wanted" ]; then
      printf '%s\n' "$index"
      return 0
    fi
    index=$((index + 1))
  done < <(walk_columns "$kind")
  return 1
}

column_at() {
  walk_columns "$1" | sed -n "$(($2 + 1))p"
}

is_parked() {
  parked_columns "$1" | grep --quiet --line-regexp --fixed-strings -- "$2"
}

is_stamped() {
  local kind="$1" column="$2" stamped
  [ "$kind" = epic ] && return 0
  for stamped in "${CARD_STAMPED[@]}"; do
    [ "$stamped" = "$column" ] && return 0
  done
  return 1
}

has_board() {
  case "$1" in card|epic) return 0 ;; *) return 1 ;; esac
}

require_column() {
  local kind="$1" column="$2"
  has_board "$kind" || return 0
  column_index "$kind" "$column" >/dev/null || is_parked "$kind" "$column" \
    || die 2 "not a $kind column: '$column' - one of: $( { walk_columns "$kind"; parked_columns "$kind"; } | paste -sd ',' - | sed 's/,/, /g')"
}

normalise_id() {
  local id
  id="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"
  printf '%s' "$id" | grep --quiet --extended-regexp '^[A-Z][A-Z0-9]*-[0-9]+$' || die 2 "not a board id: '$1'"
  kind_of "$id" >/dev/null
  printf '%s\n' "$id"
}

record_file() { printf '%s/%s.md\n' "$(directory_of_kind "$(kind_of "$1")")" "$1"; }

comments_file() { printf '%s/%s.comments.jsonl\n' "$(directory_of_kind "$(kind_of "$1")")" "$1"; }

archive_file() {
  local directory
  directory="$(directory_of_kind "$(kind_of "$1")")"
  printf '%s/archive/%s/%s.md\n' "$BOARD_DIR" "${directory##*/}" "$1"
}

require_record() {
  if [ -f "$(record_file "$1")" ]; then
    read_record "$1" >/dev/null
    return 0
  fi
  [ ! -f "$(archive_file "$1")" ] || die 3 "$1 is archived - run: board-card unarchive $1"
  die 3 "no record $1 in $(directory_of_kind "$(kind_of "$1")")"
}

require_board() {
  [ -d "$BOARD_DIR/cards" ] || die 3 "no board at $BOARD_DIR - run: board-card init"
}

board_git() {
  (
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR
    git -C "$BOARD_DIR" "$@"
  )
}

commit_board() {
  local subject="$1" ids index_lock="$BOARD_DIR/.git/index.lock"
  [ -d "$BOARD_DIR/.git" ] || return 0
  if [ -n "$(find "$index_lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then rm -f "$index_lock"; fi
  board_git add --all >/dev/null || return 1
  board_git diff --cached --quiet && return 0
  ids="$(board_git diff --cached --name-only --no-renames \
    | sed -n -E 's#^(archive/)?[a-z]+/([A-Z][A-Z0-9]*-[0-9]+)[./].*#\2#p' | awk '!seen[$0]++' | paste -sd ' ' -)"
  board_git -c user.name=board-card -c user.email=board-card@localhost -c commit.gpgsign=false \
    commit --quiet --no-verify --message "$subject${ids:+ $ids}" >/dev/null
}

with_lock() {
  local lock="$BOARD_DIR/.lock" tries=0
  until mkdir "$lock" 2>/dev/null; do
    tries=$((tries + 1))
    if [ "$tries" -ge 50 ]; then
      if [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
        rm -rf "$lock"
        continue
      fi
      die 5 "board is locked by another writer: $lock"
    fi
    sleep 0.1
  done
  trap 'rm -rf "$BOARD_DIR/.lock"' EXIT
  if [ -d "$BOARD_DIR/.git" ] && [ -n "$(board_git status --porcelain 2>/dev/null)" ]; then
    commit_board unrecorded 2>/dev/null || true
  fi
  local status=0
  "$@" || status=$?
  if [ "$status" -eq 0 ]; then
    commit_board "$action" || die 6 "wrote to $BOARD_DIR but could not commit it"
  fi
  rm -rf "$lock"
  trap - EXIT
  return "$status"
}

parse_program='
  [range(0; length) as $i | select(.[$i] == "---") | $i] as $marks
  | . as $lines
  | ($lines[($marks[0] + 1):$marks[1]]) as $front
  | ($lines[($marks[1] + 1):] | join("\n") | sub("^\n+"; "") | sub("\n+$"; "")) as $body
  | reduce $front[] as $line ({object: {}, nested: null};
      if ($line | startswith("  ")) then
        ($line | capture("^  (?<key>\"(?:[^\"\\\\]|\\\\.)*\"): (?<value>.*)$")) as $pair
        | .object[.nested][$pair.key | fromjson] = ($pair.value | fromjson)
      else
        ($line | capture("^(?<key>[a-z_]+):(?: (?<value>.*))?$")) as $pair
        | if ($pair.value // "") == ""
          then .nested = $pair.key | .object[$pair.key] = {}
          else .nested = null | .object[$pair.key] = ($pair.value | fromjson)
          end
      end)
  | .object + {body: $body}'

render_program='
  ["id", "name", "icon", "type", "status", "epic", "project", "sprint", "due", "blocked",
   "dependent_on", "dependency_for", "complexity", "session", "claimed_at", "prs", "cost_usd", "tokens_k",
   "created", "moved", "updated", "rank", "models", "back_from", "reference", "dates"] as $order
  | . as $record
  | ($order + ((keys - $order - ["body"]) | sort)) as $keys
  | ["---"]
    + [ $keys[] as $key | select($record | has($key))
        | if ($record[$key] | type) == "object" and ($record[$key] | length) > 0
          then "\($key):", ($record[$key] | to_entries[] | "  \(.key | tojson): \(.value | tojson)")
          else "\($key): \($record[$key] | tojson)"
          end ]
    + ["---"]
    + (if ($record.body // "") == "" then [] else ["", $record.body] end)
  | join("\n")'

derived_program='
  def epoch:
    if type != "string" then null
    else [capture("^(?<day>[0-9]{4}-[0-9]{2}-[0-9]{2})(?:T(?<time>[0-9]{2}:[0-9]{2}(?::[0-9]{2})?)(?:\\.[0-9]+)?(?<zone>Z|[+-][0-9]{2}:?[0-9]{2})?)?$")
          | try (((.day + "T" + ((.time // "00:00") | if length == 5 then . + ":00" else . end) + "Z") | fromdateiso8601)
                 - (if (.zone // "Z") == "Z" then 0
                    else .zone | (if startswith("-") then -60 else 60 end) * ((.[1:3] | tonumber) * 60 + (.[-2:] | tonumber)) end))
            catch empty][0]
    end;
  def working_minutes:
    epoch as $seconds
    | if $seconds == null then null
      else ($seconds / 86400 | floor) as $day
        | ($day % 7) as $into_week
        | (($seconds - $day * 86400) / 60 | floor) as $minute
        | (5 * ($day / 7 | floor) + ([2, $into_week] | min) + ([0, $into_week - 4] | max)) * 510
          + (if (($day + 4) % 7) as $weekday | $weekday == 0 or $weekday == 6 then 0 else [0, ([510, $minute - 570] | min)] | max end)
      end;
  def derived($now):
    if (.id // "" | test("^(FEAT|BUG|TIME)-")) | not then .
    else ($now | working_minutes) as $now_minutes
      | (.dates // {}) as $dates
      | ($dates["In Dev"] | working_minutes) as $in_dev
      | (if $dates["Ready for CR"] == null then $now_minutes else $dates["Ready for CR"] | working_minutes end) as $dev_end
      | (if $in_dev == null or $dev_end == null then null else [0, $dev_end - $in_dev] | max end) as $dev_minutes
      | (if .status | IN("Ready for BR", "In BR", "Ready for TR by AI", "Ready for TR", "In TR", "Ready for Sprint",
                         "In Dev", "Ready for CR", "In CR", "Ready for FR", "In FR", "Ready for Validation")
         then $dates[.status] | working_minutes else null end) as $since
      | . + {
          days_in_column: (if $since == null or $now_minutes == null then 0 else [0, $now_minutes - $since] | max | . / 510 | round end),
          overrunning: (if $dev_minutes == null then false
                        elif .type == "Timebox" and (.timebox_mins // 0) > 0 then $dev_minutes > .timebox_mins
                        elif (.complexity // 0) > 0 then $dev_minutes > .complexity * 102
                        else false end)}
    end;'

parse_file() {
  jq --raw-input --null-input "[inputs] | $parse_program" < "$1" 2>/dev/null \
    || die 8 "${1##*/} does not parse - fix its front matter by hand: $1"
}

read_record() { parse_file "$(record_file "$1")"; }

write_record() {
  local id="$1" touch="${2:-}" json file tmp current
  json="$(cat)"
  file="$(record_file "$id")"
  json="$(printf '%s' "$json" | jq --exit-status 'select(type == "object") | .body = ((.body // "") | sub("^\n+"; "") | sub("\n+$"; ""))' 2>/dev/null)" \
    || die 2 "refused to write $id with nothing in it"
  if [ -f "$file" ]; then
    current="$(read_record "$id")" || exit "$?"
    if [ -z "$touch" ] && { printf '%s' "$current"; printf '%s' "$json"; } \
      | jq --slurp --exit-status '(.[0] | del(.updated)) == (.[1] | del(.updated))' >/dev/null; then
      return 0
    fi
  fi
  mkdir -p "$(dirname "$file")"
  tmp="$(mktemp "$(dirname "$file")/.$id.XXXXXX")"
  if ! printf '%s' "$json" | jq --raw-output --arg stamp "$(now)" ".updated = \$stamp | $render_program" > "$tmp" || [ ! -s "$tmp" ]; then
    rm -f "$tmp"
    die 2 "refused to write $id with nothing in it"
  fi
  mv "$tmp" "$file"
}

touch_record() { read_record "$1" | write_record "$1" touch; }

update_record() {
  local id="$1"
  shift
  read_record "$id" | jq "$@" | write_record "$id"
}

command_init() {
  local changed=false
  mkdir -p "$BOARD_DIR/cards" "$BOARD_DIR/epics" "$BOARD_DIR/projects" "$BOARD_DIR/sprints" "$BOARD_DIR/references"
  if [ ! -d "$BOARD_DIR/.git" ]; then
    board_git init --quiet
    changed=true
  fi
  if [ ! -f "$BOARD_DIR/.gitignore" ] || ! grep --quiet '^\*/\.\*$' "$BOARD_DIR/.gitignore"; then
    printf '.lock\n*/.*\n' > "$BOARD_DIR/.gitignore"
    changed=true
  fi
  if [ "$changed" = true ]; then
    commit_board init || die 6 "made $BOARD_DIR but could not commit it"
  fi
  printf '%s\n' "$BOARD_DIR"
}

next_id() {
  local kind="$1" type="${2:-}" prefix directory highest=0 file number
  prefix="$(prefix_of_kind "$kind")"
  [ "$kind" = card ] && prefix="$(prefix_of_type "$type")"
  directory="$(directory_of_kind "$kind")"
  for file in "$directory"/*.md "$BOARD_DIR/archive/${directory##*/}"/*.md; do
    [ -f "$file" ] || continue
    number="${file##*/}"
    number="${number%.md}"
    number="${number##*-}"
    case "$number" in *[!0-9]*|"") continue ;; esac
    [ "$number" -gt "$highest" ] && highest="$number"
  done
  printf '%s-%s\n' "$prefix" "$((highest + 1))"
}

create_locked() {
  local kind="$1" name="$2" type="$3" status="$4" epic="$5" body="$6" fields="${7:-"{}"}" id stamp stamped=false
  id="$(next_id "$kind" "$type")"
  stamp="$(now)"
  if has_board "$kind" && is_stamped "$kind" "$status"; then stamped=true; fi
  jq --null-input \
    --arg kind "$kind" --arg id "$id" --arg name "$name" --arg type "$type" --arg status "$status" \
    --arg epic "$epic" --arg stamp "$stamp" \
    --arg body "$body" --argjson stamped "$stamped" --argjson fields "$fields" '
    def blank: if . == "" then null else . end;
    if $kind == "card" then
      {id: $id, name: $name, type: $type, status: $status, epic: ($epic | blank),
       sprint: null, due: null, blocked: null, dependent_on: [], dependency_for: [],
       complexity: null, session: null, claimed_at: null,
       prs: null, cost_usd: null, tokens_k: null, created: $stamp, models: {}, back_from: {}, timebox_mins: null}
    else
      {id: $id, name: $name, status: ($status | blank), created: $stamp}
    end
    + {dates: (if $stamped then {($status): $stamp} else {} end), body: $body}
    + $fields' \
    | write_record "$id"
  printf '%s\n' "$id"
}

command_create() {
  local kind=card name="" type="Feature" status="" epic="" body="" fields="{}" pairs=() index value timebox="" timebox_given=false start="" end=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --kind) kind="${2:-}"; shift 2 ;;
      --name) name="${2:-}"; shift 2 ;;
      --type) type="${2:-}"; shift 2 ;;
      --status) status="${2:-}"; shift 2 ;;
      --epic) epic="${2:-}"; shift 2 ;;
      --icon) pairs+=("icon" "${2:-}"); shift 2 ;;
      --timebox-mins) timebox="${2:-}"; timebox_given=true; shift 2 ;;
      --start) start="${2:-}"; pairs+=("start" "$start"); shift 2 ;;
      --end) end="${2:-}"; pairs+=("end" "$end"); shift 2 ;;
      --dev-days) pairs+=("dev_days" "${2:-}"); shift 2 ;;
      --speed) pairs+=("speed" "${2:-}"); shift 2 ;;
      --priority) pairs+=("priority" "${2:-}"); shift 2 ;;
      --repo) pairs+=("repo" "${2:-}"); shift 2 ;;
      --body) [ "${2:-}" = "-" ] || die 2 "--body reads stdin: pass --body -"; body="$(cat)"; shift 2 ;;
      *) die 2 "create: unknown option '$1'" ;;
    esac
  done
  prefix_of_kind "$kind" >/dev/null
  [ -n "$name" ] || die 2 "create needs --name"
  if [ -z "$status" ]; then
    case "$kind" in
      card) status="Backlog" ;;
      epic) status="Ready for FD by AI" ;;
      project) status="Not started" ;;
    esac
  fi
  [ "$kind" != project ] || field_json project status "$status" >/dev/null || exit "$?"
  [ "$kind" = card ] && case "$type" in Feature|Bug|Timebox) ;; *) die 2 "type is Feature, Bug or Timebox, not '$type'" ;; esac
  if [ "$timebox_given" = true ]; then
    pairs+=("timebox_mins" "$timebox")
  elif [ "$kind" = card ] && [ "$type" = Timebox ]; then
    pairs+=("timebox_mins" "60")
  fi
  require_column "$kind" "$status"
  if [ -n "$epic" ]; then
    epic="$(normalise_id "$epic")"
    require_record "$epic"
  fi
  for ((index = 0; index < ${#pairs[@]}; index += 2)); do
    value="$(field_json "$kind" "${pairs[index]}" "${pairs[index + 1]}")" || exit "$?"
    fields="$(jq --compact-output --arg field "${pairs[index]}" --argjson value "$value" '. + {($field): $value}' <<<"$fields")"
  done
  check_sprint_span "$start" "$end"
  require_board
  with_lock create_locked "$kind" "$name" "$type" "$status" "$epic" "$body" "$fields"
}

PROPERTY_FIELDS='{
  "Name": "name", "Icon": "icon", "Status": "status", "Type": "type", "Epic": "epic", "Project": "project",
  "Sprint": "sprint", "Sprints": "sprint", "Due": "due", "Blocked": "blocked", "PRs": "prs",
  "Agent: Session Id": "session", "Complexity": "complexity", "Timebox (mins)": "timebox_mins",
  "Dependent on": "dependent_on", "Dependency for": "dependency_for",
  "Session Cost (USD)": "cost_usd", "Session Tokens (k)": "tokens_k",
  "Cost": "cost_usd", "Tokens": "tokens_k",
  "Start Date": "start", "End Date": "end", "Dev Days": "dev_days", "Speed": "speed",
  "Priority": "priority", "Repo": "repo",
  "Points": "points", "Why this score": "why", "Description": "description", "Domain": "domain", "Stack": "stack", "Ticket": "card"}'

require_properties() {
  local unknown
  unknown="$(jq --null-input --raw-output --argjson fields "$PROPERTY_FIELDS" '
    [$ARGS.positional[] as $property
     | select((($fields | has($property)) or ($property | startswith("Date: ") or startswith("Model: ") or startswith("Back from "))) | not)
     | $property]
    | .[0] // empty' --args "$@")"
  [ -z "$unknown" ] || die 2 "no property '$unknown' - one of: $(printf '%s' "$PROPERTY_FIELDS" | jq --raw-output 'keys_unsorted | join(", ")'), Date: <column>, Model: <stage>, Back from <gate>"
}

property_value() {
  local json="$1" property="$2"
  printf '%s' "$json" | jq --raw-output --arg property "$property" --argjson fields "$PROPERTY_FIELDS" '
    def text: if type == "array" then join(" ") elif type == "object" then (to_entries | map("\(.key)=\(.value)") | join(" ")) else tostring end;
    if ($property | startswith("Date: ")) then .dates[$property[6:]] // empty
    elif ($property | startswith("Model: ")) then .models[$property[7:]] // empty
    elif ($property | startswith("Back from ")) then .back_from[$property[10:]] // empty
    else .[$fields[$property]] // empty end
    | select(. != [] and . != "" and . != {})
    | text'
}

section_lines() {
  local body="$1" heading="$2"
  printf '%s\n' "$body" | awk -v wanted="$heading" '
    /^```/ { fenced = !fenced }
    !fenced && /^#+ / { line = $0; level = length($0) - length(substr($0, index($0, " "))); sub(/^#+ /, "", line)
      if (inside && level <= depth) inside = 0
      if (line == wanted) { inside = 1; depth = level } }
    inside { print NR "\t" $0 }'
}

open_comments_json() {
  local id="$1" file
  file="$(comments_file "$id")"
  [ -f "$file" ] || { printf '[]\n'; return 0; }
  jq --slurp '
    group_by(.thread)
    | map(select(.[0].resolved | not))
    | map({thread: .[0].thread, anchor: .[0].anchor, comments: map({id, author, at, text})})' "$file"
}

command_show() {
  local id json property value
  id="$(normalise_id "${1:-}")"
  shift
  require_record "$id"
  json="$(read_record "$id")"
  if [ "${1:-}" = "--json" ]; then
    printf '%s\n' "$json" | jq --arg now "$(now)" "$derived_program derived(\$now)"
    return 0
  fi
  if [ "${1:-}" = "--section" ]; then
    local heading="${2:-}" body numbered threads
    while [ "${heading#\#}" != "$heading" ]; do heading="${heading#\#}"; done
    heading="${heading# }"
    body="$(printf '%s' "$json" | jq --raw-output '.body')"
    numbered="$(section_lines "$body" "$heading")"
    [ -n "$numbered" ] || die 7 "$id has no section '$heading'"
    printf '%s\n' "$numbered" | cut -f2-
    threads="$(open_comments_json "$id")"
    printf '%s' "$threads" | jq --raw-output --arg body "$body" \
      --argjson lines "$(printf '%s\n' "$numbered" | cut -f1 | jq --slurp --compact-output .)" '
      .[] | . as $thread
      | select($thread.anchor != null and ($body | contains($thread.anchor)))
      | select($lines | index($body | split($thread.anchor)[0] | [scan("\n")] | length + 1))
      | .comments[] | "[comment] \(.author): \(.text)"'
    printf '%s' "$threads" | jq --raw-output '
      .[] | select(.anchor == null) | .comments[] | "[comment on the page] \(.author): \(.text)"'
    return 0
  fi
  if [ "$#" -eq 0 ]; then
    set -- "Name" "Status" "Type" "Epic" "Agent: Session Id" "PRs" "Complexity" "Dependent on" "Dependency for"
  fi
  require_properties "$@"
  for property in "$@"; do
    value="$(property_value "$json" "$property")"
    [ -n "$value" ] && printf '%s\t%s\n' "$property" "$value"
  done
  return 0
}

command_list() {
  local kind=card status="" epic="" as_json=false archived=false directory
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --kind) kind="${2:-}"; shift 2 ;;
      --status) status="${2:-}"; shift 2 ;;
      --epic) epic="$(normalise_id "${2:-}")"; shift 2 ;;
      --archived) archived=true; shift ;;
      --json) as_json=true; shift ;;
      *) die 2 "list: unknown option '$1'" ;;
    esac
  done
  prefix_of_kind "$kind" >/dev/null
  [ -n "$status" ] && require_column "$kind" "$status"
  require_board
  directory="$(directory_of_kind "$kind")"
  [ "$archived" = false ] || directory="$BOARD_DIR/archive/${directory##*/}"
  local files=("$directory"/*.md) records file
  [ -f "${files[0]}" ] || files=(/dev/null)
  if ! records="$(jq --raw-input --null-input "[inputs | {file: input_filename, line: .}] | group_by(.file) | map(map(.line) | $parse_program)" "${files[@]}" 2>/dev/null)"; then
    for file in "${files[@]}"; do parse_file "$file" >/dev/null; done
    die 8 "a record in $directory does not parse"
  fi
  printf '%s' "$records" \
    | jq --arg status "$status" --arg epic "$epic" --arg now "$(now)" "$derived_program"'
      map(select(($status == "" or .status == $status) and ($epic == "" or .epic == $epic)))
      | sort_by(.id | split("-") | (.[0]), (.[1] | tonumber))
      | map(derived($now))' \
    | if [ "$as_json" = true ]; then
        cat
      else
        jq --raw-output '.[] | [.id, (.status // "-"), (.session // "-"), .name] | @tsv'
      fi
}

command_statuses() {
  local kind=card
  [ "${1:-}" = "--kind" ] && kind="${2:-}"
  has_board "$kind" || die 2 "only cards and epics have columns"
  walk_columns "$kind"
  parked_columns "$kind"
}

is_fibonacci() {
  printf '%s' "$1" | grep --quiet --extended-regexp '^[0-9]+$' || return 1
  case "$FIBONACCI" in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

check_complexity() {
  local id="$1" value="$2" children
  is_fibonacci "$value" || die 2 "complexity is a Fibonacci number ($FIBONACCI), not '$value'"
  children="$(read_record "$id" | jq '.dependent_on // [] | length')"
  if [ "$value" = "0" ] && [ "$children" -eq 0 ]; then
    die 2 "complexity 0 is for a split parent, and $id has no children"
  fi
  if [ "$value" != "0" ] && [ "$children" -gt 0 ]; then
    die 2 "$id is a split parent, so its complexity is 0"
  fi
}

property_of_field() {
  case "$1" in
    complexity) echo Complexity ;;
    timebox_mins) echo "Timebox (mins)" ;;
    start) echo "Start Date" ;;
    end) echo "End Date" ;;
    dev_days) echo "Dev Days" ;;
    speed) echo Speed ;;
    status) echo Status ;;
    priority) echo Priority ;;
    repo) echo Repo ;;
    points) echo Points ;;
    why) echo "Why this score" ;;
    description) echo Description ;;
    domain) echo Domain ;;
    stack) echo Stack ;;
    card) echo Ticket ;;
    reference.*) property_of_field "${1#reference.}" ;;
    name) echo Name ;;
    icon) echo Icon ;;
    type) echo Type ;;
    epic) echo Epic ;;
    project) echo Project ;;
    session) echo "Agent: Session Id" ;;
    blocked) echo Blocked ;;
    prs) echo PRs ;;
    due) echo Due ;;
    sprint) echo Sprint ;;
    models.*) echo "Model: ${1#models.}" ;;
    back_from.*) echo "Back from ${1#back_from.}" ;;
  esac
}

nullable() { if [ -z "$1" ]; then echo null; else jq --null-input --arg value "$1" '$value'; fi; }

EMOJI_SHOWN='[[8986,8987],[9193,9196],[9200,9200],[9203,9203],[9725,9726],[9748,9749],[9800,9811],[9855,9855],[9875,9875],
  [9889,9889],[9898,9899],[9917,9918],[9924,9925],[9934,9934],[9940,9940],[9962,9962],[9970,9971],[9973,9973],[9978,9978],
  [9981,9981],[9989,9989],[9994,9995],[10024,10024],[10060,10060],[10062,10062],[10067,10069],[10071,10071],[10133,10135],
  [10160,10160],[10175,10175],[11035,11036],[11088,11088],[11093,11093]]'

EMOJI_AS_TEXT='[[169,169],[174,174],[8252,8252],[8265,8265],[8482,8482],[8505,8505],[8596,8601],[8617,8618],[9000,9000],
  [9167,9167],[9197,9199],[9201,9202],[9208,9210],[9410,9410],[9642,9643],[9654,9654],[9664,9664],[9723,9724],[9728,9732],
  [9742,9742],[9745,9745],[9752,9752],[9757,9757],[9760,9760],[9762,9763],[9766,9766],[9770,9770],[9774,9775],[9784,9786],
  [9792,9792],[9794,9794],[9823,9824],[9827,9827],[9829,9830],[9832,9832],[9851,9851],[9854,9854],[9874,9874],[9876,9879],
  [9881,9881],[9883,9884],[9888,9888],[9895,9895],[9904,9905],[9928,9928],[9935,9935],[9937,9937],[9939,9939],[9961,9961],
  [9968,9969],[9972,9972],[9975,9977],[9986,9986],[9992,9993],[9996,9997],[9999,9999],[10002,10002],[10004,10004],
  [10006,10006],[10013,10013],[10017,10017],[10035,10036],[10052,10052],[10055,10055],[10083,10084],[10145,10145],
  [10548,10549],[11013,11015],[12336,12336],[12349,12349],[12951,12951],[12953,12953]]'

check_icon() {
  jq --null-input --exit-status --arg value "$1" --argjson shown "$EMOJI_SHOWN" --argjson textual "$EMOJI_AS_TEXT" '
    def within($ranges): . as $point | any($ranges[]; $point >= .[0] and $point <= .[1]);
    def pictograph: within($shown)
      or (. >= 126976 and . <= 129791 and (. < 127462 or . > 127487) and (. < 127995 or . > 127999));
    def flag: . >= 127462 and . <= 127487;
    def joiner: . == 8205;
    def modifier: . == 65038 or . == 65039 or . == 8419 or (. >= 127995 and . <= 127999) or (. >= 917536 and . <= 917631);
    def keycap: . == 35 or . == 42 or (. >= 48 and . <= 57);
    ($value | explode) as $points
    | [range(0; $points | length) as $at | $points[$at]
       | if pictograph then "pictograph"
         elif within($textual) then (if $points[$at + 1] == 65039 or ($at > 0 and $points[$at - 1] == 8205) then "pictograph" else "text" end)
         elif flag then "flag" elif joiner then "joiner" elif modifier then "modifier" elif keycap then "keycap"
         else "text" end] as $classes
    | ([$classes[] | select(. == "pictograph")] | length) as $pictographs
    | ([$classes[] | select(. == "flag")] | length) as $flags
    | ([$classes[] | select(. == "keycap")] | length) as $keys
    | ([$classes[] | select(. == "joiner")] | length) as $joins
    | all($classes[]; . != "text")
      and (if $flags > 0 then $flags == 2 and $pictographs + $keys + $joins == 0
           elif $keys > 0 then $keys == 1 and $pictographs + $joins == 0 and any($points[]; . == 8419)
           else $pictographs == $joins + 1 end)' >/dev/null || die 2 "an icon is one emoji, not '$1'"
}

check_sprint_span() {
  local start="$1" end="$2"
  [ -z "$start" ] || [ -z "$end" ] || [[ ! "$end" < "$start" ]] || die 2 "a sprint ends on or after the day it starts, and $end is before $start"
}

field_json() {
  local kind="$1" field="$2" value="$3"
  case "$field" in
    icon)
      [ -z "$value" ] || check_icon "$value"
      nullable "$value"
      ;;
    timebox_mins)
      [ "$kind" = card ] || die 2 "only a card has a timebox, and this is a $kind"
      [ -z "$value" ] || printf '%s' "$value" | grep --quiet --extended-regexp '^[1-9][0-9]*$' || die 2 "a timebox is a whole number of minutes, not '$value'"
      if [ -z "$value" ]; then echo null; else printf '%s\n' "$value"; fi
      ;;
    start|end)
      [ "$kind" = sprint ] || die 2 "only a sprint has a $field date, and this is a $kind"
      [ -z "$value" ] || jq --null-input --exit-status --arg value "$value" \
        'try ($value | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") and ($value + "T00:00:00Z" | fromdateiso8601 | todate | .[:10]) == $value) catch false' >/dev/null \
        || die 2 "a sprint's $field is a date like 2026-10-12, not '$value'"
      nullable "$value"
      ;;
    dev_days|speed)
      [ "$kind" = sprint ] || die 2 "only a sprint has $field, and this is a $kind"
      [ -z "$value" ] || printf '%s' "$value" | grep --quiet --extended-regexp '^[0-9]+(\.[0-9]+)?$' || die 2 "a sprint's $field is a number, not '$value'"
      if [ -z "$value" ]; then echo null; else jq --null-input --arg value "$value" '$value | tonumber'; fi
      ;;
    status)
      [ "$kind" = project ] || die 2 "status changes through: board-card move or board-card walk"
      case "$value" in "Not started"|"In progress"|"Done") ;; *) die 2 "a project's status is Not started, In progress or Done, not '$value'" ;; esac
      nullable "$value"
      ;;
    priority)
      [ "$kind" = project ] || die 2 "only a project has a priority, and this is a $kind"
      [ -z "$value" ] || printf '%s' "$value" | grep --quiet --extended-regexp '^[0-9]+$' || die 2 "a project's priority is a whole number, not '$value'"
      if [ -z "$value" ]; then echo null; else jq --null-input --arg value "$value" '$value | tonumber'; fi
      ;;
    repo)
      [ "$kind" = project ] || die 2 "only a project has a repo, and this is a $kind"
      [ -z "$value" ] || printf '%s' "$value" | grep --quiet --extended-regexp '^https?://[^[:space:]]+$' || die 2 "a project's repo is a URL, not '$value'"
      nullable "$value"
      ;;
    points)
      [ "$kind" = reference ] || die 2 "only a reference ticket has points, and this is a $kind"
      [ -z "$value" ] || is_fibonacci "$value" || die 2 "points are a Fibonacci number ($FIBONACCI), not '$value'"
      if [ -z "$value" ]; then echo null; else printf '%s\n' "$value"; fi
      ;;
    why|description|stack)
      [ "$kind" = reference ] || die 2 "only a reference ticket has $field, and this is a $kind"
      nullable "$value"
      ;;
    domain)
      [ "$kind" = reference ] || die 2 "only a reference ticket has a domain, and this is a $kind"
      case "$value" in ""|Tech|Bizdev) ;; *) die 2 "a domain is Tech or Bizdev, not '$value'" ;; esac
      nullable "$value"
      ;;
    card)
      [ "$kind" = reference ] || die 2 "only a reference ticket names the card it was taken from, and this is a $kind"
      if [ -n "$value" ]; then
        value="$(normalise_id "$value")" || exit "$?"
        [ "$(kind_of "$value")" = card ] || die 2 "$value is not a card"
        require_record "$value"
      fi
      nullable "$value"
      ;;
    *) die 2 "no field '$field' on a $kind" ;;
  esac
}

rename_card() {
  local from="$1" to="$2" directory file lock_dir marker
  directory="$BOARD_DIR/cards"
  read_record "$from" | jq --arg to "$to" '.id = $to' | write_record "$to"
  rm -f "$directory/$from.md"
  [ -f "$directory/$from.comments.jsonl" ] && mv "$directory/$from.comments.jsonl" "$directory/$to.comments.jsonl"
  [ -d "$BOARD_DIR/attachments/$from" ] && mv "$BOARD_DIR/attachments/$from" "$BOARD_DIR/attachments/$to"
  for file in "$BOARD_DIR"/cards/*.md "$BOARD_DIR"/references/*.md; do
    [ -f "$file" ] || continue
    grep --quiet --fixed-strings "\"$from\"" "$file" || continue
    local other="${file##*/}"
    other="${other%.md}"
    update_record "$other" --arg from "$from" --arg to "$to" '
      (if has("dependent_on") then .dependent_on |= map(if . == $from then $to else . end) else . end)
      | (if has("dependency_for") then .dependency_for |= map(if . == $from then $to else . end) else . end)
      | if .card == $from then .card = $to else . end'
  done
  lock_dir="${TICKET_CLAIM_LOCK_DIR:-$HOME/.local/state/claude-ticket-claims}"
  [ -d "$lock_dir/$from" ] && [ ! -e "$lock_dir/$to" ] && mv "$lock_dir/$from" "$lock_dir/$to"
  for marker in "$TICKET_STATE_DIR"/*.ticket; do
    [ -f "$marker" ] || continue
    [ "$(cat "$marker")" = "$from" ] && printf '%s\n' "$to" > "$marker"
  done
  return 0
}

unnest_reference_program='
  if (.id | startswith("REF-")) and ((.reference // null) | type) == "object" then
    .reference as $nested
    | del(.reference)
    | reduce ($nested | to_entries[]) as $entry (.;
        if ($entry.key | IN("points", "why", "description", "domain", "stack", "card"))
        then .[$entry.key] = (if $entry.key == "points" then ($entry.value | tonumber? // $entry.value) else $entry.value end)
        else .reference[$entry.key] = $entry.value end)
  else . end'

set_locked() {
  local id="$1" field="$2" value="$3" reference json
  case "$field" in
    complexity)
      if [ -z "$value" ]; then
        update_record "$id" '.complexity = null'
      else
        check_complexity "$id" "$value"
        update_record "$id" --argjson value "$value" '.complexity = $value'
      fi
      ;;
    type)
      local renamed
      [ "$(kind_of "$id")" = card ] || die 2 "only a card has a type, and $id is not a card"
      prefix_of_type "$value" >/dev/null
      renamed="$(prefix_of_type "$value")-${id##*-}"
      [ "$renamed" = "$id" ] || { [ ! -e "$BOARD_DIR/cards/$renamed.md" ] && [ ! -e "$BOARD_DIR/archive/cards/$renamed.md" ]; } || die 2 "$renamed already exists"
      update_record "$id" --arg value "$value" '.type = $value'
      if [ "$renamed" != "$id" ]; then
        rename_card "$id" "$renamed"
        RENAMED_TO="$renamed"
      fi
      ;;
    name)
      [ -n "$value" ] || die 2 "a record needs a name"
      update_record "$id" --arg value "$value" '.name = $value'
      ;;
    icon|timebox_mins|start|end|dev_days|speed|priority|repo|status|points|why|description|domain|stack|card)
      json="$(field_json "$(kind_of "$id")" "$field" "$value")" || exit "$?"
      case "$field" in
        start) check_sprint_span "$value" "$(read_record "$id" | jq --raw-output '.end // empty')" ;;
        end) check_sprint_span "$(read_record "$id" | jq --raw-output '.start // empty')" "$value" ;;
      esac
      update_record "$id" --arg field "$field" --argjson value "$json" "$unnest_reference_program | .[\$field] = \$value"
      ;;
    epic|project|sprint)
      reference=""
      if [ -n "$value" ]; then
        reference="$(normalise_id "$value")"
        require_record "$reference"
        [ "$(kind_of "$reference")" = "$field" ] || die 2 "$reference is not a $field"
      fi
      update_record "$id" --arg field "$field" --argjson value "$(nullable "$reference")" '.[$field] = $value'
      ;;
    due)
      [ -z "$value" ] || printf '%s' "$value" | grep --quiet --extended-regexp '^[0-9]{4}-[0-9]{2}-[0-9]{2}' || die 2 "due is a date, not '$value'"
      update_record "$id" --argjson value "$(nullable "$value")" '.due = $value'
      ;;
    session|blocked|prs)
      update_record "$id" --arg field "$field" --argjson value "$(nullable "$value")" '.[$field] = $value'
      ;;
    models.*)
      case "$MODEL_STAGES" in *" ${field#models.} "*) ;; *) die 2 "a model is recorded for $MODEL_STAGES, not '${field#models.}'" ;; esac
      update_record "$id" --arg key "${field#models.}" --argjson value "$(nullable "$value")" '.models = ((.models // {}) + {($key): $value} | with_entries(select(.value != null)))'
      ;;
    reference.*)
      case "${field#reference.}" in
        points|why|description|domain|stack|card) set_locked "$id" "${field#reference.}" "$value" ;;
        *) die 2 "a reference ticket has points, why, description, domain, stack and card, not '${field#reference.}'" ;;
      esac
      ;;
    body)
      update_record "$id" --arg value "$value" '.body = $value'
      ;;
    rank)
      printf '%s' "$value" | grep --quiet --extended-regexp '^-?[0-9]+(\.[0-9]+)?$' || die 2 "rank is a number, not '$value'"
      update_record "$id" --argjson value "$value" '.rank = $value'
      ;;
    back_from.*) die 2 "a bounce counter moves through: board-card bounce" ;;
    *) die 2 "no settable field '$field' - one of: name, icon, type, epic, project, sprint, due, blocked, prs, complexity, timebox_mins, start, end, dev_days, speed, priority, repo, status of a project, points, why, description, domain, stack, card, session, body, rank, models.<stage>" ;;
  esac
}

command_set() {
  local id field="${2:-}" property
  id="$(normalise_id "${1:-}")"
  [ "$#" -ge 3 ] || die 2 "usage: board-card set <id> <field> <value>"
  require_record "$id"
  RENAMED_TO=""
  with_lock set_locked "$id" "$field" "$3"
  if [ -n "$RENAMED_TO" ]; then
    printf 'renamed %s to %s\n' "$id" "$RENAMED_TO"
    id="$RENAMED_TO"
  fi
  property="$(property_of_field "$field")"
  [ -z "$property" ] || command_show "$id" "$property"
}

section_locked() {
  local id="$1" heading="$2" after="$3" under="$4" content="$5" before="$6" body updated
  body="$(read_record "$id" | jq --raw-output '.body')"
  updated="$(printf '%s\n' "$body" | HEADING="$heading" AFTER="$after" BEFORE="$before" UNDER="$under" CONTENT="$content" awk '
    function title_of(text) { sub(/^#+ /, "", text); return text }
    function level_of(text) { return length(text) - length(substr(text, index(text, " "))) }
    function find(title, from, to, deeper,   k) {
      for (k = from; k <= to; k++) if (level[k] > deeper && title_of(line[k]) == title) return k
      return 0
    }
    function section_end(start, to,   k) {
      for (k = start + 1; k <= to; k++) if (level[k] > 0 && level[k] <= level[start]) return k - 1
      return to
    }
    function hashes(count,   text) { text = ""; while (count-- > 0) text = text "#"; return text }
    {
      line[NR] = $0
      if ($0 ~ /^```/) fenced = !fenced
      level[NR] = (!fenced && $0 ~ /^#+ /) ? level_of($0) : 0
    }
    END {
      total = NR
      heading = ENVIRON["HEADING"]; after = ENVIRON["AFTER"]; before = ENVIRON["BEFORE"]; under = ENVIRON["UNDER"]; content = ENVIRON["CONTENT"]
      gap = (content ~ /^\n/) ? "" : "\n"
      first = 1; last = total; floor = 0; prefix = "##"
      if (under != "") {
        parent = find(under, 1, total, 0)
        if (!parent) {
          if (total > 0 && line[total] != "") line[++total] = ""
          line[++total] = "## " under; level[total] = 2; parent = total
        }
        first = parent + 1; last = section_end(parent, total); floor = level[parent]; prefix = hashes(level[parent] + 1)
      }
      target = find(heading, first, last, floor)
      if (target) {
        stop = section_end(target, last)
        for (k = 1; k <= target; k++) print line[k]
        if (content != "") print gap content
        if (stop < total && line[stop] == "" ) print ""
        for (k = stop + 1; k <= total; k++) print line[k]
        exit
      }
      insert = last
      if (before != "") {
        anchor = find(before, first, last, floor)
        if (anchor) {
          for (k = 1; k < anchor; k++) print line[k]
          print prefix " " heading
          if (content != "") print gap content
          print ""
          for (k = anchor; k <= total; k++) print line[k]
          exit
        }
      }
      if (after != "") {
        anchor = find(after, first, last, floor)
        if (anchor) insert = section_end(anchor, last)
      }
      while (insert >= first && line[insert] == "" && insert > 0) insert--
      if (insert < first - 1) insert = first - 1
      for (k = 1; k <= insert; k++) print line[k]
      if (insert > 0) print ""
      print prefix " " heading
      if (content != "") print gap content
      if (insert < total) print ""
      for (k = insert + 1; k <= total; k++) if (!(k == insert + 1 && line[k] == "")) print line[k]
    }')"
  update_record "$id" --arg value "$updated" '.body = $value'
}

command_section() {
  local id heading="${2:-}" after="" under="" before=""
  id="$(normalise_id "${1:-}")"
  [ -n "$heading" ] || die 2 "usage: board-card section <id> <heading> [--before <heading> | --after <heading>] [--under <heading>] < content"
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --after) after="${2:-}"; shift 2 ;;
      --before) before="${2:-}"; shift 2 ;;
      --under) under="${2:-}"; shift 2 ;;
      *) die 2 "section: unknown option '$1'" ;;
    esac
  done
  heading="${heading#"${heading%%[!#]*}"}"; heading="${heading# }"
  after="${after#"${after%%[!#]*}"}"; after="${after# }"
  under="${under#"${under%%[!#]*}"}"; under="${under# }"
  before="${before#"${before%%[!#]*}"}"; before="${before# }"
  require_record "$id"
  with_lock section_locked "$id" "$heading" "$after" "$under" "$(cat)" "$before"
  printf '%s\twrote section %s\n' "$id" "$heading"
}

command_bounce() {
  local id gate="${2:-}"
  id="$(normalise_id "${1:-}")"
  case "$GATES" in *" $gate "*) ;; *) die 2 "a bounce is back from one of:$GATES- not '$gate'" ;; esac
  require_record "$id"
  with_lock update_record "$id" --arg gate "$gate" '.back_from = ((.back_from // {}) + {($gate): (((.back_from // {})[$gate] // 0) + 1)})'
  command_show "$id" "Back from $gate"
}

hop() {
  local id="$1" column="$2" kind from stamped=false
  kind="$(kind_of "$id")"
  from="$(read_record "$id" | jq --raw-output '.status')"
  [ "$from" = "$column" ] && return 0
  if is_stamped "$kind" "$column"; then stamped=true; fi
  update_record "$id" --arg column "$column" --arg stamp "$(now)" --argjson stamped "$stamped" '
    .status = $column
    | .moved = $stamp
    | if $stamped and ((.dates // {}) | has($column) | not)
      then .dates = ((.dates // {}) + {($column): $stamp}) else . end'
  printf '%s\t%s -> %s\n' "$id" "$from" "$column"
}

command_move() {
  local id column="${2:-}" kind
  id="$(normalise_id "${1:-}")"
  kind="$(kind_of "$id")"
  has_board "$kind" || die 2 "a $kind has no columns"
  [ -n "$column" ] || die 2 "usage: board-card move <id> <column>"
  require_column "$kind" "$column"
  require_record "$id"
  with_lock hop "$id" "$column"
}

walk_locked() {
  local id="$1" target="$2"
  shift 2
  local kind current from_index target_index i column skipped skip
  kind="$(kind_of "$id")"
  current="$(read_record "$id" | jq --raw-output '.status')"
  if is_parked "$kind" "$current" || is_parked "$kind" "$target"; then
    die 2 "a walk does not pass through $(is_parked "$kind" "$current" && echo "$current" || echo "$target") - use: board-card move"
  fi
  from_index="$(column_index "$kind" "$current")" || die 2 "$id sits in '$current', which is not a $kind column"
  target_index="$(column_index "$kind" "$target")"
  if [ "$target_index" -lt "$from_index" ]; then
    die 4 "$id sits in $current, so $target is behind it - a walk only goes forward"
  fi
  if [ "$target_index" -eq "$from_index" ]; then
    printf '%s\talready in %s\n' "$id" "$current"
    return 0
  fi
  for ((i = from_index + 1; i <= target_index; i++)); do
    column="$(column_at "$kind" "$i")"
    skipped=false
    if [ "$i" -lt "$target_index" ]; then
      for skip in "$@"; do
        [ "$skip" = "$column" ] && skipped=true
      done
    fi
    [ "$skipped" = true ] && continue
    hop "$id" "$column"
  done
}

command_walk() {
  local id target="${2:-}" kind skips=()
  id="$(normalise_id "${1:-}")"
  kind="$(kind_of "$id")"
  has_board "$kind" || die 2 "a $kind has no columns"
  [ -n "$target" ] || die 2 "usage: board-card walk <id> <column> [--skip <column>]..."
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --skip)
        require_column "$kind" "${2:-}"
        case "$2" in "In Dev"|"Done"|"Epic Done") die 2 "$2 cannot be skipped" ;; esac
        skips+=("$2")
        shift 2
        ;;
      *) die 2 "walk: unknown option '$1'" ;;
    esac
  done
  require_column "$kind" "$target"
  require_record "$id"
  with_lock walk_locked "$id" "$target" ${skips[@]+"${skips[@]}"}
}

link_locked() {
  local parent="$1" child="$2" action="$3"
  if [ "$action" = link ]; then
    update_record "$parent" --arg child "$child" '.dependent_on = ((.dependent_on // []) + [$child] | unique) | .complexity = 0'
    update_record "$child" --arg parent "$parent" '.dependency_for = ((.dependency_for // []) + [$parent] | unique)'
  else
    update_record "$parent" --arg child "$child" '.dependent_on = ((.dependent_on // []) - [$child])
      | if (.dependent_on | length) == 0 and .complexity == 0 then .complexity = null else . end'
    update_record "$child" --arg parent "$parent" '.dependency_for = ((.dependency_for // []) - [$parent])'
  fi
}

command_link() {
  local action="$1" parent child
  parent="$(normalise_id "${2:-}")"
  child="$(normalise_id "${3:-}")"
  [ "$parent" != "$child" ] || die 2 "a card cannot depend on itself"
  [ "$(kind_of "$parent")" = card ] && [ "$(kind_of "$child")" = card ] || die 2 "only cards depend on cards"
  require_record "$parent"
  require_record "$child"
  with_lock link_locked "$parent" "$child" "$action"
  command_show "$parent" "Dependent on" "Complexity"
}

command_claim() {
  local id me
  id="$(normalise_id "${1:-}")"
  require_record "$id"
  me="$(session_id)"
  [ -n "$me" ] || die 2 "no session id - set CLAUDE_SESSION_ID or CLAUDE_CODE_SESSION_ID"
  "$CLAIM_LOCK" take "$id" >/dev/null || die 1 "$id is held by session $("$CLAIM_LOCK" owner "$id")"
  with_lock update_record "$id" --arg me "$me" --arg stamp "$(now)" '.session = $me | .claimed_at = $stamp'
  printf 'claimed %s\n' "$id"
}

command_release() {
  local id
  id="$(normalise_id "${1:-}")"
  require_record "$id"
  "$CLAIM_LOCK" release "$id" >/dev/null || die 1 "$id is held by session $("$CLAIM_LOCK" owner "$id"), not this one"
  with_lock update_record "$id" '.session = null | .claimed_at = null'
  printf 'released %s\n' "$id"
}

release_session_locked() {
  local session="$1" id kind
  for kind in card epic; do
    for id in $(command_list --kind "$kind" --json | jq --raw-output --arg session "$session" '.[] | select(.session == $session) | .id'); do
      update_record "$id" '.session = null | .claimed_at = null'
      printf 'released %s\n' "$id"
    done
  done
}

command_release_session() {
  local session="${1:-}"
  [ -n "$session" ] || die 2 "usage: board-card release-session <session-id>"
  [ -d "$BOARD_DIR/cards" ] || return 0
  with_lock release_session_locked "$session"
}

default_author() {
  if [ -n "${COCKPIT_AUTHOR:-}" ]; then
    printf '%s\n' "$COCKPIT_AUTHOR"
  elif [ -n "$(session_id)" ]; then
    printf 'claude %s\n' "$(session_id | cut -c1-8)"
  else
    printf '%s\n' "${USER:-someone}"
  fi
}

comment_locked() {
  local id="$1" anchor="$2" reply="$3" author="$4" text="$5" file comment_id thread line
  file="$(comments_file "$id")"
  comment_id="c$(( $( [ -f "$file" ] && wc -l < "$file" || echo 0 ) + 1 ))"
  thread="$comment_id"
  if [ -n "$reply" ]; then
    [ -f "$file" ] && thread="$(jq --raw-output --arg reply "$reply" 'select(.id == $reply) | .thread' "$file")"
    [ -n "$thread" ] && [ "$thread" != "$comment_id" ] || die 3 "no comment $reply on $id"
    anchor=""
  fi
  line="$(jq --null-input --compact-output \
    --arg id "$comment_id" --arg thread "$thread" --arg anchor "$anchor" --arg author "$author" \
    --arg at "$(now)" --arg text "$text" \
    '{id: $id, thread: $thread, anchor: (if $anchor == "" then null else $anchor end),
      author: $author, at: $at, text: $text, resolved: false}')"
  printf '%s\n' "$line" >> "$file"
  touch_record "$id"
  printf '%s\n' "$comment_id"
}

command_comment() {
  local id anchor="" reply="" author="" text body
  id="$(normalise_id "${1:-}")"
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --anchor) anchor="${2:-}"; shift 2 ;;
      --reply) reply="${2:-}"; shift 2 ;;
      --author) author="${2:-}"; shift 2 ;;
      *) die 2 "comment: unknown option '$1'" ;;
    esac
  done
  require_record "$id"
  text="$(cat)"
  [ -n "$text" ] || die 2 "a comment needs text on stdin"
  if [ -n "$anchor" ]; then
    body="$(read_record "$id" | jq --raw-output '.body')"
    case "$body" in *"$anchor"*) ;; *) die 2 "the anchor text is not in $id's body: '$anchor'" ;; esac
  fi
  [ -n "$author" ] || author="$(default_author)"
  with_lock comment_locked "$id" "$anchor" "$reply" "$author" "$text"
}

command_comments() {
  local id all=false as_json=false file
  id="$(normalise_id "${1:-}")"
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --all) all=true; shift ;;
      --json) as_json=true; shift ;;
      *) die 2 "comments: unknown option '$1'" ;;
    esac
  done
  require_record "$id"
  file="$(comments_file "$id")"
  local threads
  if [ ! -f "$file" ]; then
    threads='[]'
  else
    threads="$(jq --slurp --argjson all "$all" '
      group_by(.thread)
      | map(select($all or (.[0].resolved | not)))
      | map({thread: .[0].thread, anchor: .[0].anchor, resolved: .[0].resolved, comments: map({id, author, at, text})})' "$file")"
  fi
  if [ "$as_json" = true ]; then
    printf '%s\n' "$threads"
  else
    printf '%s' "$threads" | jq --raw-output '
      .[] | "\(.thread)\(if .resolved then " (resolved)" else "" end) on \(if .anchor then "\"\(.anchor)\"" else "the page" end)",
            (.comments[] | "  \(.id) \(.author): \(.text | gsub("\n"; "\n    "))")'
  fi
}

resolve_locked() {
  local id="$1" comment_id="$2" file tmp
  file="$(comments_file "$id")"
  [ -f "$file" ] && jq --exit-status --arg comment "$comment_id" 'select(.id == $comment and .id == .thread)' "$file" >/dev/null \
    || die 3 "no thread $comment_id on $id"
  if jq --exit-status --arg comment "$comment_id" 'select(.id == $comment and .resolved)' "$file" >/dev/null; then return 0; fi
  tmp="$(mktemp "$(dirname "$file")/.$id.comments.XXXXXX")"
  jq --compact-output --arg comment "$comment_id" 'if .id == $comment then .resolved = true else . end' "$file" > "$tmp"
  mv "$tmp" "$file"
  touch_record "$id"
}

command_resolve() {
  local id comment_id="${2:-}"
  id="$(normalise_id "${1:-}")"
  [ -n "$comment_id" ] || die 2 "usage: board-card resolve <id> <comment-id>"
  require_record "$id"
  with_lock resolve_locked "$id" "$comment_id"
  printf 'resolved %s on %s\n' "$comment_id" "$id"
}

attach_locked() {
  local id="$1" source="$2" name="$3"
  if cmp -s "$source" "$BOARD_DIR/attachments/$id/$name"; then return 0; fi
  mkdir -p "$BOARD_DIR/attachments/$id"
  cp "$source" "$BOARD_DIR/attachments/$id/$name"
  touch_record "$id"
}

command_attach() {
  local id source="${2:-}" name
  id="$(normalise_id "${1:-}")"
  [ -f "$source" ] || die 2 "usage: board-card attach <id> <file> - no file at '$source'"
  require_record "$id"
  name="$(basename "$source")"
  with_lock attach_locked "$id" "$source" "$name"
  printf 'attachments/%s/%s\n' "$id" "$name"
}

command_usage() {
  local id usage
  id="$(normalise_id "${1:-}")"
  require_record "$id"
  usage="$("$DONE_USAGE" "$id")"
  with_lock update_record "$id" --argjson usage "$usage" '.cost_usd = $usage.cost_usd | .tokens_k = $usage.tokens_k'
  printf '%s\n' "$usage"
}

archive_locked() {
  local id="$1" direction="$2" directory from to
  directory="$(directory_of_kind "$(kind_of "$id")")"
  directory="${directory##*/}"
  from="$BOARD_DIR"
  to="$BOARD_DIR/archive"
  if [ "$direction" = archive ]; then
    touch_record "$id"
  else
    from="$BOARD_DIR/archive"
    to="$BOARD_DIR"
  fi
  mkdir -p "$to/$directory"
  mv "$from/$directory/$id.md" "$to/$directory/$id.md"
  if [ -f "$from/$directory/$id.comments.jsonl" ]; then mv "$from/$directory/$id.comments.jsonl" "$to/$directory/$id.comments.jsonl"; fi
  if [ -d "$from/attachments/$id" ]; then
    mkdir -p "$to/attachments"
    mv "$from/attachments/$id" "$to/attachments/$id"
  fi
  if [ "$direction" = unarchive ]; then touch_record "$id"; fi
  printf '%sd %s\n' "$direction" "$id"
}

naming_records() {
  local id="$1" file
  { grep --files-with-matches --fixed-strings "\"$id\"" \
      "$BOARD_DIR"/cards/*.md "$BOARD_DIR"/epics/*.md "$BOARD_DIR"/projects/*.md "$BOARD_DIR"/sprints/*.md "$BOARD_DIR"/references/*.md 2>/dev/null || true; } \
    | while IFS= read -r file; do
        parse_file "$file" | jq --raw-output --arg id "$id" '
          . as $record
          | [(("epic", "project", "sprint", "card") as $field | select($record[$field] == $id) | $field),
             (("dependent_on", "dependency_for") as $field
              | select(any($record[$field] | if type == "array" then .[] else empty end; . == $id)) | $field)]
          | select(length > 0 and $record.id != $id)
          | "\($record.id) (\(join(", ")))"'
      done
}

require_unnamed() {
  local id="$1" links named
  links="$(read_record "$id" | jq --raw-output '[(.dependent_on // [])[], (.dependency_for // [])[]] | join(", ")')"
  [ -z "$links" ] || die 2 "$id is linked to $links - run board-card unlink first"
  named="$(naming_records "$id" | paste -sd ',' - | sed 's/,/, /g')"
  [ -z "$named" ] || die 2 "$id is still named by $named - point them elsewhere first"
}

command_archive() {
  local id
  id="$(normalise_id "${1:-}")"
  require_record "$id"
  require_unnamed "$id"
  with_lock archive_locked "$id" archive
}

command_unarchive() {
  local id
  id="$(normalise_id "${1:-}")"
  [ -f "$(archive_file "$id")" ] || die 3 "no archived record $id"
  [ ! -e "$(record_file "$id")" ] || die 2 "$id is on the board already"
  with_lock archive_locked "$id" unarchive
}

duplicate_locked() {
  local id="$1" name="$2" status="$3" kind source fields epic project
  kind="$(kind_of "$id")"
  source="$(read_record "$id")"
  epic="$(printf '%s' "$source" | jq --raw-output '.epic // ""')"
  [ -z "$epic" ] || [ -f "$(record_file "$epic")" ] || epic=""
  project="$(printf '%s' "$source" | jq --raw-output '.project // ""')"
  [ -z "$project" ] || [ -f "$(record_file "$project")" ] || project=""
  fields="$(printf '%s' "$source" | jq --compact-output --arg project "$project" '
    {project: (if $project == "" then null else $project end), icon, timebox_mins,
     complexity: (if .complexity == 0 then null else .complexity end)}
    | with_entries(select(.value != null))')"
  create_locked "$kind" "$name" "$(printf '%s' "$source" | jq --raw-output '.type // ""')" "$status" \
    "$epic" "$(printf '%s' "$source" | jq --raw-output '.body // ""')" "$fields"
}

command_duplicate() {
  local id name="" status="" kind
  id="$(normalise_id "${1:-}")"
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name) name="${2:-}"; shift 2 ;;
      --status) status="${2:-}"; shift 2 ;;
      *) die 2 "duplicate: unknown option '$1'" ;;
    esac
  done
  kind="$(kind_of "$id")"
  has_board "$kind" || die 2 "only a card or an epic is duplicated, and $id is a $kind"
  require_record "$id"
  [ -n "$name" ] || name="Copy of $(read_record "$id" | jq --raw-output '.name')"
  [ -n "$status" ] || status="$(column_at "$kind" 0)"
  require_column "$kind" "$status"
  with_lock duplicate_locked "$id" "$name" "$status"
}

record_paths() {
  local id="$1" which="${2:-}" directory
  directory="$(directory_of_kind "$(kind_of "$id")")"
  directory="${directory##*/}"
  printf '%s\n' "$directory/$id.md" "$directory/$id.comments.jsonl" "attachments/$id"
  [ "$which" = live ] || printf '%s\n' "archive/$directory/$id.md" "archive/$directory/$id.comments.jsonl" "archive/attachments/$id"
}

require_history() {
  [ -d "$BOARD_DIR/.git" ] || die 2 "the board at $BOARD_DIR keeps no history - run: board-card init"
}

command_history() {
  local id paths=() path log
  id="$(normalise_id "${1:-}")"
  require_history
  while IFS= read -r path; do paths+=("$path"); done < <(record_paths "$id")
  log="$(TZ=UTC board_git log --format='%h%x09%ad%x09%s' --date=format-local:'%Y-%m-%dT%H:%M:%SZ' -- "${paths[@]}" 2>/dev/null || true)"
  [ -n "$log" ] || die 3 "no history for $id"
  printf '%s\n' "$log"
}

undo_locked() {
  local id="$1" paths=() path commit
  while IFS= read -r path; do paths+=("$path"); done < <(record_paths "$id" live)
  commit="$(board_git log -1 --format=%H -- "${paths[@]}")"
  [ -n "$commit" ] || die 2 "$id has no committed version to go back to"
  board_git cat-file -e "$commit^:${paths[0]}" 2>/dev/null \
    || die 2 "$id has no version before $(board_git log -1 --format='%h %s' "$commit"), which made it"
  while IFS= read -r path; do
    if board_git cat-file -e "$commit^:$path" 2>/dev/null; then
      mkdir -p "$BOARD_DIR/$(dirname "$path")"
      board_git show "$commit^:$path" > "$BOARD_DIR/$path"
    else
      rm -f "$BOARD_DIR/$path"
    fi
  done < <(board_git diff --name-only --no-renames "$commit^" "$commit" -- "${paths[@]}")
  touch_record "$id"
  printf '%s\tundid %s\n' "$id" "$(board_git log -1 --format='%h %s' "$commit")"
}

command_undo() {
  local id
  id="$(normalise_id "${1:-}")"
  require_record "$id"
  require_history
  with_lock undo_locked "$id"
}

command_path() {
  if [ -n "${1:-}" ]; then
    record_file "$(normalise_id "$1")"
  else
    printf '%s\n' "$BOARD_DIR"
  fi
}

command -v jq >/dev/null 2>&1 || die 2 "jq is required"

action="${1:-}"
[ "$#" -gt 0 ] && shift
case "$action" in
  init) command_init ;;
  create) command_create "$@" ;;
  show) command_show "$@" ;;
  list) command_list "$@" ;;
  statuses) command_statuses "$@" ;;
  set) command_set "$@" ;;
  section) command_section "$@" ;;
  bounce) command_bounce "$@" ;;
  move) command_move "$@" ;;
  walk) command_walk "$@" ;;
  link) command_link link "$@" ;;
  unlink) command_link unlink "$@" ;;
  claim) command_claim "$@" ;;
  release) command_release "$@" ;;
  release-session) command_release_session "$@" ;;
  comment) command_comment "$@" ;;
  comments) command_comments "$@" ;;
  resolve) command_resolve "$@" ;;
  attach) command_attach "$@" ;;
  usage) command_usage "$@" ;;
  archive) command_archive "$@" ;;
  unarchive) command_unarchive "$@" ;;
  duplicate) command_duplicate "$@" ;;
  history) command_history "$@" ;;
  undo) command_undo "$@" ;;
  path) command_path "$@" ;;
  *) sed -n '3,/^#   board-card path/p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
