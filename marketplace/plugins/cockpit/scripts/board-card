check_icon() {
  jq --null-input --exit-status --arg value "$1" --argjson shown "$EMOJI_SHOWN" --argjson textual "$EMOJI_AS_TEXT" '
    def within($ranges): . as $point | any($ranges[]; $point >= .[0] and $point <= .[1]);
    def pictograph: within($shown)
      or (. >= 126976 and . <= 129791 and (. < 127462 or . > 127487) and (. < 127995 or . > 127999));
    def flag: . >= 127462 and . <= 127487;
    def joiner: . == 8205;
    def modifier: . == 65038 or . == 65039 or . == 8419 or (. >= 127995 and . <= 127999) or (. >= 917536 and . <= 917631);
    def keycap: . == 35 or . == 42 or (. >= 48 and . <= 57);
    ($value | explode) as $points
    | [range(0; $points | length) as $at | $points[$at]
       | if pictograph then "pictograph"
         elif within($textual) then (if $points[$at + 1] == 65039 or ($at > 0 and $points[$at - 1] == 8205) then "pictograph" else "text" end)
         elif flag then "flag" elif joiner then "joiner" elif modifier then "modifier" elif keycap then "keycap"
         else "text" end] as $classes
    | ([$classes[] | select(. == "pictograph")] | length) as $pictographs
    | ([$classes[] | select(. == "flag")] | length) as $flags
    | ([$classes[] | select(. == "keycap")] | length) as $keys
    | ([$classes[] | select(. == "joiner")] | length) as $joins
    | all($classes[]; . != "text")
      and (if $flags > 0 then $flags == 2 and $pictographs + $keys + $joins == 0
           elif $keys > 0 then $keys == 1 and $pictographs + $joins == 0 and any($points[]; . == 8419)
           else $pictographs == $joins + 1 end)' >/dev/null || die 2 "an icon is one emoji, not '$1'"
}

check_sprint_span() {
  local start="$1" end="$2"
  [ -z "$start" ] || [ -z "$end" ] || [[ ! "$end" < "$start" ]] || die 2 "a sprint ends on or after the day it starts, and $end is before $start"
}

check_epic_span() {
  local start="$1" target="$2"
  [ -z "$start" ] || [ -z "$target" ] || [[ ! "$target" < "$start" ]] || die 2 "an epic's target is on or after its start, and $target is before $start"
}

CONFIDENCES=("On track" "At risk - plan in place" "At risk - no plan")

date_json() {
  local what="$1" value="$2"
  [ -z "$value" ] || jq --null-input --exit-status --arg value "$value" \
    'try ($value | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") and ($value + "T00:00:00Z" | fromdateiso8601 | todate | .[:10]) == $value) catch false' >/dev/null \
    || die 2 "$what is a date like 2026-10-12, not '$value'"
  nullable "$value"
}

held_program='
  def released: .due = (.due_own // null) | del(.due_from, .due_own);
  def held($target):
    (if .due_from != null and .due_from != .epic then released else . end)
    | if .epic == null or .status == "Done" or .status == "Deprioritised" then .
      elif $target == null then (if .due_from == .epic then released else . end)
      elif .due_from == .epic then (if .due_own != null and (.due_own | tostring | .[:10]) <= $target then released else .due = $target end)
      elif .due == null or (.due | tostring | .[:10]) > $target then (if .due != null then .due_own = .due else . end) | .due = $target | .due_from = .epic
      else . end;
  held($target)'

hold_card() {
  local id="$1" before after epic target=null
  before="$(read_record "$id")"
  epic="$(printf '%s' "$before" | jq --raw-output '.epic // ""')"
  if [ -n "$epic" ] && [ -f "$(record_file "$epic")" ]; then
    target="$(read_record "$epic" | jq --compact-output '.target // null')"
  fi
  after="$(printf '%s' "$before" | jq --argjson target "$target" "$held_program")"
  { printf '%s' "$before"; printf '%s' "$after"; } | jq --slurp --exit-status '.[0] == .[1]' >/dev/null && return 0
  printf '%s' "$after" | write_record "$id"
  printf '%s\tdue %s\n' "$id" "$(printf '%s' "$after" | jq --raw-output '.due // "cleared"')"
}

hold_epic_cards() {
  local epic="$1" file card
  while IFS= read -r file; do
    card="${file##*/}"
    card="${card%.md}"
    [ "$(parse_file "$file" | jq --raw-output '.epic // ""')" = "$epic" ] || continue
    hold_card "$card"
  done < <(grep --files-with-matches --fixed-strings "\"$epic\"" "$BOARD_DIR"/cards/*.md 2>/dev/null || true)
}

field_json() {
  local kind="$1" field="$2" value="$3"
  case "$field" in
    icon)
      [ -z "$value" ] || check_icon "$value"
      nullable "$value"
      ;;
    timebox_mins)
      [ "$kind" = card ] || die 2 "only a card has a timebox, and this is a $kind"
      [ -z "$value" ] || printf '%s' "$value" | grep --quiet --extended-regexp '^[1-9][0-9]*$' || die 2 "a timebox is a whole number of minutes, not '$value'"
      if [ -z "$value" ]; then echo null; else printf '%s\n' "$value"; fi
      ;;
    start|end)
      [ "$kind" != epic ] || [ "$field" != start ] || die 2 "an epic's start is stamped the day it first leaves Backlog and is never set by hand"
      [ "$kind" = sprint ] || die 2 "only a sprint has a $field date, and this is a $kind"
      date_json "a $kind's $field" "$value"
      ;;
    target)
      [ "$kind" = epic ] || die 2 "only an epic has a target date, and this is a $kind"
      date_json "an epic's target" "$value"
      ;;
    date)
      [ "$kind" = milestone ] || die 2 "only a milestone has a date, and this is a $kind"
      [ -n "$value" ] || die 2 "a milestone keeps its date - archive it to take it off the plan"
      date_json "a milestone's date" "$value"
      ;;
    confidence)
      [ "$kind" = epic ] || die 2 "only an epic has a confidence, and this is a $kind"
      if [ -n "$value" ] && ! printf '%s\n' "${CONFIDENCES[@]}" | grep --quiet --line-regexp --fixed-strings -- "$value"; then
        die 2 "an epic's confidence is On track, At risk - plan in place or At risk - no plan, not '$value'"
      fi
      nullable "$value"
      ;;
    learning)
      [ "$kind" = epic ] || die 2 "only an epic has a learning, and this is a $kind"
      nullable "$value"
      ;;
    dev_days|speed)
      [ "$kind" = sprint ] || die 2 "only a sprint has $field, and this is a $kind"
      [ -z "$value" ] || printf '%s' "$value" | grep --quiet --extended-regexp '^[0-9]+(\.[0-9]+)?$' || die 2 "a sprint's $field is a number, not '$value'"
      if [ -z "$value" ]; then echo null; else jq --null-input --arg value "$value" '$value | tonumber'; fi
      ;;
    status)
      case "$kind" in
        project) ;;
        sprint|reference|milestone)
          [ -z "$value" ] || die 2 "a $kind has no status - set it to '' to clear one it was given"
          echo null
          return 0
          ;;
        *) die 2 "status changes through: board-card move or board-card walk" ;;
      esac
      case "$value" in "Not started"|"In progress"|"Done") ;; *) die 2 "a project's status is Not started, In progress or Done, not '$value'" ;; esac
      nullable "$value"
      ;;
    priority)
      [ "$kind" = project ] || die 2 "only a project has a priority, and this is a $kind"
      [ -z "$value" ] || printf '%s' "$value" | grep --quiet --extended-regexp '^[0-9]+$' || die 2 "a project's priority is a whole number, not '$value'"
      if [ -z "$value" ]; then echo null; else jq --null-input --arg value "$value" '$value | tonumber'; fi
      ;;
    tracks)
      [ "$kind" = project ] || die 2 "only a project has a share of the tracks - the board's own count is set with: board-card tracks <n> - and this is a $kind"
      [ -z "$value" ] || printf '%s' "$value" | grep --quiet --extended-regexp '^[1-9][0-9]*$' || die 2 "a project's share of the tracks is a whole number above 0, not '$value' - clear it with '' to give it none"
      if [ -z "$value" ]; then echo null; else printf '%s\n' "$value"; fi
      ;;
    track)
      [ "$kind" = epic ] || die 2 "only an epic is pinned to a track, and this is a $kind"
      [ -z "$value" ] || printf '%s' "$value" | grep --quiet --extended-regexp '^[1-9][0-9]*$' || die 2 "a track is a whole number above 0, not '$value' - clear it with '' to let the plan place the epic"
      if [ -z "$value" ]; then echo null; else printf '%s\n' "$value"; fi
      ;;
    repo)
      [ "$kind" = project ] || die 2 "only a project has a repo, and this is a $kind"
      [ -z "$value" ] || printf '%s' "$value" | grep --quiet --extended-regexp '^https?://[^[:space:]]+$' || die 2 "a project's repo is a URL, not '$value'"
      nullable "$value"
      ;;
    points)
      [ "$kind" = reference ] || die 2 "only a reference ticket has points, and this is a $kind"
      [ -z "$value" ] || is_fibonacci "$value" || die 2 "points are a Fibonacci number ($FIBONACCI), not '$value'"
      if [ -z "$value" ]; then echo null; else printf '%s\n' "$value"; fi
      ;;
    why|description|stack)
      [ "$kind" = reference ] || die 2 "only a reference ticket has $field, and this is a $kind"
      nullable "$value"
      ;;
    domain)
      [ "$kind" = reference ] || die 2 "only a reference ticket has a domain, and this is a $kind"
      case "$value" in ""|Tech|Bizdev) ;; *) die 2 "a domain is Tech or Bizdev, not '$value'" ;; esac
      nullable "$value"
      ;;
    card)
      [ "$kind" = reference ] || die 2 "only a reference ticket names the card it was taken from, and this is a $kind"
      if [ -n "$value" ]; then
        value="$(normalise_id "$value")" || exit "$?"
        [ "$(kind_of "$value")" = card ] || die 2 "$value is not a card"
        require_record "$value"
      fi
      nullable "$value"
      ;;
    *) die 2 "no field '$field' on a $kind" ;;
  esac
}

follow_rename() {
  local from="$1" to="$2" file other lock_dir marker
  while IFS= read -r file; do
    other="${file##*/}"
    other="${other%.md}"
    update_record "$other" --arg from "$from" --arg to "$to" '
      (if has("dependent_on") then .dependent_on |= map(if . == $from then $to else . end) else . end)
      | (if has("dependency_for") then .dependency_for |= map(if . == $from then $to else . end) else . end)
      | if .card == $from then .card = $to else . end'
  done < <(grep --files-with-matches --fixed-strings "\"$from\"" "$BOARD_DIR"/cards/*.md "$BOARD_DIR"/references/*.md 2>/dev/null || true)
  lock_dir="${TICKET_CLAIM_LOCK_DIR:-$HOME/.local/state/claude-ticket-claims}"
  [ -d "$lock_dir/$from" ] && [ ! -e "$lock_dir/$to" ] && mv "$lock_dir/$from" "$lock_dir/$to"
  for marker in "$TICKET_STATE_DIR"/*.ticket; do
    [ -f "$marker" ] || continue
    [ "$(cat "$marker")" = "$from" ] && printf '%s\n' "$to" > "$marker"
  done
  return 0
}

move_attachments() {
  local from="$1" to="$2"
  [ -d "$from" ] || return 0
  rmdir "$to" 2>/dev/null || true
  mkdir -p "$(dirname "$to")"
  mv "$from" "$to"
}

rename_card() {
  local from="$1" to="$2" directory
  directory="$BOARD_DIR/cards"
  read_record "$from" | jq --arg to "$to" '.id = $to' | write_record "$to"
  rm -f "$directory/$from.md"
  [ -f "$directory/$from.comments.jsonl" ] && mv "$directory/$from.comments.jsonl" "$directory/$to.comments.jsonl"
  move_attachments "$BOARD_DIR/attachments/$from" "$BOARD_DIR/attachments/$to"
  follow_rename "$from" "$to"
}

unnest_reference_program='
  if (.id | startswith("REF-")) and ((.reference // null) | type) == "object" then
    .reference as $nested
    | del(.reference)
    | reduce ($nested | to_entries[]) as $entry (.;
        if ($entry.key | IN("points", "why", "description", "domain", "stack", "card"))
        then .[$entry.key] = (if $entry.key == "points" then ($entry.value | tonumber? // $entry.value) else $entry.value end)
        else .reference[$entry.key] = $entry.value end)
  else . end'

set_locked() {
  local id="$1" field="$2" value="$3" reference json
  case "$field" in
    complexity)
      if [ -z "$value" ]; then
        update_record "$id" '.complexity = null'
      else
        check_complexity "$id" "$value"
        update_record "$id" --argjson value "$value" '.complexity = $value'
      fi
      ;;
    estimate)
      if [ -z "$value" ]; then
        [ "$(kind_of "$id")" = card ] || die 2 "only a card has an estimate, and $id is not a card"
        update_record "$id" '.estimate = null'
      else
        check_estimate "$id" "$value"
        update_record "$id" --argjson value "$value" '.estimate = $value'
      fi
      ;;
    type)
      local renamed
      [ "$(kind_of "$id")" = card ] || die 2 "only a card has a type, and $id is not a card"
      prefix_of_type "$value" >/dev/null
      renamed="$(prefix_of_type "$value")-${id##*-}"
      [ "$renamed" = "$id" ] || { [ ! -e "$BOARD_DIR/cards/$renamed.md" ] && [ ! -e "$BOARD_DIR/archive/cards/$renamed.md" ]; } || die 2 "$renamed already exists"
      update_record "$id" --arg value "$value" '.type = $value
        | if $value == "Timebox" then .estimate = null | if .timebox_mins == null then .timebox_mins = 60 else . end else . end'
      [ "$renamed" = "$id" ] || rename_card "$id" "$renamed"
      ;;
    name)
      [ -n "$value" ] || die 2 "a record needs a name"
      update_record "$id" --arg value "$value" '.name = $value'
      ;;
    icon|timebox_mins|start|end|dev_days|speed|priority|repo|status|points|why|description|domain|stack|card|target|date|confidence|learning|tracks|track)
      json="$(field_json "$(kind_of "$id")" "$field" "$value")" || exit "$?"
      case "$(kind_of "$id")/$field" in
        sprint/start) check_sprint_span "$value" "$(read_record "$id" | jq --raw-output '.end // empty')" ;;
        sprint/end) check_sprint_span "$(read_record "$id" | jq --raw-output '.start // empty')" "$value" ;;
        epic/target) check_epic_span "$(read_record "$id" | jq --raw-output '.start // empty')" "$value" ;;
      esac
      [ "$(kind_of "$id")/$field" != project/tracks ] || [ -z "$value" ] || check_share "$id" "$value"
      update_record "$id" --arg field "$field" --argjson value "$json" "$unnest_reference_program | .[\$field] = \$value"
      [ "$field" != target ] || hold_epic_cards "$id"
      ;;
    epic|project|sprint)
      reference=""
      case "$(kind_of "$id")/$field/$value" in
        card/epic/) die 2 "every card has an epic - move $id to another with: board-card set $id epic <EPIC-n>" ;;
        epic/project/) die 2 "every epic has a project - move $id to another with: board-card set $id project <PRJ-n>" ;;
      esac
      if [ -n "$value" ]; then
        reference="$(normalise_id "$value")"
        require_record "$reference"
        [ "$(kind_of "$reference")" = "$field" ] || die 2 "$reference is not a $field"
      fi
      update_record "$id" --arg field "$field" --argjson value "$(nullable "$reference")" '.[$field] = $value'
      if [ "$field" = epic ] && [ "$(kind_of "$id")" = card ]; then hold_card "$id"; fi
      ;;
    due)
      [ -z "$value" ] || printf '%s' "$value" | grep --quiet --extended-regexp '^[0-9]{4}-[0-9]{2}-[0-9]{2}' || die 2 "due is a date, not '$value'"
      update_record "$id" --argjson value "$(nullable "$value")" '.due = $value | del(.due_from, .due_own)'
      ;;
    blocked)
      update_record "$id" --argjson value "$(nullable "$value")" --arg at "$(now)" --arg by "$(default_author)" '
        if $value == null then .blocked = null | del(.blocked_at) | del(.blocked_by)
        elif .blocked == $value then .
        else .blocked = $value | .blocked_at = $at | .blocked_by = $by end'
      ;;
    urgent)
      [ "$(kind_of "$id")" = card ] || die 2 "only a card is flagged urgent, and $id is not a card"
      case "$value" in
        true) update_record "$id" '.urgent = true' ;;
        "") update_record "$id" 'del(.urgent)' ;;
        *) die 2 "urgent is true, or '' to take the flag off, not '$value'" ;;
      esac
      ;;
    labels)
      has_board "$(kind_of "$id")" || die 2 "only a card or an epic carries labels, and $id is a $(kind_of "$id")"
      [ "$value" = "${value//$'\n'/}" ] || die 2 "labels are separated by commas, never by a new line"
      update_record "$id" --arg value "$value" '
        [$value | split(",")[] | gsub("^\\s+|\\s+$"; "") | select(. != "")] as $labels
        | reduce $labels[] as $label ([]; if index([$label]) then . else . + [$label] end) as $unique
        | if ($unique | length) == 0 then del(.labels) else .labels = $unique end'
      ;;
    session|prs)
      update_record "$id" --arg field "$field" --argjson value "$(nullable "$value")" '.[$field] = $value'
      ;;
    models.*)
      case "$MODEL_STAGES" in *" ${field#models.} "*) ;; *) die 2 "a model is recorded for $MODEL_STAGES, not '${field#models.}'" ;; esac
      update_record "$id" --arg key "${field#models.}" --argjson value "$(nullable "$value")" '.models = ((.models // {}) + {($key): $value} | with_entries(select(.value != null)))'
      ;;
    reference.*)
      case "${field#reference.}" in
        points|why|description|domain|stack|card) set_locked "$id" "${field#reference.}" "$value" ;;
        *) die 2 "a reference ticket has points, why, description, domain, stack and card, not '${field#reference.}'" ;;
      esac
      ;;
    body)
      update_record "$id" --arg value "$value" '.body = $value'
      ;;
    rank)
      printf '%s' "$value" | grep --quiet --extended-regexp '^-?[0-9]+(\.[0-9]+)?$' || die 2 "rank is a number, not '$value'"
      update_record "$id" --argjson value "$value" '.rank = $value'
      ;;
    plan_rank) die 2 "an epic's place in the plan is its rank, the same one the Epics board orders it by - run: board-card set $id rank <n>" ;;
    back_from.*) die 2 "a bounce counter moves through: board-card bounce" ;;
    *) die 2 "no settable field '$field' - one of: name, icon, type, epic, project, sprint, due, urgent, labels, blocked, prs, complexity, estimate, timebox_mins, start, end, target, date, confidence, learning, track, dev_days, speed, priority, repo, tracks, status of a project, points, why, description, domain, stack, card, session, body, rank, models.<stage>" ;;
  esac
}

command_set() {
  local id field="${2:-}" property renamed
  id="$(normalise_id "${1:-}")"
  [ "$#" -ge 3 ] || die 2 "usage: board-card set <id> <field> <value>"
  require_record "$id"
  with_lock set_locked "$id" "$field" "$3"
  if [ "$field" = type ] && [ ! -f "$(record_file "$id")" ]; then
    renamed="$(prefix_of_type "$3")-${id##*-}"
    printf 'renamed %s to %s\n' "$id" "$renamed"
    id="$renamed"
  fi
  property="$(property_of_field "$field")"
  [ -z "$property" ] || command_show "$id" "$property"
}

section_locked() {
  local id="$1" heading="$2" after="$3" under="$4" content="$5" before="$6" body updated
  body="$(read_record "$id" | jq --raw-output '.body')"
  updated="$(printf '%s\n' "$body" | HEADING="$heading" AFTER="$after" BEFORE="$before" UNDER="$under" CONTENT="$content" awk '
    function title_of(text) { sub(/^#+ /, "", text); return text }
    function level_of(text) { return length(text) - length(substr(text, index(text, " "))) }
    function find(title, from, to, deeper,   k) {
      for (k = from; k <= to; k++) if (level[k] > deeper && title_of(line[k]) == title) return k
      return 0
    }
    function section_end(start, to,   k) {
      for (k = start + 1; k <= to; k++) if (level[k] > 0 && level[k] <= level[start]) return k - 1
      return to
    }
    function hashes(count,   text) { text = ""; while (count-- > 0) text = text "#"; return text }
    {
      line[NR] = $0
      if ($0 ~ /^```/) fenced = !fenced
      level[NR] = (!fenced && $0 ~ /^#+ /) ? level_of($0) : 0
    }
    END {
      total = NR
      heading = ENVIRON["HEADING"]; after = ENVIRON["AFTER"]; before = ENVIRON["BEFORE"]; under = ENVIRON["UNDER"]; content = ENVIRON["CONTENT"]
      gap = (content ~ /^\n/) ? "" : "\n"
      first = 1; last = total; floor = 0; prefix = "##"
      if (under != "") {
        parent = find(under, 1, total, 0)
        if (!parent) {
          if (total > 0 && line[total] != "") line[++total] = ""
          line[++total] = "## " under; level[total] = 2; parent = total
        }
        first = parent + 1; last = section_end(parent, total); floor = level[parent]; prefix = hashes(level[parent] + 1)
      }
      target = find(heading, first, last, floor)
      if (target) {
        stop = section_end(target, last)
        for (k = 1; k <= target; k++) print line[k]
        if (content != "") print gap content
        if (stop < total && line[stop] == "" ) print ""
        for (k = stop + 1; k <= total; k++) print line[k]
        exit
      }
      insert = last
      if (before != "") {
        anchor = find(before, first, last, floor)
        if (anchor) {
          for (k = 1; k < anchor; k++) print line[k]
          print prefix " " heading
          if (content != "") print gap content
          print ""
          for (k = anchor; k <= total; k++) print line[k]
          exit
        }
      }
      if (after != "") {
        anchor = find(after, first, last, floor)
        if (anchor) insert = section_end(anchor, last)
      }
      while (insert >= first && line[insert] == "" && insert > 0) insert--
      if (insert < first - 1) insert = first - 1
      for (k = 1; k <= insert; k++) print line[k]
      if (insert > 0) print ""
      print prefix " " heading
      if (content != "") print gap content
      if (insert < total) print ""
      for (k = insert + 1; k <= total; k++) if (!(k == insert + 1 && line[k] == "")) print line[k]
    }')"
  update_record "$id" --arg value "$updated" '.body = $value'
}

command_section() {
  local id heading="${2:-}" after="" under="" before=""
  id="$(normalise_id "${1:-}")"
  [ -n "$heading" ] || die 2 "usage: board-card section <id> <heading> [--before <heading> | --after <heading>] [--under <heading>] < content"
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --after) after="${2:-}"; shift 2 ;;
      --before) before="${2:-}"; shift 2 ;;
      --under) under="${2:-}"; shift 2 ;;
      *) die 2 "section: unknown option '$1'" ;;
    esac
  done
  heading="${heading#"${heading%%[!#]*}"}"; heading="${heading# }"
  after="${after#"${after%%[!#]*}"}"; after="${after# }"
  under="${under#"${under%%[!#]*}"}"; under="${under# }"
  before="${before#"${before%%[!#]*}"}"; before="${before# }"
  require_record "$id"
  with_lock section_locked "$id" "$heading" "$after" "$under" "$(cat)" "$before"
  printf '%s\twrote section %s\n' "$id" "$heading"
}

command_bounce() {
  local id gate="${2:-}"
  id="$(normalise_id "${1:-}")"
  case "$GATES" in *" $gate "*) ;; *) die 2 "a bounce is back from one of:$GATES- not '$gate'" ;; esac
  require_record "$id"
  with_lock update_record "$id" --arg gate "$gate" '.back_from = ((.back_from // {}) + {($gate): (((.back_from // {})[$gate] // 0) + 1)})'
  command_show "$id" "Back from $gate"
}

hop() {
  local id="$1" column="$2" kind record from stamped=false starting=false
  kind="$(kind_of "$id")"
  record="$(read_record "$id")"
  from="$(printf '%s' "$record" | jq --raw-output '.status')"
  [ "$from" = "$column" ] && return 0
  if is_stamped "$kind" "$column"; then stamped=true; fi
  if [ "$kind" = epic ] && [ "$from" = Backlog ]; then starting=true; fi
  printf '%s' "$record" | jq --arg column "$column" --arg stamp "$(now)" --arg by "$(default_author)" --argjson stamped "$stamped" \
    --argjson starting "$starting" '
    .status = $column
    | .moved = $stamp
    | .moved_by = $by
    | if $stamped and ((.dates // {}) | has($column) | not)
      then .dates = ((.dates // {}) + {($column): $stamp}) else . end
    | if $starting and .start == null then .start = $stamp[:10] else . end' | write_record "$id"
  printf '%s\t%s -> %s\n' "$id" "$from" "$column"
}

hops() {
  local column="$1" id
  shift
  for id in "$@"; do hop "$id" "$column"; done
}

command_move() {
  [ "$#" -ge 2 ] || die 2 "usage: board-card move <id>... <column>"
  local column="${!#}" given id kind="" ids=()
  [ -n "$column" ] || die 2 "usage: board-card move <id>... <column>"
  for given in "${@:1:$#-1}"; do
    id="$(normalise_id "$given")"
    case " ${ids[*]-} " in *" $id "*) continue ;; esac
    [ -z "$kind" ] || [ "$(kind_of "$id")" = "$kind" ] || die 2 "one move takes records of one kind, and $id is not a $kind"
    kind="$(kind_of "$id")"
    ids+=("$id")
  done
  has_board "$kind" || die 2 "a $kind has no columns"
  require_column "$kind" "$column"
  for id in "${ids[@]}"; do require_record "$id"; done
  with_lock hops "$column" "${ids[@]}"
}

walk_locked() {
  local id="$1" target="$2"
  shift 2
  local kind current from_index target_index i column skipped skip
  kind="$(kind_of "$id")"
  current="$(read_record "$id" | jq --raw-output '.status')"
  if is_parked "$kind" "$current" || is_parked "$kind" "$target"; then
    die 2 "a walk does not pass through $(is_parked "$kind" "$current" && echo "$current" || echo "$target") - use: board-card move"
  fi
  from_index="$(column_index "$kind" "$current")" || die 2 "$id sits in '$current', which is not a $kind column"
  target_index="$(column_index "$kind" "$target")"
  if [ "$target_index" -lt "$from_index" ]; then
    die 4 "$id sits in $current, so $target is behind it - a walk only goes forward"
  fi
  if [ "$target_index" -eq "$from_index" ]; then
    printf '%s\talready in %s\n' "$id" "$current"
    return 0
  fi
  for ((i = from_index + 1; i <= target_index; i++)); do
    column="$(column_at "$kind" "$i")"
    skipped=false
    if [ "$i" -lt "$target_index" ]; then
      for skip in "$@"; do
        [ "$skip" = "$column" ] && skipped=true
      done
    fi
    [ "$skipped" = true ] && continue
    hop "$id" "$column"
  done
}

command_walk() {
  local id target="${2:-}" kind skips=()
  id="$(normalise_id "${1:-}")"
  kind="$(kind_of "$id")"
  has_board "$kind" || die 2 "a $kind has no columns"
  [ -n "$target" ] || die 2 "usage: board-card walk <id> <column> [--skip <column>]..."
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --skip)
        require_column "$kind" "${2:-}"
        case "$2" in "In Dev"|"Done"|"Epic Done") die 2 "$2 cannot be skipped" ;; esac
        skips+=("$2")
        shift 2
        ;;
      *) die 2 "walk: unknown option '$1'" ;;
    esac
  done
  require_column "$kind" "$target"
  require_record "$id"
  with_lock walk_locked "$id" "$target" ${skips[@]+"${skips[@]}"}
}

link_locked() {
  local parent="$1" child="$2" action="$3"
  if [ "$action" = link ]; then
    update_record "$parent" --arg child "$child" '.dependent_on = ((.dependent_on // []) + [$child] | unique) | .complexity = 0'
    update_record "$child" --arg parent "$parent" '.dependency_for = ((.dependency_for // []) + [$parent] | unique)'
  else
    update_record "$parent" --arg child "$child" '.dependent_on = ((.dependent_on // []) - [$child])
      | if (.dependent_on | length) == 0 and .complexity == 0 then .complexity = null else . end'
    update_record "$child" --arg parent "$parent" '.dependency_for = ((.dependency_for // []) - [$parent])'
  fi
}

command_link() {
  local action="$1" parent child
  parent="$(normalise_id "${2:-}")"
  child="$(normalise_id "${3:-}")"
  [ "$parent" != "$child" ] || die 2 "a card cannot depend on itself"
  [ "$(kind_of "$parent")" = card ] && [ "$(kind_of "$child")" = card ] || die 2 "only cards depend on cards"
  require_record "$parent"
  require_record "$child"
  with_lock link_locked "$parent" "$child" "$action"
  command_show "$parent" "Dependent on" "Complexity"
}

command_claim() {
  local id me
  id="$(normalise_id "${1:-}")"
  require_record "$id"
  me="$(session_id)"
  [ -n "$me" ] || die 2 "no session id - set CLAUDE_SESSION_ID or CLAUDE_CODE_SESSION_ID"
  "$CLAIM_LOCK" take "$id" >/dev/null || die 1 "$id is held by session $("$CLAIM_LOCK" owner "$id")"
  with_lock update_record "$id" --arg me "$me" --arg stamp "$(now)" '.session = $me | .claimed_at = $stamp'
  printf 'claimed %s\n' "$id"
}

command_release() {
  local id
  id="$(normalise_id "${1:-}")"
  require_record "$id"
  "$CLAIM_LOCK" release "$id" >/dev/null || die 1 "$id is held by session $("$CLAIM_LOCK" owner "$id"), not this one"
  with_lock update_record "$id" '.session = null | .claimed_at = null'
  printf 'released %s\n' "$id"
}

release_session_locked() {
  local session="$1" id kind
  for kind in card epic; do
    for id in $(command_list --kind "$kind" --json | jq --raw-output --arg session "$session" '.[] | select(.session == $session) | .id'); do
      update_record "$id" '.session = null | .claimed_at = null'
      printf 'released %s\n' "$id"
    done
  done
}

command_release_session() {
  local session="${1:-}"
  [ -n "$session" ] || die 2 "usage: board-card release-session <session-id>"
  [ -d "$BOARD_DIR/cards" ] || return 0
  with_lock release_session_locked "$session"
}

default_author() {
  if [ -n "${COCKPIT_AUTHOR:-}" ]; then
    printf '%s\n' "$COCKPIT_AUTHOR"
  elif [ -n "$(session_id)" ]; then
    printf 'claude %s\n' "$(session_id | cut -c1-8)"
  else
    printf '%s\n' "${USER:-someone}"
  fi
}

comment_locked() {
  local id="$1" anchor="$2" reply="$3" author="$4" text="$5" file comment_id thread line
  file="$(comments_file "$id")"
  comment_id="c$(( $( [ -f "$file" ] && wc -l < "$file" || echo 0 ) + 1 ))"
  thread="$comment_id"
  if [ -n "$reply" ]; then
    [ -f "$file" ] && thread="$(jq --raw-output --arg reply "$reply" 'select(.id == $reply) | .thread' "$file")"
    [ -n "$thread" ] && [ "$thread" != "$comment_id" ] || die 3 "no comment $reply on $id"
    anchor=""
  fi
  line="$(jq --null-input --compact-output \
    --arg id "$comment_id" --arg thread "$thread" --arg anchor "$anchor" --arg author "$author" \
    --arg at "$(now)" --arg text "$text" \
    '{id: $id, thread: $thread, anchor: (if $anchor == "" then null else $anchor end),
      author: $author, at: $at, text: $text, resolved: false}')"
  printf '%s\n' "$line" >> "$file"
  touch_record "$id"
  printf '%s\n' "$comment_id"
}

rewrite_comment_locked() {
  local id="$1" comment_id="$2" author="$3" change="$4" text="${5:-}" file tmp
  file="$(comments_file "$id")"
  [ -f "$file" ] && jq --exit-status --arg comment "$comment_id" 'select(.id == $comment and (.deleted | not))' "$file" >/dev/null \
    || die 3 "no comment $comment_id on $id"
  jq --exit-status --arg comment "$comment_id" --arg author "$author" --argjson mine "$(me_json)" '
    select(.id == $comment) | .author as $who
    | select($who == $author or (($mine | index([$author])) != null and ($mine | index([$who])) != null))' "$file" >/dev/null \
    || die 2 "$comment_id on $id was written by $(jq --raw-output --arg comment "$comment_id" 'select(.id == $comment) | .author' "$file"), so only they can change it"
  tmp="$(mktemp "$(dirname "$file")/.$id.comments.XXXXXX")"
  jq --compact-output --arg comment "$comment_id" --arg change "$change" --arg text "$text" --arg at "$(now)" '
    if .id != $comment then .
    elif $change == "edit" then .text = $text | .edited = $at
    else .text = "" | .deleted = true end' "$file" > "$tmp"
  mv "$tmp" "$file"
  touch_record "$id"
}

command_comment() {
  local id anchor="" reply="" edit="" author="" text body
  id="$(normalise_id "${1:-}")"
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --anchor) anchor="${2:-}"; shift 2 ;;
      --reply) reply="${2:-}"; shift 2 ;;
      --edit) edit="${2:-}"; [ -n "$edit" ] || die 2 "--edit needs a comment id"; shift 2 ;;
      --author) author="${2:-}"; shift 2 ;;
      *) die 2 "comment: unknown option '$1'" ;;
    esac
  done
  require_record "$id"
  text="$(cat)"
  [ -n "$text" ] || die 2 "a comment needs text on stdin"
  if [ -n "$edit" ]; then
    [ -z "$anchor" ] && [ -z "$reply" ] || die 2 "an edit keeps the comment where it is - drop --anchor and --reply"
    [ -n "$author" ] || author="$(default_author)"
    with_lock rewrite_comment_locked "$id" "$edit" "$author" edit "$text"
    printf 'edited %s on %s\n' "$edit" "$id"
    return 0
  fi
  if [ -n "$anchor" ]; then
    body="$(read_record "$id" | jq --raw-output '.body')"
    case "$body" in *"$anchor"*) ;; *) die 2 "the anchor text is not in $id's body: '$anchor'" ;; esac
  fi
  [ -n "$author" ] || author="$(default_author)"
  with_lock comment_locked "$id" "$anchor" "$reply" "$author" "$text"
}

command_comments() {
  local id all=false as_json=false file
  id="$(normalise_id "${1:-}")"
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --all) all=true; shift ;;
      --json) as_json=true; shift ;;
      *) die 2 "comments: unknown option '$1'" ;;
    esac
  done
  require_record "$id"
  file="$(comments_file "$id")"
  local threads
  if [ ! -f "$file" ]; then
    threads='[]'
  else
    threads="$(jq --slurp --argjson all "$all" "$threads_program" "$file")"
  fi
  if [ "$as_json" = true ]; then
    printf '%s\n' "$threads"
  else
    printf '%s' "$threads" | jq --raw-output '
      .[] | "\(.thread)\(if .resolved then " (resolved)" else "" end) on \(if .anchor then "\"\(.anchor)\"" else "the page" end)",
            (.comments[] | "  \(.id) \(.author): \(.text | gsub("\n"; "\n    "))")'
  fi
}

resolve_locked() {
  local id="$1" comment_id="$2" resolved="${3:-true}" file tmp
  file="$(comments_file "$id")"
  [ -f "$file" ] && jq --exit-status --arg comment "$comment_id" 'select(.id == $comment and .id == .thread)' "$file" >/dev/null \
    || die 3 "no thread $comment_id on $id"
  if jq --exit-status --arg comment "$comment_id" --argjson resolved "$resolved" \
    'select(.id == $comment and (.resolved // false) == $resolved)' "$file" >/dev/null; then return 0; fi
  tmp="$(mktemp "$(dirname "$file")/.$id.comments.XXXXXX")"
  jq --compact-output --arg comment "$comment_id" --argjson resolved "$resolved" \
    'if .id == $comment then .resolved = $resolved else . end' "$file" > "$tmp"
  mv "$tmp" "$file"
  touch_record "$id"
}

command_resolve() {
  local id comment_id="${2:-}"
  id="$(normalise_id "${1:-}")"
  [ -n "$comment_id" ] || die 2 "usage: board-card resolve <id> <comment-id>"
  require_record "$id"
  with_lock resolve_locked "$id" "$comment_id" true
  printf 'resolved %s on %s\n' "$comment_id" "$id"
}

command_reopen() {
  local id comment_id="${2:-}"
  id="$(normalise_id "${1:-}")"
  [ -n "$comment_id" ] || die 2 "usage: board-card reopen <id> <comment-id>"
  require_record "$id"
  with_lock resolve_locked "$id" "$comment_id" false
  printf 'reopened %s on %s\n' "$comment_id" "$id"
}

command_uncomment() {
  local id comment_id="${2:-}" author=""
  id="$(normalise_id "${1:-}")"
  [ -n "$comment_id" ] || die 2 "usage: board-card uncomment <id> <comment-id> [--author <name>]"
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --author) author="${2:-}"; shift 2 ;;
      *) die 2 "uncomment: unknown option '$1'" ;;
    esac
  done
  require_record "$id"
  [ -n "$author" ] || author="$(default_author)"
  with_lock rewrite_comment_locked "$id" "$comment_id" "$author" delete
  printf 'deleted %s on %s\n' "$comment_id" "$id"
}

attach_locked() {
  local id="$1" source="$2" name="$3"
  if cmp -s "$source" "$BOARD_DIR/attachments/$id/$name"; then return 0; fi
  mkdir -p "$BOARD_DIR/attachments/$id"
  cp "$source" "$BOARD_DIR/attachments/$id/$name"
  touch_record "$id"
}

command_attach() {
  local id source="${2:-}" name
  id="$(normalise_id "${1:-}")"
  [ -f "$source" ] || die 2 "usage: board-card attach <id> <file> - no file at '$source'"
  require_record "$id"
  name="$(basename "$source")"
  with_lock attach_locked "$id" "$source" "$name"
  printf 'attachments/%s/%s\n' "$id" "$name"
}

command_attachments() {
  local id directory
  id="$(normalise_id "${1:-}")"
  directory="$BOARD_DIR/attachments/$id"
  if [ ! -f "$(record_file "$id")" ]; then
    [ -f "$(archive_file "$id")" ] || die 3 "no record $id in $(directory_of_kind "$(kind_of "$id")")"
    directory="$BOARD_DIR/archive/attachments/$id"
  fi
  [ -d "$directory" ] || return 0
  find "$directory" -mindepth 1 -maxdepth 1 -type f | LC_ALL=C sort
}

command_usage() {
  local id usage
  id="$(normalise_id "${1:-}")"
  require_record "$id"
  usage="$("$DONE_USAGE" "$id")"
  with_lock update_record "$id" --argjson usage "$usage" '.cost_usd = $usage.cost_usd | .tokens_k = $usage.tokens_k'
  printf '%s\n' "$usage"
}

archive_locked() {
  local id="$1" direction="$2" directory from to
  directory="$(directory_of_kind "$(kind_of "$id")")"
  directory="${directory##*/}"
  from="$BOARD_DIR"
  to="$BOARD_DIR/archive"
  if [ "$direction" = archive ]; then
    touch_record "$id"
  else
    from="$BOARD_DIR/archive"
    to="$BOARD_DIR"
  fi
  mkdir -p "$to/$directory"
  mv "$from/$directory/$id.md" "$to/$directory/$id.md"
  if [ -f "$from/$directory/$id.comments.jsonl" ]; then mv "$from/$directory/$id.comments.jsonl" "$to/$directory/$id.comments.jsonl"; fi
  move_attachments "$from/attachments/$id" "$to/attachments/$id"
  if [ "$direction" = unarchive ]; then touch_record "$id"; fi
  printf '%sd %s\n' "$direction" "$id"
}

naming_records() {
  local id="$1" file
  { grep --files-with-matches --fixed-strings "\"$id\"" \
      "$BOARD_DIR"/cards/*.md "$BOARD_DIR"/epics/*.md "$BOARD_DIR"/projects/*.md "$BOARD_DIR"/sprints/*.md "$BOARD_DIR"/references/*.md 2>/dev/null || true; } \
    | while IFS= read -r file; do
        parse_file "$file" | jq --raw-output --arg id "$id" '
          . as $record
          | [(("epic", "project", "sprint", "card") as $field | select($record[$field] == $id) | $field),
             (("dependent_on", "dependency_for") as $field
              | select(any($record[$field] | if type == "array" then .[] else empty end; . == $id)) | $field)]
          | select(length > 0 and $record.id != $id)
          | "\($record.id) (\(join(", ")))"'
      done
}

require_unnamed() {
  local id="$1" links named
  links="$(read_record "$id" | jq --raw-output '[(.dependent_on // [])[], (.dependency_for // [])[]] | join(", ")')"
  [ -z "$links" ] || die 2 "$id is linked to $links - run board-card unlink first"
  named="$(naming_records "$id" | paste -sd ',' - | sed 's/,/, /g')"
  [ -z "$named" ] || die 2 "$id is still named by $named - point them elsewhere first"
}

command_archive() {
  local id
  id="$(normalise_id "${1:-}")"
  require_record "$id"
  require_unnamed "$id"
  with_lock archive_locked "$id" archive
}

command_unarchive() {
  local id
  id="$(normalise_id "${1:-}")"
  [ -f "$(archive_file "$id")" ] || die 3 "no archived record $id"
  [ ! -e "$(record_file "$id")" ] || die 2 "$id is on the board already"
  with_lock archive_locked "$id" unarchive
}

require_home() {
  local id="$1" field home
  field=epic
  [ "$(kind_of "$id")" = card ] || field=project
  home="$(read_record "$id" | jq --raw-output --arg field "$field" '.[$field] // ""')"
  [ -n "$home" ] || die 2 "$id has no $field, and a copy needs one - give $id one first with: board-card set $id $field <id>"
  [ -f "$(record_file "$home")" ] || die 2 "$id's $field $home is not on the board, and a copy needs one - give $id another first with: board-card set $id $field <id>"
}

duplicate_locked() {
  local id="$1" name="$2" status="$3" kind source fields epic project
  kind="$(kind_of "$id")"
  source="$(read_record "$id")"
  epic="$(printf '%s' "$source" | jq --raw-output '.epic // ""')"
  [ -z "$epic" ] || [ -f "$(record_file "$epic")" ] || epic=""
  project="$(printf '%s' "$source" | jq --raw-output '.project // ""')"
  [ -z "$project" ] || [ -f "$(record_file "$project")" ] || project=""
  fields="$(printf '%s' "$source" | jq --compact-output --arg project "$project" '
    {project: (if $project == "" then null else $project end), icon, timebox_mins, estimate,
     complexity: (if .complexity == 0 then null else .complexity end)}
    | with_entries(select(.value != null))')"
  create_locked "$kind" "$name" "$(printf '%s' "$source" | jq --raw-output '.type // ""')" "$status" \
    "$epic" "$(printf '%s' "$source" | jq --raw-output '.body // ""')" "$fields"
}

command_duplicate() {
  local id name="" status="" kind
  id="$(normalise_id "${1:-}")"
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name) name="${2:-}"; shift 2 ;;
      --status) status="${2:-}"; shift 2 ;;
      *) die 2 "duplicate: unknown option '$1'" ;;
    esac
  done
  kind="$(kind_of "$id")"
  has_board "$kind" || die 2 "only a card or an epic is duplicated, and $id is a $kind"
  require_record "$id"
  require_home "$id"
  [ -n "$name" ] || name="Copy of $(read_record "$id" | jq --raw-output '.name')"
  [ -n "$status" ] || status="$(column_at "$kind" 0)"
  require_column "$kind" "$status"
  with_lock duplicate_locked "$id" "$name" "$status"
}

card_aliases() {
  if [ "$(kind_of "$1")" = card ]; then
    printf '%s\n' "FEAT-${1##*-}" "BUG-${1##*-}" "TIME-${1##*-}"
  else
    printf '%s\n' "$1"
  fi
}

record_paths() {
  local id="$1" which="${2:-}" directory alias
  directory="$(directory_of_kind "$(kind_of "$id")")"
  directory="${directory##*/}"
  while IFS= read -r alias; do
    if [ "$which" = main ]; then
      printf '%s\n' "$directory/$alias.md" "archive/$directory/$alias.md"
    else
      printf '%s\n' "$directory/$alias.md" "$directory/$alias.comments.jsonl" "attachments/$alias" \
        "archive/$directory/$alias.md" "archive/$directory/$alias.comments.jsonl" "archive/attachments/$alias"
    fi
  done < <(card_aliases "$id")
}

require_history() {
  [ -d "$BOARD_DIR/.git" ] || die 2 "the board at $BOARD_DIR keeps no history - run: board-card init"
}

command_history() {
  local id paths=() path log
  id="$(normalise_id "${1:-}")"
  require_history
  if [ -s "$held_file" ]; then
    key_of_id "$id"
    flush_keys="$REPLY"
    with_lock true
  fi
  while IFS= read -r path; do paths+=("$path"); done < <(record_paths "$id")
  log="$(TZ=UTC board_git log --format='%h%x09%ad%x09%s' --date=format-local:'%Y-%m-%dT%H:%M:%SZ' -- "${paths[@]}" 2>/dev/null || true)"
  [ -n "$log" ] || die 3 "no history for $id"
  printf '%s\n' "$log"
}

live_cards_program='
  [inputs | select(test("^(FEAT|BUG|TIME)-[0-9]+$")) | {key: (split("-")[1]), value: .}] | from_entries
  | if ($id | test("^(FEAT|BUG|TIME)-")) then
      if $archived then del(.[$id | split("-")[1]]) else . + {($id | split("-")[1]): $id} end
    else . end'

following_program='
  def live: if type == "string" and test("^(FEAT|BUG|TIME)-[0-9]+$") then ($live[split("-")[1]] // .) else . end;
  (if (.dependent_on | type) == "array" then .dependent_on |= map(live) else . end)
  | (if (.dependency_for | type) == "array" then .dependency_for |= map(live) else . end)
  | if .card != null then .card |= live else . end'

undo_links_program='
  def ids($record; $field): $record[$field] | if type == "array" then . else [] end;
  ((ids($restored; "dependent_on") - ids($current; "dependent_on"))[] | [., "dependency_for", "add"]),
  ((ids($current; "dependent_on") - ids($restored; "dependent_on"))[] | [., "dependency_for", "remove"]),
  ((ids($restored; "dependency_for") - ids($current; "dependency_for"))[] | [., "dependent_on", "add"]),
  ((ids($current; "dependency_for") - ids($restored; "dependency_for"))[] | [., "dependent_on", "remove"])'

undo_locked() {
  local id="$1" since="${2:-}" until="${3:-}" paths=() changed=() links=() path commit base subject before_file="" before_id archived=false current_file current restored live reference
  local current_refs restored_refs link other field change owner session
  while IFS= read -r path; do paths+=("$path"); done < <(record_paths "$id")
  commit="$(board_git log -1 --format=%H -- "${paths[@]}")"
  [ -n "$commit" ] || die 2 "$id has no committed version to go back to"
  if [ -n "$until" ]; then
    until="$(board_git rev-parse --quiet --verify "$until^{commit}" 2>/dev/null)" || die 2 "the board has no commit '${3}'"
    [ "$until" = "$commit" ] || die 2 "$id changed after that, in $(board_git log -1 --format='%h %s' "$commit") - undoing it now would take that change back too"
  fi
  if [ -n "$since" ]; then
    base="$(board_git rev-parse --quiet --verify "$since^{commit}" 2>/dev/null)" || die 2 "the board has no commit '$since'"
    board_git merge-base --is-ancestor "$base" "$commit" || die 2 "$since is not in $id's history"
    [ -n "$(board_git log -1 --format=%H "$base..$commit" -- "${paths[@]}")" ] \
      || die 2 "nothing to undo on $id: it has not changed since $since"
    subject="$(board_git rev-list --count "$base..$commit" -- "${paths[@]}") changes since $(board_git log -1 --format=%h "$base")"
  else
    base="$commit^"
    subject="$(board_git log -1 --format='%h %s' "$commit")"
  fi
  while IFS= read -r path; do
    if board_git cat-file -e "$base:$path" 2>/dev/null; then before_file="$path"; fi
  done < <(record_paths "$id" main)
  [ -n "$before_file" ] || die 2 "$id has no version before $subject, which made it"
  before_id="${before_file##*/}"
  before_id="${before_id%.md}"
  case "$before_file" in archive/*) archived=true ;; esac
  current_file="$(record_file "$id")"
  [ -f "$current_file" ] || current_file="$(archive_file "$id")"
  current="$(parse_file "$current_file")" || exit "$?"
  restored="$(board_git show "$base:$before_file" | jq --raw-input --null-input "[inputs] | $parse_program" 2>/dev/null)" \
    || die 8 "$before_file as it stood before $subject does not parse"
  live="$(for path in "$BOARD_DIR"/cards/*.md; do path="${path##*/}"; printf '%s\n' "${path%.md}"; done \
    | jq --raw-input --null-input --arg id "$before_id" --argjson archived "$archived" "$live_cards_program")"
  restored="$(printf '%s' "$restored" | jq --argjson live "$live" "$following_program")"
  while IFS= read -r path; do changed+=("$path"); done < <(board_git diff --name-only --no-renames "$base" "$commit" -- "${paths[@]}")
  if [ "$before_file" = "${current_file#"$BOARD_DIR/"}" ] \
    && ! printf '%s\n' "${changed[@]}" | grep --quiet --invert-match --extended-regexp '^(archive/)?[a-z]+/[A-Z]+-[0-9]+\.md$' \
    && { printf '%s' "$current"; printf '%s' "$restored"; } | jq --slurp --exit-status '(.[0] | del(.updated)) == (.[1] | del(.updated))' >/dev/null; then
    die 2 "nothing to undo on $id: before $subject it held what it holds now, once renamed cards are followed"
  fi
  current_refs="$(printf '%s' "$current" | jq --compact-output '{epic, project, sprint, card, dependent_on, dependency_for, session}')"
  restored_refs="$(printf '%s' "$restored" | jq --compact-output '{epic, project, sprint, card, dependent_on, dependency_for, session}')"
  owner="$("$CLAIM_LOCK" owner "$id" 2>/dev/null || true)"
  session=""
  if [ "$archived" = true ]; then
    [ "$current_file" = "$(archive_file "$id")" ] || require_unnamed "$id"
  else
    while IFS= read -r reference; do
      [ -f "$(record_file "$reference")" ] || die 2 "undoing $subject would bring back $reference, which is not on the board"
    done < <(jq --null-input --raw-output --argjson current "$current_refs" --argjson restored "$restored_refs" '
      ("epic", "project", "sprint", "card") as $field
      | select($restored[$field] != null and $restored[$field] != $current[$field]) | $restored[$field]')
    while IFS= read -r link; do links+=("$link"); done < <(jq --null-input --raw-output \
      --argjson current "$current_refs" --argjson restored "$restored_refs" "$undo_links_program | @tsv")
    for link in ${links[@]+"${links[@]}"}; do
      IFS=$'\t' read -r other field change <<<"$link"
      [ "$change" = remove ] || [ -f "$(record_file "$other")" ] \
        || die 2 "undoing $subject would link $before_id to $other, which is not on the board"
    done
    session="$(printf '%s' "$restored_refs" | jq --raw-output '.session // ""')"
    [ -z "$session" ] || [ -z "$owner" ] || [ "$owner" = "$session" ] || die 1 "$id is held by session $owner"
  fi
  for path in "${changed[@]}"; do
    if board_git cat-file -e "$base:$path" 2>/dev/null; then
      mkdir -p "$BOARD_DIR/$(dirname "$path")"
      board_git show "$base:$path" > "$BOARD_DIR/$path"
    else
      rm -f "$BOARD_DIR/$path"
      case "$path" in attachments/*/* | archive/attachments/*/*) rmdir "$BOARD_DIR/$(dirname "$path")" 2>/dev/null || true ;; esac
    fi
  done
  [ "$archived" = true ] || printf '%s' "$restored" | write_record "$before_id" touch
  [ "$before_id" = "$id" ] || follow_rename "$id" "$before_id"
  for link in ${links[@]+"${links[@]}"}; do
    IFS=$'\t' read -r other field change <<<"$link"
    if [ "$change" = add ]; then
      update_record "$other" --arg self "$before_id" --arg field "$field" '
        .[$field] = ((.[$field] // []) + [$self] | unique) | if $field == "dependent_on" then .complexity = 0 else . end'
    elif [ -f "$(record_file "$other")" ]; then
      update_record "$other" --arg self "$before_id" --arg field "$field" '
        .[$field] = ((.[$field] // []) - [$self])
        | if $field == "dependent_on" and (.dependent_on | length) == 0 and .complexity == 0 then .complexity = null else . end'
    fi
  done
  if [ -z "$session" ] && [ -n "$owner" ]; then
    CLAUDE_SESSION_ID="$owner" CLAUDE_CODE_SESSION_ID="$owner" "$CLAIM_LOCK" release "$before_id" >/dev/null
  elif [ -n "$session" ] && [ -z "$owner" ]; then
    CLAUDE_SESSION_ID="$session" CLAUDE_CODE_SESSION_ID="$session" "$CLAIM_LOCK" take "$before_id" >/dev/null
  fi
  printf '%s\tundid %s\n' "$before_id" "$subject"
}

command_undo() {
  local id since="" until=""
  id="$(normalise_id "${1:-}")"
  shift || true
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --since) [ -n "${2:-}" ] || die 2 "--since needs a commit from: board-card history $id"; since="$2"; shift 2 ;;
      --until) [ -n "${2:-}" ] || die 2 "--until needs the last commit the change made"; until="$2"; shift 2 ;;
      *) die 2 "undo takes an id, an optional --since <commit> and an optional --until <commit>, not '$1'" ;;
    esac
  done
  [ -z "$until" ] || [ -n "$since" ] || die 2 "--until goes with --since"
  require_history
  flush_now=true
  if [ ! -f "$(record_file "$id")" ] && [ -f "$(archive_file "$id")" ]; then
    parse_file "$(archive_file "$id")" >/dev/null
  else
    require_record "$id"
  fi
  with_lock undo_locked "$id" "$since" "$until"
}

command_flush() {
  case "${1:-}" in
    "") ;;
    --now) flush_now=true ;;
    *) die 2 "flush takes nothing but --now, not '$1'" ;;
  esac
  [ -d "$BOARD_DIR/.git" ] && [ -s "$held_file" ] || return 0
  with_lock true
}

command_revision() {
  require_board
  find "$BOARD_DIR" \( -name .git -o -name .lock -o -name '.*.??????' \) -prune -o -type f -exec cksum {} + \
    | LC_ALL=C sort | cksum | cut -d' ' -f1
}

me_names() {
  if [ -f "$BOARD_DIR/me" ]; then
    grep --invert-match '^$' "$BOARD_DIR/me" || true
  else
    [ -z "${USER:-}" ] || printf '%s\n' "$USER"
    printf '%s\n' "Justin Kek (Notion)"
  fi
}

me_json() { { me_names; printf '%s' "${1:-}"; } | jq --raw-input --null-input --compact-output 'reduce (inputs | select(. != "")) as $name ([]; if index([$name]) then . else . + [$name] end)'; }

me_locked() {
  if [ "$#" -eq 1 ] && [ -z "$1" ]; then rm -f "$BOARD_DIR/me"; else printf '%s\n' "$@" > "$BOARD_DIR/me"; fi
}

command_me() {
  local name
  require_board
  if [ "$#" -gt 0 ]; then
    for name in "$@"; do
      [ "$name" = "${name//$'\n'/}" ] || die 2 "a name is one line, not '$name'"
      [ -n "$name" ] || [ "$#" -eq 1 ] || die 2 "a name is never empty - pass '' alone to go back to the default"
    done
    with_lock me_locked "$@"
  fi
  me_names
}

views_json() { if [ -f "$BOARD_DIR/views.json" ]; then cat "$BOARD_DIR/views.json"; else printf '[]\n'; fi; }

views_save_locked() {
  views_json | jq --arg name "$1" --arg kind "$2" --argjson view "$3" \
    '[.[] | select(.name != $name or .kind != $kind)] + [{name: $name, kind: $kind, view: $view}]' > "$BOARD_DIR/views.json.new"
  mv "$BOARD_DIR/views.json.new" "$BOARD_DIR/views.json"
}

views_delete_locked() {
  views_json | jq --arg name "$1" --arg kind "$2" '[.[] | select(.name != $name or .kind != $kind)]' > "$BOARD_DIR/views.json.new"
  if [ "$(jq length "$BOARD_DIR/views.json.new")" -eq 0 ]; then
    rm -f "$BOARD_DIR/views.json" "$BOARD_DIR/views.json.new"
  else
    mv "$BOARD_DIR/views.json.new" "$BOARD_DIR/views.json"
  fi
}

command_views() {
  local verb="${1:-}" name="" kind=card view
  require_board
  case "$verb" in
    "" | --json)
      [ "$#" -le 1 ] || die 2 "usage: board-card views [--json]"
      if [ "$verb" = --json ]; then views_json; else views_json | jq --raw-output '.[] | "\(.kind)\t\(.name)"'; fi
      return 0
      ;;
    save | delete) shift ;;
    *) die 2 "usage: board-card views [--json] | views save [--kind card|epic] [--] <name> < <json> | views delete [--kind card|epic] [--] <name>" ;;
  esac
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --kind) [ "$#" -ge 2 ] || die 2 "--kind needs card or epic"; kind="$2"; shift 2 ;;
      --)
        shift
        [ "$#" -le 1 ] || die 2 "a view takes one name after --, not $#"
        [ -z "$name" ] || [ "$#" -eq 0 ] || die 2 "a view takes one name, not '$name' and '$1'"
        [ "$#" -eq 0 ] || name="$1"
        break
        ;;
      *)
        [ -z "$name" ] || die 2 "a view takes one name, not '$name' and '$1'"
        name="$1"
        shift
        ;;
    esac
  done
  [ -n "$name" ] || die 2 "a view needs a name"
  [ "$name" = "${name//$'\n'/}" ] || die 2 "a view's name is one line, not '$name'"
  case "$kind" in card | epic) ;; *) die 2 "a view belongs to the card board or the epics board, not '$kind'" ;; esac
  if [ "$verb" = delete ]; then
    views_json | jq --exit-status --arg name "$name" --arg kind "$kind" 'any(.[]; .name == $name and .kind == $kind)' >/dev/null \
      || die 3 "no $kind view is called '$name'"
    with_lock views_delete_locked "$name" "$kind"
    return 0
  fi
  view="$(jq --compact-output 'if type == "object" then . else error("not an object") end' 2>/dev/null)" \
    || die 2 "a view is one JSON object on stdin"
  [ -n "$view" ] || die 2 "a view is one JSON object on stdin"
  with_lock views_save_locked "$name" "$kind" "$view"
}

inbox_read_locked() {
  printf '%s\n' "$1" > "$BOARD_DIR/inbox-seen"
}

command_inbox() {
  local as_json=false reading=false stamp="" author="" limit=100 scratch kind inbox mine
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) as_json=true; shift ;;
      --read)
        reading=true
        shift
        if [ "$#" -gt 0 ] && [ "${1#--}" = "$1" ]; then stamp="$1"; shift; fi
        ;;
      --author) [ -n "${2:-}" ] || die 2 "--author needs a name"; author="$2"; shift 2 ;;
      --limit) [ -n "${2:-}" ] || die 2 "--limit needs a number"; limit="$2"; shift 2 ;;
      *) die 2 "inbox: unknown option '$1'" ;;
    esac
  done
  require_board
  if [ "$reading" = true ]; then
    [ -n "$stamp" ] || stamp="$(now)"
    printf '%s' "$stamp" | grep --quiet --extended-regexp '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}' \
      || die 2 "not a time: '$stamp' - write it as 2026-10-14T09:30:00Z"
    with_lock inbox_read_locked "$stamp"
    printf 'read the inbox up to %s\n' "$stamp"
    return 0
  fi
  printf '%s' "$limit" | grep --quiet --extended-regexp '^[0-9]+$' || die 2 "--limit needs a number"
  if [ -n "$author" ]; then mine="$(jq --null-input --compact-output --arg author "$author" '[$author]')"; else mine="$(me_json "$(default_author)")"; fi
  scratch="$(mktemp -d)"
  { command_list --kind card --json; command_list --kind epic --json; } | jq --slurp 'add' > "$scratch/records.json"
  printf '[]' > "$scratch/comments.json"
  for kind in card epic; do
    local notes=("$(directory_of_kind "$kind")"/*.comments.jsonl)
    [ -f "${notes[0]}" ] || continue
    jq --null-input '[inputs as $line | $line + {record: (input_filename | sub("^.*/"; "") | sub("\\.comments\\.jsonl$"; ""))}]' \
      "${notes[@]}" | jq --slurp 'add' "$scratch/comments.json" - > "$scratch/merged.json"
    mv "$scratch/merged.json" "$scratch/comments.json"
  done
  inbox="$(jq --null-input --slurpfile records "$scratch/records.json" --slurpfile comments "$scratch/comments.json" \
    --argjson me "$mine" --arg seen "$(cat "$BOARD_DIR/inbox-seen" 2>/dev/null || true)" --arg now "$(now)" \
    --argjson limit "$limit" --argjson waiting "$(printf '%s\n' "${WAITING_COLUMNS[@]}" | jq --raw-input . | jq --slurp --compact-output .)" \
    "$derived_program"'
    def at_seconds: (epoch // 0);
    ($records[0] | map({key: .id, value: .}) | from_entries) as $by
    | ($comments[0] | map(select(.id == .thread) | {key: "\(.record) \(.thread)", value: (.resolved // false)}) | from_entries) as $resolved
    | (if $seen == "" then ($now | at_seconds) - 7 * 86400 else ($seen | at_seconds) end) as $since
    | ([$comments[0][] | select((.deleted | not) and (.author as $who | $me | index([$who]) | not) and $by[.record] != null)
        | {kind: "comment", id: .record, name: $by[.record].name, status: $by[.record].status, at, author, text,
           thread, comment: .id, anchor, resolved: ($resolved["\(.record) \(.thread)"] // false)}]
       + [$records[0][] | select(.status as $status | $waiting | index($status))
          | {kind: "waiting", id, name, status, at: (.dates[.status] // .moved // .created), by: .moved_by}]
       + [$records[0][] | select((.blocked // "") != "")
          | {kind: "blocked", id, name, status, at: (.blocked_at // .moved // .created), text: .blocked, by: .blocked_by}])
    | map(. + {unread: ((.at | at_seconds) > $since and (.by as $who | $me | index([$who]) | not))})
    | sort_by(.at | at_seconds) | reverse
    | {me: $me, seen: (if $seen == "" then null else $seen end), now: $now,
       unread: (map(select(.unread)) | length), items: .[:$limit]}')" || { rm -rf "$scratch"; return 1; }
  rm -rf "$scratch"
  if [ "$as_json" = true ]; then
    printf '%s\n' "$inbox"
  else
    printf '%s' "$inbox" | jq --raw-output '.items[] | [(if .unread then "*" else " " end), .at, .kind, .id,
          (if .kind == "comment" then "\(.author): \(.text | split("\n")[0])"
           elif .kind == "blocked" then .text else "waiting in \(.status)" end)] | @tsv'
  fi
}

shares() {
  local leave="${1:-}" file id value
  for file in "$BOARD_DIR"/projects/*.md; do
    [ -f "$file" ] || continue
    id="${file##*/}"
    id="${id%.md}"
    [ "$id" != "$leave" ] || continue
    value="$(front_matter_values tracks "$file" | cut -f2 | grep --extended-regexp '^[0-9]+$' || true)"
    [ -z "$value" ] || printf '%s\t%s\n' "$id" "$value"
  done
}

shares_total() { shares "${1:-}" | awk -F'\t' '{ total += $2 } END { print total + 0 }'; }

shares_text() { shares | awk -F'\t' '{ printf "%s%s %s", (NR > 1 ? ", " : ""), $1, $2 }'; }

board_tracks() { cat "$BOARD_DIR/tracks" 2>/dev/null || true; }

check_share() {
  local id="$1" value="$2" total board
  board="$(board_tracks)"
  [ -n "$board" ] || return 0
  total=$(($(shares_total "$id") + value))
  [ "$total" -le "$board" ] || die 2 "a share of $value for $id takes the projects' shares to $total, over the board's $board tracks - lower another project's share first, or raise the board's count with: board-card tracks <n>"
}

tracks_locked() {
  local total
  if [ -z "$1" ]; then
    rm -f "$BOARD_DIR/tracks"
    return 0
  fi
  total="$(shares_total)"
  [ "$1" -ge "$total" ] || die 2 "the projects' shares add up to $total ($(shares_text)), so the board needs at least $total tracks - lower a project's share first with: board-card set <PRJ-n> tracks <n>"
  printf '%s\n' "$1" > "$BOARD_DIR/tracks"
}

command_tracks() {
  local tracks
  require_board
  if [ "$#" -gt 0 ]; then
    [ "$#" -eq 1 ] || die 2 "usage: board-card tracks [<n> | '']"
    [ -z "$1" ] || printf '%s' "$1" | grep --quiet --extended-regexp '^[1-9][0-9]*$' || die 2 "the board's tracks are a whole number above 0, not '$1' - clear them with '' to read them as the projects' shares added up"
    with_lock tracks_locked "$1"
  fi
  tracks="$(board_tracks)"
  printf '%s\n' "${tracks:-$(shares_total)}"
}

migrate_ranks() {
  local id rank
  while IFS=$'\t' read -r id rank; do
    update_record "$id" --argjson rank "$rank" 'del(.plan_rank) | .rank = $rank'
    printf '%s\trank %s\n' "$id" "$rank"
  done < <(command_list --kind epic --json | jq --raw-output '
    select(any(.[]; has("plan_rank") or .rank == null))
    | sort_by([(if .plan_rank == null then 1 else 0 end), (.plan_rank // .rank // infinite),
               (.target // "9999-12-31"), (.id | split("-")[1] | tonumber)])
    | to_entries[]
    | select(.value.rank != .key + 1 or (.value | has("plan_rank")))
    | [.value.id, .key + 1] | @tsv')
}

migrate_tracks() {
  local project total
  if [ -f "$BOARD_DIR/no-project-tracks" ]; then
    rm -f "$BOARD_DIR/no-project-tracks"
    printf 'no-project-tracks\tremoved\n'
  fi
  [ ! -f "$BOARD_DIR/tracks" ] || return 0
  while IFS= read -r project; do
    [ -f "$(record_file "$project")" ] || continue
    [ "$(read_record "$project" | jq --raw-output '.tracks // ""')" = "" ] || continue
    update_record "$project" '.tracks = 1'
    printf '%s\ttracks 1\n' "$project"
  done < <(command_list --kind epic --json | jq --raw-output '
    map(select(.status != "Epic Done" and ((.project // "") | startswith("PRJ-"))) | .project) | unique[]')
  total="$(shares_total)"
  [ "$total" -gt 0 ] || return 0
  printf '%s\n' "$total" > "$BOARD_DIR/tracks"
  printf 'tracks\t%s\n' "$total"
}

migrate_starts() {
  local id start
  while IFS=$'\t' read -r id start; do
    update_record "$id" --arg start "$start" '.start = $start'
    printf '%s\tstart %s\n' "$id" "$start"
  done < <(command_list --kind epic --json | jq --raw-output '.[]
    | select(.status != "Backlog" and (.start // "") == "")
    | [.id, (([(.dates // {}) | to_entries[] | select(.key != "Backlog") | .value | select(type == "string" and . != "")] | min)
             // .created // empty | .[:10])]
    | select(length == 2) | @tsv')
}

migrate_homes() {
  command_list --kind card --json | jq --raw-output '.[] | select((.epic // "") == "") | "\(.id)\tneeds an epic"'
  command_list --kind epic --json | jq --raw-output '.[] | select((.project // "") == "") | "\(.id)\tneeds a project"'
}

migrate_locked() {
  local changes
  changes="$(migrate_ranks; migrate_tracks; migrate_starts; migrate_homes)"
  if [ -n "$changes" ]; then printf '%s\n' "$changes"; else printf 'nothing to migrate\n'; fi
}

command_migrate() {
  [ "$#" -eq 0 ] || die 2 "migrate takes no arguments"
  require_board
  with_lock migrate_locked
}

command_path() {
  local id
  if [ -n "${1:-}" ]; then
    id="$(normalise_id "$1")"
    if [ ! -f "$(record_file "$id")" ] && [ -f "$(archive_file "$id")" ]; then
      archive_file "$id"
    else
      record_file "$id"
    fi
  else
    printf '%s\n' "$BOARD_DIR"
  fi
}

command -v jq >/dev/null 2>&1 || die 2 "jq is required"

action="${1:-}"
[ "$#" -gt 0 ] && shift
case "$action" in
  init) command_init ;;
  create) command_create "$@" ;;
  show) command_show "$@" ;;
  list) command_list "$@" ;;
  search) command_search "$@" ;;
  statuses) command_statuses "$@" ;;
  set) command_set "$@" ;;
  section) command_section "$@" ;;
  bounce) command_bounce "$@" ;;
  move) command_move "$@" ;;
  walk) command_walk "$@" ;;
  link) command_link link "$@" ;;
  unlink) command_link unlink "$@" ;;
  claim) command_claim "$@" ;;
  release) command_release "$@" ;;
  release-session) command_release_session "$@" ;;
  comment) command_comment "$@" ;;
  comments) command_comments "$@" ;;
  resolve) command_resolve "$@" ;;
  reopen) command_reopen "$@" ;;
  uncomment) command_uncomment "$@" ;;
  attach) command_attach "$@" ;;
  attachments) command_attachments "$@" ;;
  usage) command_usage "$@" ;;
  archive) command_archive "$@" ;;
  unarchive) command_unarchive "$@" ;;
  duplicate) command_duplicate "$@" ;;
  history) command_history "$@" ;;
  undo) command_undo "$@" ;;
  flush) command_flush "$@" ;;
  revision) command_revision ;;
  inbox) command_inbox "$@" ;;
  path) command_path "$@" ;;
  tracks) command_tracks "$@" ;;
  migrate) command_migrate "$@" ;;
  me) command_me "$@" ;;
  views) command_views "$@" ;;
  *) sed -n '3,/^#   board-card migrate/p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
