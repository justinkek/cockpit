#!/usr/bin/env bash
#
# board-card - the cockpit board, kept as one markdown file per record.
#
#   board-card init
#   board-card create [--kind card|epic|project|sprint|reference|milestone] --name <name> [--type Feature|Bug|Timebox]
#                     [--status <column>] [--epic <EPIC-n>] [--project <PRJ-n>] [--icon <emoji>] [--timebox-mins <n>] [--body -]
#                     [--start <date>] [--end <date>] [--target <date>] [--date <date>] [--dev-days <n>] [--speed <n>] [--priority <n>] [--repo <url>]
#   board-card show <id> [--json | --section <heading> | <property>...]
#   board-card list [--kind card|epic|project|sprint|reference|milestone] [--status <column>] [--epic <EPIC-n>] [--archived] [--json]
#   board-card search <text> [--kind card|epic|project|sprint|reference|milestone]
#   board-card statuses [--kind card|epic]
#   board-card set <id> <field> <value>
#   board-card section <id> <heading> [--before <heading> | --after <heading>] [--under <heading>] < <content>
#   board-card bounce <id> <gate>
#   board-card move <id>... <column>
#   board-card walk <id> <column> [--skip <column>]...
#   board-card link <parent-id> <child-id>
#   board-card unlink <parent-id> <child-id>
#   board-card claim <id>
#   board-card release <id>
#   board-card release-session <session-id>
#   board-card comment <id> [--anchor <text> | --reply <comment-id> | --edit <comment-id>] [--author <name>] < <text>
#   board-card uncomment <id> <comment-id> [--author <name>]
#   board-card comments <id> [--all] [--json]
#   board-card resolve <id> <comment-id>
#   board-card reopen <id> <comment-id>
#   board-card attach <id> <file>
#   board-card attachments <id>
#   board-card usage <id>
#   board-card archive <id>
#   board-card unarchive <id>
#   board-card duplicate <id> [--name <name>] [--status <column>]
#   board-card history <id>
#   board-card undo <id> [--since <commit> [--until <commit>]]
#   board-card flush [--now]
#   board-card revision
#   board-card inbox [--json] [--author <name>] [--limit <n>] | inbox --read [<time>]
#   board-card path [<id>]
#   board-card tracks [<n> | '']
#   board-card me [<name>... | '']
#   board-card views [--json] | views save [--kind card|epic] [--] <name> < <json> | views delete [--kind card|epic] [--] <name>
#   board-card migrate
#
# Exit codes:
#   0  done
#   1  claimed by another session
#   2  usage, or a value the field refuses
#   3  no such record
#   4  a walk that would go backwards
#   5  the board directory could not be locked
#   6  written, but the board's git repository refused the commit
#   7  no such section
#   8  a record whose file does not parse
#
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
source "${CLAUDE_SHARED_DIR:-$HOME/.claude-shared}/ticket-state-lib.sh"

BOARD_DIR="${COCKPIT_BOARD_DIR:-$HOME/.local/state/cockpit/board}"
CLAIM_LOCK="${TICKET_CLAIM_LOCK:-$here/ticket-claim-lock}"
DONE_USAGE="${TICKET_DONE_USAGE:-$here/ticket-done-usage}"
COMMIT_DELAY="${COCKPIT_COMMIT_DELAY:-3}"
flush_now=false
flush_keys=""

CARD_COLUMNS=(
  "Backlog"
  "Ready for BR by AI" "In BR by AI" "Ready for BR" "In BR"
  "Ready for TR by AI" "In TR by AI" "Ready for TR" "In TR"
  "Ready for Sprint" "Sprint Backlog" "Daily Plan"
  "In Dev"
  "In CR by AI" "Ready for CR" "In CR"
  "Ready for FR" "In FR"
  "Ready for Validation" "Done"
)

CARD_PARKED=("Deprioritised")

CARD_STAMPED=(
  "Ready for BR" "In BR" "Ready for TR by AI" "Ready for TR" "In TR" "Ready for Sprint" "In Dev"
  "Ready for CR" "In CR" "Ready for FR" "In FR" "Ready for Validation" "Done"
)

EPIC_COLUMNS=(
  "Backlog"
  "Ready for FD by AI" "In FD by AI" "Ready for FD" "In FD"
  "Ready for TD by AI" "In TD by AI" "Ready for TD" "In TD"
  "Ready for Ticket Breakdown by AI" "In Ticket Breakdown by AI" "Ready for Ticket Breakdown" "In Ticket Breakdown"
  "Tickets In Dev" "Epic Done"
)

WAITING_COLUMNS=(
  "Ready for BR" "Ready for TR" "Ready for CR" "Ready for FR" "Ready for Validation"
  "Ready for FD" "Ready for TD" "Ready for Ticket Breakdown"
)

FIBONACCI=" 0 1 2 3 5 8 13 21 34 "
GATES=" BR TR Dev CR FR Validation "
MODEL_STAGES=" BR TR Dev CR "

die() {
  local status="$1"
  shift
  echo "[board-card] $*" >&2
  exit "$status"
}

now() { printf '%s\n' "${COCKPIT_NOW:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"; }

prefix_of_type() {
  case "$1" in
    Feature) printf '%s\n' FEAT ;;
    Bug) printf '%s\n' BUG ;;
    Timebox) printf '%s\n' TIME ;;
    *) die 2 "type is Feature, Bug or Timebox, not '$1'" ;;
  esac
}

prefix_of_kind() {
  case "$1" in
    card) printf '%s\n' FEAT ;;
    epic) printf '%s\n' EPIC ;;
    project) printf '%s\n' PRJ ;;
    sprint) printf '%s\n' SPR ;;
    reference) printf '%s\n' REF ;;
    milestone) printf '%s\n' MS ;;
    *) die 2 "kind is card, epic, project, sprint, reference or milestone, not '$1'" ;;
  esac
}

kind_of() {
  case "${1%%-*}" in
    FEAT|BUG|TIME) printf '%s\n' card ;;
    EPIC) printf '%s\n' epic ;;
    PRJ) printf '%s\n' project ;;
    SPR) printf '%s\n' sprint ;;
    REF) printf '%s\n' reference ;;
    MS) printf '%s\n' milestone ;;
    *) die 2 "no board holds ids starting '${1%%-*}-'" ;;
  esac
}

directory_of_kind() {
  case "$1" in
    card) printf '%s\n' "$BOARD_DIR/cards" ;;
    epic) printf '%s\n' "$BOARD_DIR/epics" ;;
    project) printf '%s\n' "$BOARD_DIR/projects" ;;
    sprint) printf '%s\n' "$BOARD_DIR/sprints" ;;
    reference) printf '%s\n' "$BOARD_DIR/references" ;;
    milestone) printf '%s\n' "$BOARD_DIR/milestones" ;;
  esac
}

walk_columns() {
  case "$1" in
    card) printf '%s\n' "${CARD_COLUMNS[@]}" ;;
    epic) printf '%s\n' "${EPIC_COLUMNS[@]}" ;;
  esac
}

parked_columns() {
  case "$1" in
    card) printf '%s\n' "${CARD_PARKED[@]}" ;;
  esac
}

column_index() {
  local kind="$1" wanted="$2" index=0 column
  while IFS= read -r column; do
    if [ "$column" = "$wanted" ]; then
      printf '%s\n' "$index"
      return 0
    fi
    index=$((index + 1))
  done < <(walk_columns "$kind")
  return 1
}

column_at() {
  walk_columns "$1" | sed -n "$(($2 + 1))p"
}

is_parked() {
  parked_columns "$1" | grep --quiet --line-regexp --fixed-strings -- "$2"
}

is_stamped() {
  local kind="$1" column="$2" stamped
  [ "$kind" = epic ] && return 0
  for stamped in "${CARD_STAMPED[@]}"; do
    [ "$stamped" = "$column" ] && return 0
  done
  return 1
}

has_board() {
  case "$1" in card|epic) return 0 ;; *) return 1 ;; esac
}

require_column() {
  local kind="$1" column="$2"
  has_board "$kind" || return 0
  column_index "$kind" "$column" >/dev/null || is_parked "$kind" "$column" \
    || die 2 "not a $kind column: '$column' - one of: $( { walk_columns "$kind"; parked_columns "$kind"; } | paste -sd ',' - | sed 's/,/, /g')"
}

normalise_id() {
  local id
  id="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"
  printf '%s' "$id" | grep --quiet --extended-regexp '^[A-Z][A-Z0-9]*-[0-9]+$' || die 2 "not a board id: '$1'"
  kind_of "$id" >/dev/null
  printf '%s\n' "$id"
}

record_file() { printf '%s/%s.md\n' "$(directory_of_kind "$(kind_of "$1")")" "$1"; }

comments_file() { printf '%s/%s.comments.jsonl\n' "$(directory_of_kind "$(kind_of "$1")")" "$1"; }

archive_file() {
  local directory
  directory="$(directory_of_kind "$(kind_of "$1")")"
  printf '%s/archive/%s/%s.md\n' "$BOARD_DIR" "${directory##*/}" "$1"
}

require_record() {
  if [ -f "$(record_file "$1")" ]; then
    read_record "$1" >/dev/null
    return 0
  fi
  [ ! -f "$(archive_file "$1")" ] || die 3 "$1 is archived - run: board-card unarchive $1"
  die 3 "no record $1 in $(directory_of_kind "$(kind_of "$1")")"
}

require_board() {
  [ -d "$BOARD_DIR/cards" ] || die 3 "no board at $BOARD_DIR - run: board-card init"
}

board_git() {
  (
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR
    git -C "$BOARD_DIR" "$@"
  )
}

commit_board() {
  local subject="$1" ids index_lock="$BOARD_DIR/.git/index.lock"
  [ -d "$BOARD_DIR/.git" ] || return 0
  if [ -n "$(find "$index_lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then rm -f "$index_lock"; fi
  board_git add --all >/dev/null || return 1
  board_git diff --cached --quiet && return 0
  ids="$(board_git diff --cached --name-only --no-renames \
    | sed -n -E 's#^(archive/)?[a-z]+/([A-Z][A-Z0-9]*-[0-9]+)[./].*#\2#p' | awk '!seen[$0]++' | paste -sd ' ' -)"
  board_git -c user.name=board-card -c user.email=board-card@localhost -c commit.gpgsign=false \
    commit --quiet --no-verify --message "$subject${ids:+ $ids}" >/dev/null
}

case "$BOARD_DIR" in
  /*) board_root="$BOARD_DIR" ;;
  *) board_root="$PWD/$BOARD_DIR" ;;
esac
held_file="$board_root/.git/board-card-held"
record_path_pattern='^(archive/)?[a-z]+/([A-Z][A-Z0-9]*-[0-9]+)[./]'
held_lines=()
batch_ids=()
batch_paths=()
dirty=()

board_index_git() {
  local index="$1"
  shift
  (
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR
    GIT_INDEX_FILE="$index" git -C "$BOARD_DIR" "$@"
  )
}

dirty_paths() {
  local line
  dirty=()
  while IFS= read -r -d '' line; do dirty+=("${line:3}"); done \
    < <(board_git status --porcelain -z --untracked-files=all --no-renames 2>/dev/null)
}

snapshot_tree() {
  local index="$board_root/.git/board-card-snapshot"
  if [ -f "$board_root/.git/index" ]; then cp "$board_root/.git/index" "$index" || return 1; else rm -f "$index"; fi
  board_index_git "$index" add --all >/dev/null 2>&1 || return 1
  board_index_git "$index" write-tree 2>/dev/null
}

record_id_of() {
  [[ "$1" =~ $record_path_pattern ]] || return 1
  REPLY="${BASH_REMATCH[2]}"
}

key_of_id() {
  case "$1" in
    FEAT-* | BUG-* | TIME-*) REPLY="card-${1##*-}" ;;
    *) REPLY="$1" ;;
  esac
}

key_of_path() {
  if record_id_of "$1"; then key_of_id "$REPLY"; else REPLY="$1"; fi
}

commit_paths() {
  local subject="$1" tree="$2" lock="$board_root/.git/index.lock" head base meta path ids=" " entries=() built commit
  local old_mode new_mode old_sha new_sha status
  shift 2
  [ "$#" -gt 0 ] || return 0
  head="$(board_git rev-parse --quiet --verify HEAD 2>/dev/null)" || head=""
  base="$head"
  [ -n "$base" ] || base="$(board_git hash-object -t tree /dev/null)"
  while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
    read -r old_mode new_mode old_sha new_sha status <<<"${meta#:}"
    if [ "$status" = D ]; then entries+=("0 $old_sha"$'\t'"$path"); else entries+=("$new_mode $new_sha"$'\t'"$path"); fi
    if record_id_of "$path"; then
      case "$ids" in *" $REPLY "*) ;; *) ids+="$REPLY " ;; esac
    fi
  done < <(board_git --literal-pathspecs diff-tree -z -r --raw --no-renames "$base" "$tree" -- "$@")
  [ "${#entries[@]}" -gt 0 ] || return 0
  ids="${ids# }"
  ids="${ids% }"
  if [ -e "$lock" ] && [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then rm -f "$lock"; fi
  set -o noclobber
  if ! { : > "$lock"; } 2>/dev/null; then
    set +o noclobber
    return 1
  fi
  set +o noclobber
  if { [ ! -f "$board_root/.git/index" ] || cp "$board_root/.git/index" "$lock"; } \
    && if [ -n "$head" ]; then board_index_git "$lock" read-tree -m "$head"; else board_index_git "$lock" read-tree --empty; fi \
    && printf '%s\0' "${entries[@]}" | board_index_git "$lock" update-index -z --index-info \
    && built="$(board_index_git "$lock" write-tree)" \
    && commit="$(board_git -c user.name=board-card -c user.email=board-card@localhost -c commit.gpgsign=false \
      commit-tree "$built" ${head:+-p "$head"} -m "$subject${ids:+ $ids}")" \
    && board_git update-ref -m "commit: $subject" HEAD "$commit" "$head" \
    && mv "$lock" "$board_root/.git/index"; then
    return 0
  fi
  rm -f "$lock"
  return 1
}

load_held() {
  local line
  held_lines=()
  [ -s "$held_file" ] || return 0
  while IFS= read -r line; do held_lines+=("$line"); done < "$held_file"
}

save_held() {
  if [ "${#held_lines[@]}" -gt 0 ]; then
    printf '%s\n' "${held_lines[@]}" > "$held_file"
  else
    rm -f "$held_file"
  fi
}

list_batches() {
  local line id seen=$'\n'
  batch_ids=()
  for line in ${held_lines[@]+"${held_lines[@]}"}; do
    id="${line%%$'\t'*}"
    case "$seen" in *$'\n'"$id"$'\n'*) continue ;; esac
    seen+="$id"$'\n'
    batch_ids+=("$id")
  done
}

batch_info() {
  local line rest stamp verb path seen=$'\n'
  batch_paths=()
  batch_actions=""
  batch_keys=" "
  batch_last=0
  for line in ${held_lines[@]+"${held_lines[@]}"}; do
    [ "${line%%$'\t'*}" = "$1" ] || continue
    rest="${line#*$'\t'}"
    stamp="${rest%%$'\t'*}"
    rest="${rest#*$'\t'}"
    verb="${rest%%$'\t'*}"
    path="${rest#*$'\t'}"
    [ "$stamp" -le "$batch_last" ] || batch_last="$stamp"
    case ", $batch_actions, " in *", $verb, "*) ;; *) batch_actions="${batch_actions:+$batch_actions, }$verb" ;; esac
    case "$seen" in *$'\n'"$path"$'\n'*) continue ;; esac
    seen+="$path"$'\n'
    batch_paths+=("$path")
    key_of_path "$path"
    case "$batch_keys" in *" $REPLY "*) ;; *) batch_keys+="$REPLY " ;; esac
  done
}

commit_batch() {
  local line kept=()
  batch_info "$1"
  commit_paths "$batch_actions" "$2" ${batch_paths[@]+"${batch_paths[@]}"} || return 1
  for line in ${held_lines[@]+"${held_lines[@]}"}; do
    [ "${line%%$'\t'*}" = "$1" ] || kept+=("$line")
  done
  held_lines=(${kept[@]+"${kept[@]}"})
  save_held
}

flush_held() {
  local tree="$1" now="$2" id line path held_paths=$'\n' unrecorded=() failed=0 due
  list_batches
  for id in ${batch_ids[@]+"${batch_ids[@]}"}; do
    batch_info "$id"
    due=false
    if [ "$flush_now" = true ] || [ "$COMMIT_DELAY" = 0 ] || [ $((now - batch_last)) -ge "$COMMIT_DELAY" ]; then due=true; fi
    if [ -n "$flush_keys" ]; then
      case "$batch_keys" in *" $flush_keys "*) due=true ;; esac
    fi
    if [ "$due" = true ]; then commit_batch "$id" "$tree" || failed=1; fi
  done
  for line in ${held_lines[@]+"${held_lines[@]}"}; do held_paths+="${line##*$'\t'}"$'\n'; done
  for path in ${dirty[@]+"${dirty[@]}"}; do
    case "$held_paths" in *$'\n'"$path"$'\n'*) continue ;; esac
    unrecorded+=("$path")
  done
  commit_paths unrecorded "$tree" ${unrecorded[@]+"${unrecorded[@]}"} || failed=1
  return "$failed"
}

hold_write() {
  local before="$1" stamp="$2" keys=" " count=0 id key batch="" overlapping=() path
  shift 2
  for path in "$@"; do
    key_of_path "$path"
    case "$keys" in *" $REPLY "*) ;; *) keys+="$REPLY " count=$((count + 1)) ;; esac
  done
  list_batches
  for id in ${batch_ids[@]+"${batch_ids[@]}"}; do
    batch_info "$id"
    for path in "$@"; do
      key_of_path "$path"
      case "$batch_keys" in *" $REPLY "*) overlapping+=("$id"); break ;; esac
    done
  done
  if [ "${#overlapping[@]}" -eq 1 ] && [ "$count" -eq 1 ]; then
    batch_info "${overlapping[0]}"
    [ "$batch_keys" != "$keys" ] || batch="${overlapping[0]}"
  fi
  if [ -z "$batch" ]; then
    for id in ${overlapping[@]+"${overlapping[@]}"}; do commit_batch "$id" "$before" || return 1; done
    batch="$stamp.$$"
  fi
  for path in "$@"; do held_lines+=("$batch"$'\t'"$stamp"$'\t'"$action"$'\t'"$path"); done
  save_held
  ( sleep "$COMMIT_DELAY"; exec bash "$here/$(basename "$0")" flush ) </dev/null >/dev/null 2>&1 &
}

with_lock() {
  local lock="$BOARD_DIR/.lock" tries=0 before="" after="" path changed=()
  until mkdir "$lock" 2>/dev/null; do
    tries=$((tries + 1))
    if [ "$tries" -ge 50 ]; then
      if [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
        rm -rf "$lock"
        continue
      fi
      die 5 "board is locked by another writer: $lock"
    fi
    sleep 0.1
  done
  trap 'rm -rf "$BOARD_DIR/.lock"' EXIT
  if [ -d "$BOARD_DIR/.git" ]; then
    load_held
    dirty_paths
    if [ "${#held_lines[@]}" -gt 0 ] || [ "${#dirty[@]}" -gt 0 ]; then
      before="$(snapshot_tree)" || before=""
      [ -z "$before" ] || flush_held "$before" "$(date +%s)" 2>/dev/null || true
    else
      before=HEAD
    fi
  fi
  local status=0
  set +e
  (
    set -e
    "$@"
  )
  status=$?
  set -e
  if [ "$status" -eq 0 ] && [ -d "$BOARD_DIR/.git" ] && [ "$action" != flush ]; then
    if [ "$COMMIT_DELAY" = 0 ] || [ "$flush_now" = true ]; then
      commit_board "$action" || die 6 "wrote to $BOARD_DIR but could not commit it"
    elif [ -n "$before" ]; then
      if [ "${#held_lines[@]}" -gt 0 ]; then
        after="$(snapshot_tree)" || die 6 "wrote to $BOARD_DIR but could not commit it"
        while IFS= read -r -d '' path; do changed+=("$path"); done \
          < <(board_git diff-tree -z -r --name-only --no-renames "$before" "$after")
      else
        dirty_paths
        changed=(${dirty[@]+"${dirty[@]}"})
      fi
      if [ "${#changed[@]}" -gt 0 ]; then
        hold_write "$before" "$(date +%s)" "${changed[@]}" || die 6 "wrote to $BOARD_DIR but could not commit it"
      fi
    fi
  fi
  rm -rf "$lock"
  trap - EXIT
  return "$status"
}

parse_program='
  [range(0; length) as $i | select(.[$i] == "---") | $i] as $marks
  | . as $lines
  | ($lines[($marks[0] + 1):$marks[1]]) as $front
  | ($lines[($marks[1] + 1):] | join("\n") | sub("^\n+"; "") | sub("\n+$"; "")) as $body
  | reduce $front[] as $line ({object: {}, nested: null};
      if ($line | startswith("  ")) then
        ($line | capture("^  (?<key>\"(?:[^\"\\\\]|\\\\.)*\"): (?<value>.*)$")) as $pair
        | .object[.nested][$pair.key | fromjson] = ($pair.value | fromjson)
      else
        ($line | capture("^(?<key>[a-z_]+):(?: (?<value>.*))?$")) as $pair
        | if ($pair.value // "") == ""
          then .nested = $pair.key | .object[$pair.key] = {}
          else .nested = null | .object[$pair.key] = ($pair.value | fromjson)
          end
      end)
  | .object + {body: $body}'

render_program='
  ["id", "name", "icon", "type", "status", "epic", "project", "sprint", "due", "urgent", "labels", "blocked",
   "dependent_on", "dependency_for", "complexity", "estimate", "session", "claimed_at", "prs", "cost_usd", "tokens_k",
   "created", "moved", "updated", "rank", "models", "back_from", "reference", "dates"] as $order
  | . as $record
  | ($order + ((keys - $order - ["body"]) | sort)) as $keys
  | ["---"]
    + [ $keys[] as $key | select($record | has($key))
        | if ($record[$key] | type) == "object" and ($record[$key] | length) > 0
          then "\($key):", ($record[$key] | to_entries[] | "  \(.key | tojson): \(.value | tojson)")
          else "\($key): \($record[$key] | tojson)"
          end ]
    + ["---"]
    + (if ($record.body // "") == "" then [] else ["", $record.body] end)
  | join("\n")'

derived_program='
  def epoch:
    if type != "string" then null
    else [capture("^(?<day>[0-9]{4}-[0-9]{2}-[0-9]{2})(?:T(?<time>[0-9]{2}:[0-9]{2}(?::[0-9]{2})?)(?:\\.[0-9]+)?(?<zone>Z|[+-][0-9]{2}:?[0-9]{2})?)?$")
          | try (((.day + "T" + ((.time // "00:00") | if length == 5 then . + ":00" else . end) + "Z") | fromdateiso8601)
                 - (if (.zone // "Z") == "Z" then 0
                    else .zone | (if startswith("-") then -60 else 60 end) * ((.[1:3] | tonumber) * 60 + (.[-2:] | tonumber)) end))
            catch empty][0]
    end;
  def working_minutes:
    epoch as $seconds
    | if $seconds == null then null
      else ($seconds / 86400 | floor) as $day
        | ($day % 7) as $into_week
        | (($seconds - $day * 86400) / 60 | floor) as $minute
        | (5 * ($day / 7 | floor) + ([2, $into_week] | min) + ([0, $into_week - 4] | max)) * 510
          + (if (($day + 4) % 7) as $weekday | $weekday == 0 or $weekday == 6 then 0 else [0, ([510, $minute - 570] | min)] | max end)
      end;
  def derived($now):
    if (.id // "" | test("^(FEAT|BUG|TIME)-")) | not then .
    else ($now | working_minutes) as $now_minutes
      | (.dates // {}) as $dates
      | ($dates["In Dev"] | working_minutes) as $in_dev
      | (if $dates["Ready for CR"] == null then $now_minutes else $dates["Ready for CR"] | working_minutes end) as $dev_end
      | (.moved | working_minutes) as $moved
      | (if .status == "In Dev" and $dates["Ready for CR"] != null and $moved != null and $now_minutes != null
            and $moved > ($dates["Ready for CR"] | working_minutes)
         then [0, $now_minutes - $moved] | max else 0 end) as $back_in_dev
      | (if $in_dev == null or $dev_end == null then null else ([0, $dev_end - $in_dev] | max) + $back_in_dev end) as $dev_minutes
      | (if .status | IN("Ready for BR", "In BR", "Ready for TR by AI", "Ready for TR", "In TR", "Ready for Sprint",
                         "In Dev", "Ready for CR", "In CR", "Ready for FR", "In FR", "Ready for Validation")
         then [$dates[.status] | working_minutes, $moved] | map(select(. != null)) | max else null end) as $since
      | . + {
          days_in_column: (if $since == null or $now_minutes == null then 0 else [0, $now_minutes - $since] | max | . / 510 | round end),
          overrunning: (if $dev_minutes == null then false
                        elif .type == "Timebox" and (.timebox_mins // 0) > 0 then $dev_minutes > .timebox_mins
                        elif (.complexity // 0) > 0 then $dev_minutes > .complexity * 102
                        else false end)}
    end;'

parse_file() {
  jq --raw-input --null-input "[inputs] | $parse_program" < "$1" 2>/dev/null \
    || die 8 "${1##*/} does not parse - fix its front matter by hand: $1"
}

read_record() { parse_file "$(record_file "$1")"; }

write_record() {
  local id="$1" touch="${2:-}" json file tmp current
  json="$(cat)"
  file="$(record_file "$id")"
  json="$(printf '%s' "$json" | jq --exit-status 'select(type == "object") | .body = ((.body // "") | sub("^\n+"; "") | sub("\n+$"; ""))' 2>/dev/null)" \
    || die 2 "refused to write $id with nothing in it"
  if [ -f "$file" ]; then
    current="$(read_record "$id")" || exit "$?"
    if [ -z "$touch" ] && { printf '%s' "$current"; printf '%s' "$json"; } \
      | jq --slurp --exit-status '(.[0] | del(.updated)) == (.[1] | del(.updated))' >/dev/null; then
      return 0
    fi
  fi
  mkdir -p "$(dirname "$file")"
  tmp="$(mktemp "$(dirname "$file")/.$id.XXXXXX" 2>/dev/null)" || die 2 "could not write $id: $(dirname "$file") refused a new file"
  if ! printf '%s' "$json" | jq --raw-output --arg stamp "$(now)" ".updated = \$stamp | $render_program" > "$tmp" || [ ! -s "$tmp" ]; then
    rm -f "$tmp"
    die 2 "refused to write $id with nothing in it"
  fi
  mv "$tmp" "$file"
}

touch_record() { read_record "$1" | write_record "$1" touch; }

update_record() {
  local id="$1"
  shift
  read_record "$id" | jq "$@" | write_record "$id"
}

command_init() {
  local changed=false
  mkdir -p "$BOARD_DIR/cards" "$BOARD_DIR/epics" "$BOARD_DIR/projects" "$BOARD_DIR/sprints" "$BOARD_DIR/references" "$BOARD_DIR/milestones"
  if [ ! -d "$BOARD_DIR/.git" ]; then
    board_git init --quiet
    changed=true
  fi
  if [ ! -f "$BOARD_DIR/.gitignore" ] || ! grep --quiet '^\*/\.\*$' "$BOARD_DIR/.gitignore"; then
    printf '.lock\n*/.*\n' > "$BOARD_DIR/.gitignore"
    changed=true
  fi
  if [ "$changed" = true ]; then
    commit_board init || die 6 "made $BOARD_DIR but could not commit it"
  fi
  printf '%s\n' "$BOARD_DIR"
}

next_id() {
  local kind="$1" type="${2:-}" prefix directory highest=0 file number
  prefix="$(prefix_of_kind "$kind")"
  [ "$kind" = card ] && prefix="$(prefix_of_type "$type")"
  directory="$(directory_of_kind "$kind")"
  for file in "$directory"/*.md "$BOARD_DIR/archive/${directory##*/}"/*.md; do
    [ -f "$file" ] || continue
    number="${file##*/}"
    number="${number%.md}"
    number="${number##*-}"
    case "$number" in *[!0-9]*|"") continue ;; esac
    [ "$number" -gt "$highest" ] && highest="$number"
  done
  printf '%s-%s\n' "$prefix" "$((highest + 1))"
}

front_matter_values() {
  local key="$1"
  shift
  [ "$#" -gt 0 ] || return 0
  awk -v key="$key: " 'FNR == 1 { fences = 0 } /^---$/ { fences++; next } fences == 1 && index($0, key) == 1 { print FILENAME "\t" substr($0, length(key) + 1) }' "$@"
}

last_epic_rank() {
  local file files=()
  for file in "$BOARD_DIR"/epics/*.md; do [ ! -f "$file" ] || files+=("$file"); done
  front_matter_values rank ${files[@]+"${files[@]}"} \
    | jq --raw-input --null-input '[inputs | split("\t")[1] | tonumber? // empty] | max // 0 | floor'
}

create_locked() {
  local kind="$1" name="$2" type="$3" status="$4" epic="$5" body="$6" fields="${7:-"{}"}" id stamp stamped=false
  id="$(next_id "$kind" "$type")"
  stamp="$(now)"
  if has_board "$kind" && is_stamped "$kind" "$status"; then stamped=true; fi
  [ "$kind" != epic ] || fields="$(jq --compact-output --argjson rank "$(last_epic_rank)" '{rank: ($rank + 1)} + .' <<<"$fields")"
  jq --null-input \
    --arg kind "$kind" --arg id "$id" --arg name "$name" --arg type "$type" --arg status "$status" \
    --arg epic "$epic" --arg stamp "$stamp" \
    --arg body "$body" --argjson stamped "$stamped" --argjson fields "$fields" '
    def blank: if . == "" then null else . end;
    if $kind == "card" then
      {id: $id, name: $name, type: $type, status: $status, epic: ($epic | blank),
       sprint: null, due: null, blocked: null, dependent_on: [], dependency_for: [],
       complexity: null, estimate: null, session: null, claimed_at: null,
       prs: null, cost_usd: null, tokens_k: null, created: $stamp, models: {}, back_from: {}, timebox_mins: null}
    elif $kind == "epic" and $status != "Backlog" then
      {id: $id, name: $name, status: $status, created: $stamp, start: $stamp[:10]}
    else
      {id: $id, name: $name, status: ($status | blank), created: $stamp}
    end
    + {dates: (if $stamped then {($status): $stamp} else {} end), body: $body}
    + $fields' \
    | write_record "$id"
  [ -z "$epic" ] || [ "$kind" != card ] || hold_card "$id" >/dev/null
  printf '%s\n' "$id"
}

command_create() {
  local kind=card name="" type="Feature" status="" epic="" project="" body="" fields="{}" pairs=() index value timebox="" timebox_given=false start="" end="" target="" date=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --kind) kind="${2:-}"; shift 2 ;;
      --name) name="${2:-}"; shift 2 ;;
      --type) type="${2:-}"; shift 2 ;;
      --status) status="${2:-}"; shift 2 ;;
      --epic) epic="${2:-}"; shift 2 ;;
      --project) project="${2:-}"; shift 2 ;;
      --icon) pairs+=("icon" "${2:-}"); shift 2 ;;
      --timebox-mins) timebox="${2:-}"; timebox_given=true; shift 2 ;;
      --start) start="${2:-}"; pairs+=("start" "$start"); shift 2 ;;
      --end) end="${2:-}"; pairs+=("end" "$end"); shift 2 ;;
      --target) target="${2:-}"; pairs+=("target" "$target"); shift 2 ;;
      --date) date="${2:-}"; pairs+=("date" "$date"); shift 2 ;;
      --dev-days) pairs+=("dev_days" "${2:-}"); shift 2 ;;
      --speed) pairs+=("speed" "${2:-}"); shift 2 ;;
      --priority) pairs+=("priority" "${2:-}"); shift 2 ;;
      --repo) pairs+=("repo" "${2:-}"); shift 2 ;;
      --body) [ "${2:-}" = "-" ] || die 2 "--body reads stdin: pass --body -"; body="$(cat)"; shift 2 ;;
      *) die 2 "create: unknown option '$1'" ;;
    esac
  done
  prefix_of_kind "$kind" >/dev/null
  [ -n "$name" ] || die 2 "create needs --name"
  if [ -z "$status" ]; then
    case "$kind" in
      card) status="Backlog" ;;
      epic) status="Backlog" ;;
      project) status="Not started" ;;
    esac
  fi
  case "$kind" in project|sprint|reference|milestone) field_json "$kind" status "$status" >/dev/null || exit "$?" ;; esac
  [ "$kind" != milestone ] || [ -n "$date" ] || die 2 "a milestone needs --date"
  [ "$kind" = card ] && case "$type" in Feature|Bug|Timebox) ;; *) die 2 "type is Feature, Bug or Timebox, not '$type'" ;; esac
  if [ "$timebox_given" = true ]; then
    pairs+=("timebox_mins" "$timebox")
  elif [ "$kind" = card ] && [ "$type" = Timebox ]; then
    pairs+=("timebox_mins" "60")
  fi
  require_column "$kind" "$status"
  case "$kind" in
    card) [ -n "$epic" ] || die 2 "every card has an epic - pass --epic <EPIC-n>, one of: board-card list --kind epic" ;;
    epic) [ -n "$project" ] || die 2 "every epic has a project - pass --project <PRJ-n>, one of: board-card list --kind project" ;;
  esac
  if [ -n "$epic" ]; then
    epic="$(normalise_id "$epic")"
    require_record "$epic"
    [ "$(kind_of "$epic")" = epic ] || die 2 "$epic is not an epic"
  fi
  if [ -n "$project" ]; then
    case "$kind" in card|epic) ;; *) die 2 "only a card or an epic belongs to a project, and this is a $kind" ;; esac
    project="$(normalise_id "$project")"
    require_record "$project"
    [ "$(kind_of "$project")" = project ] || die 2 "$project is not a project"
    fields="$(jq --compact-output --arg project "$project" '. + {project: $project}' <<<"$fields")"
  fi
  for ((index = 0; index < ${#pairs[@]}; index += 2)); do
    value="$(field_json "$kind" "${pairs[index]}" "${pairs[index + 1]}")" || exit "$?"
    fields="$(jq --compact-output --arg field "${pairs[index]}" --argjson value "$value" '. + {($field): $value}' <<<"$fields")"
  done
  check_sprint_span "$start" "$end"
  check_epic_span "$start" "$target"
  require_board
  with_lock create_locked "$kind" "$name" "$type" "$status" "$epic" "$body" "$fields"
}

PROPERTY_FIELDS='{
  "Name": "name", "Icon": "icon", "Status": "status", "Type": "type", "Epic": "epic", "Project": "project",
  "Sprint": "sprint", "Sprints": "sprint", "Due": "due", "Urgent": "urgent", "Labels": "labels", "Blocked": "blocked", "PRs": "prs",
  "Agent: Session Id": "session", "Complexity": "complexity", "Estimate": "estimate", "Timebox (mins)": "timebox_mins",
  "Dependent on": "dependent_on", "Dependency for": "dependency_for",
  "Session Cost (USD)": "cost_usd", "Session Tokens (k)": "tokens_k",
  "Cost": "cost_usd", "Tokens": "tokens_k",
  "Start Date": "start", "End Date": "end", "Dev Days": "dev_days", "Speed": "speed",
  "Priority": "priority", "Repo": "repo", "Target": "target", "Confidence": "confidence", "Learning": "learning",
  "Rank": "rank", "Date": "date", "Due from": "due_from", "Tracks": "tracks", "Track": "track",
  "Points": "points", "Why this score": "why", "Description": "description", "Domain": "domain", "Stack": "stack", "Ticket": "card"}'

require_properties() {
  local unknown
  unknown="$(jq --null-input --raw-output --argjson fields "$PROPERTY_FIELDS" '
    [$ARGS.positional[] as $property
     | select((($fields | has($property)) or ($property | startswith("Date: ") or startswith("Model: ") or startswith("Back from "))) | not)
     | $property]
    | .[0] // empty' --args "$@")"
  [ -z "$unknown" ] || die 2 "no property '$unknown' - one of: $(printf '%s' "$PROPERTY_FIELDS" | jq --raw-output 'keys_unsorted | join(", ")'), Date: <column>, Model: <stage>, Back from <gate>"
}

property_value() {
  local json="$1" property="$2"
  printf '%s' "$json" | jq --raw-output --arg property "$property" --argjson fields "$PROPERTY_FIELDS" '
    def text: if type == "array" then join(if $property == "Labels" then ", " else " " end) elif type == "object" then (to_entries | map("\(.key)=\(.value)") | join(" ")) else tostring end;
    if ($property | startswith("Date: ")) then .dates[$property[6:]] // empty
    elif ($property | startswith("Model: ")) then .models[$property[7:]] // empty
    elif ($property | startswith("Back from ")) then .back_from[$property[10:]] // empty
    else .[$fields[$property]] // empty end
    | select(. != [] and . != "" and . != {})
    | text'
}

section_lines() {
  local body="$1" heading="$2"
  printf '%s\n' "$body" | awk -v wanted="$heading" '
    /^```/ { fenced = !fenced }
    !fenced && /^#+ / { line = $0; level = length($0) - length(substr($0, index($0, " "))); sub(/^#+ /, "", line)
      if (inside && level <= depth) inside = 0
      if (line == wanted) { inside = 1; depth = level } }
    inside { print NR "\t" $0 }'
}

threads_program='
  group_by(.thread)
  | map(select($all or (.[0].resolved | not)))
  | map({thread: .[0].thread, anchor: .[0].anchor, resolved: (.[0].resolved // false),
         comments: map(select(.deleted | not) | {id, author, at, text} + (if .edited then {edited} else {} end))})
  | map(select(.comments | length > 0))'

open_comments_json() {
  local id="$1" file
  file="$(comments_file "$id")"
  [ -f "$file" ] || { printf '[]\n'; return 0; }
  jq --slurp --argjson all false "$threads_program" "$file"
}

command_show() {
  local id json property value
  id="$(normalise_id "${1:-}")"
  shift
  require_record "$id"
  json="$(read_record "$id")"
  if [ "${1:-}" = "--json" ]; then
    printf '%s\n' "$json" | jq --arg now "$(now)" "$derived_program derived(\$now)"
    return 0
  fi
  if [ "${1:-}" = "--section" ]; then
    local heading="${2:-}" body numbered threads
    while [ "${heading#\#}" != "$heading" ]; do heading="${heading#\#}"; done
    heading="${heading# }"
    body="$(printf '%s' "$json" | jq --raw-output '.body')"
    numbered="$(section_lines "$body" "$heading")"
    [ -n "$numbered" ] || die 7 "$id has no section '$heading'"
    printf '%s\n' "$numbered" | cut -f2-
    threads="$(open_comments_json "$id")"
    printf '%s' "$threads" | jq --raw-output --arg body "$body" \
      --argjson lines "$(printf '%s\n' "$numbered" | cut -f1 | jq --slurp --compact-output .)" '
      .[] | . as $thread
      | select($thread.anchor != null and ($body | contains($thread.anchor)))
      | select($lines | index($body | split($thread.anchor)[0] | [scan("\n")] | length + 1))
      | .comments[] | "[comment] \(.author): \(.text)"'
    printf '%s' "$threads" | jq --raw-output '
      .[] | select(.anchor == null) | .comments[] | "[comment on the page] \(.author): \(.text)"'
    return 0
  fi
  if [ "$#" -eq 0 ]; then
    set -- "Name" "Status" "Type" "Epic" "Agent: Session Id" "PRs" "Complexity" "Dependent on" "Dependency for"
  fi
  require_properties "$@"
  for property in "$@"; do
    value="$(property_value "$json" "$property")"
    [ -n "$value" ] && printf '%s\t%s\n' "$property" "$value"
  done
  return 0
}

command_list() {
  local kind=card status="" epic="" as_json=false archived=false directory
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --kind) kind="${2:-}"; shift 2 ;;
      --status) status="${2:-}"; shift 2 ;;
      --epic) epic="$(normalise_id "${2:-}")"; shift 2 ;;
      --archived) archived=true; shift ;;
      --json) as_json=true; shift ;;
      *) die 2 "list: unknown option '$1'" ;;
    esac
  done
  prefix_of_kind "$kind" >/dev/null
  [ -n "$status" ] && require_column "$kind" "$status"
  require_board
  directory="$(directory_of_kind "$kind")"
  [ "$archived" = false ] || directory="$BOARD_DIR/archive/${directory##*/}"
  local files=("$directory"/*.md) records file
  [ -f "${files[0]}" ] || files=(/dev/null)
  if ! records="$(jq --raw-input --null-input "[inputs | {file: input_filename, line: .}] | group_by(.file) | map(map(.line) | $parse_program)" "${files[@]}" 2>/dev/null)"; then
    for file in "${files[@]}"; do parse_file "$file" >/dev/null; done
    die 8 "a record in $directory does not parse"
  fi
  local notes=("$directory"/*.comments.jsonl) counts='{}'
  if [ -f "${notes[0]}" ]; then
    counts="$(jq --null-input '
      [inputs as $line | $line + {record: (input_filename | sub("^.*/"; "") | sub("\\.comments\\.jsonl$"; ""))}]
      | group_by(.record)
      | map({key: .[0].record,
             value: (group_by(.thread) | map(select((.[0].resolved | not) and any(.[]; .deleted | not))) | length)})
      | from_entries' "${notes[@]}")"
  fi
  printf '%s' "$records" \
    | jq --arg status "$status" --arg epic "$epic" --arg now "$(now)" --argjson counts "$counts" "$derived_program"'
      map(select(($status == "" or .status == $status) and ($epic == "" or .epic == $epic)))
      | sort_by(.id | split("-") | (.[0]), (.[1] | tonumber))
      | map(derived($now) + {comments: ($counts[.id] // 0)})' \
    | if [ "$as_json" = true ]; then
        cat
      else
        jq --raw-output '.[] | [.id, (.status // "-"), (.session // "-"), .name] | @tsv'
      fi
}

command_search() {
  local text="${1:-}" kind=card directory
  [ -n "$text" ] || die 2 "usage: board-card search <text> [--kind card|epic|project|sprint|reference|milestone]"
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --kind) kind="${2:-}"; shift 2 ;;
      *) die 2 "search: unknown option '$1'" ;;
    esac
  done
  prefix_of_kind "$kind" >/dev/null
  require_board
  directory="$(directory_of_kind "$kind")"
  local files=() file
  while IFS= read -r file; do files+=("$file"); done < <(grep --files-with-matches --ignore-case --fixed-strings -- "$text" "$directory"/*.md 2>/dev/null || true)
  [ "${#files[@]}" -gt 0 ] || return 0
  WANTED="$text" awk '
    BEGIN { wanted = tolower(ENVIRON["WANTED"]) }
    FNR == 1 { inside = ($0 == "---"); if (inside) next }
    inside { if ($0 == "---") inside = 0; next }
    index(tolower($0), wanted) {
      id = FILENAME
      sub(/^.*\//, "", id)
      sub(/\.md$/, "", id)
      print id
      nextfile
    }' "${files[@]}" | sort -t- -k1,1 -k2,2n
}

command_statuses() {
  local kind=card
  [ "${1:-}" = "--kind" ] && kind="${2:-}"
  has_board "$kind" || die 2 "only cards and epics have columns"
  walk_columns "$kind"
  parked_columns "$kind"
}

is_fibonacci() {
  printf '%s' "$1" | grep --quiet --extended-regexp '^[0-9]+$' || return 1
  case "$FIBONACCI" in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

check_estimate() {
  local id="$1" value="$2"
  [ "$(kind_of "$id")" = card ] || die 2 "only a card has an estimate - an epic's is the sum of its cards', and $id is not a card"
  is_fibonacci "$value" && [ "$value" != 0 ] || die 2 "an estimate is a Fibonacci number above 0 ($FIBONACCI), not '$value' - clear it with '' instead"
  [ "$(read_record "$id" | jq --raw-output '.type // ""')" != Timebox ] || die 2 "$id is a timebox, and a timebox carries no estimate"
}

check_complexity() {
  local id="$1" value="$2" children
  is_fibonacci "$value" || die 2 "complexity is a Fibonacci number ($FIBONACCI), not '$value'"
  children="$(read_record "$id" | jq '.dependent_on // [] | length')"
  if [ "$value" = "0" ] && [ "$children" -eq 0 ]; then
    die 2 "complexity 0 is for a split parent, and $id has no children"
  fi
  if [ "$value" != "0" ] && [ "$children" -gt 0 ]; then
    die 2 "$id is a split parent, so its complexity is 0"
  fi
}

property_of_field() {
  case "$1" in
    complexity) echo Complexity ;;
    estimate) echo Estimate ;;
    timebox_mins) echo "Timebox (mins)" ;;
    start) echo "Start Date" ;;
    target) echo Target ;;
    confidence) echo Confidence ;;
    learning) echo Learning ;;
    rank) echo Rank ;;
    tracks) echo Tracks ;;
    track) echo Track ;;
    date) echo Date ;;
    end) echo "End Date" ;;
    dev_days) echo "Dev Days" ;;
    speed) echo Speed ;;
    status) echo Status ;;
    priority) echo Priority ;;
    repo) echo Repo ;;
    points) echo Points ;;
    why) echo "Why this score" ;;
    description) echo Description ;;
    domain) echo Domain ;;
    stack) echo Stack ;;
    card) echo Ticket ;;
    reference.*) property_of_field "${1#reference.}" ;;
    name) echo Name ;;
    icon) echo Icon ;;
    type) echo Type ;;
    epic) echo Epic ;;
    project) echo Project ;;
    session) echo "Agent: Session Id" ;;
    blocked) echo Blocked ;;
    urgent) echo Urgent ;;
    labels) echo Labels ;;
    prs) echo PRs ;;
    due) echo Due ;;
    sprint) echo Sprint ;;
    models.*) echo "Model: ${1#models.}" ;;
    back_from.*) echo "Back from ${1#back_from.}" ;;
  esac
}

nullable() { if [ -z "$1" ]; then echo null; else jq --null-input --arg value "$1" '$value'; fi; }

