#!/usr/bin/env bash
#
# board-import-notion - copy a Notion board into the local board. Reads only.
#
#   usage: board-import-notion [--overwrite] [<board-name>]
#          board-import-notion --content [<id>...]
#
# Reads the board's tickets, epics, projects, sprints and reference tickets
# through the board poller's read-only credential, and writes one record per
# page through board-card import: cards named by their ticket number, the rest
# numbered in the order Notion created them.
#
# A record already on the local board keeps everything changed locally; only its
# links to epics, projects and sprints are filled in from Notion. --overwrite
# replaces each record with the page as Notion holds it, keeping its content and
# its place in the column.
#
# --content copies each page's body into the record it was imported as, and
# changes nothing else on it. Given ids, it copies only those.
#
# Exit codes:
#   0  imported
#   2  usage, or a board without a tickets database id
#   3  no credential
#   4  Notion refused a query
#
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
BOARD_ID="${COCKPIT_BOARD_ID:-$here/cockpit-board-id}"
BOARD_CARD="${BOARD_CARD:-$here/board-card}"

content=false
overwrite=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --content) content=true; shift; break ;;
    --overwrite) overwrite=true; shift ;;
    *) break ;;
  esac
done

if [ -n "${NOTION_QUERY_FIXTURE_DIR:-}" ]; then
  query_database() { cat "$NOTION_QUERY_FIXTURE_DIR/$1.json"; }
  block_children() { cat "$NOTION_QUERY_FIXTURE_DIR/blocks-$1.json"; }
else
  token="$(security find-generic-password -a "$USER" -s cockpit-notion-token -w 2>/dev/null || true)"
  if [ -z "$token" ]; then
    echo "[board-import-notion] no credential - store one with: security add-generic-password -a \"\$USER\" -s cockpit-notion-token -w" >&2
    exit 3
  fi

  notion_request() {
    local url="$1" body="${2:-}" headers response status attempts=0 wait
    headers="$(mktemp)"
    while :; do
      response="$( {
        printf '%s\n' \
          "header = \"Authorization: Bearer $token\"" \
          'header = "Notion-Version: 2022-06-28"' \
          'header = "Content-Type: application/json"' \
          "url = \"$url\"" \
          "dump-header = \"$headers\"" \
          'write-out = "\n%{http_code}"' \
          'silent'
        if [ -n "$body" ]; then
          printf '%s\n' 'request = "POST"' "data = \"$(printf '%s' "$body" | sed 's/"/\\"/g')\""
        fi
      } | curl --config - || true)"
      status="${response##*$'\n'}"
      response="${response%$'\n'*}"
      [ "$status" = 429 ] || [ "${status:0:1}" = 5 ] || break
      attempts=$((attempts + 1))
      [ "$attempts" -lt 6 ] || break
      wait="$(grep --ignore-case '^retry-after:' "$headers" | tr -cd '0-9')"
      sleep "${wait:-$attempts}"
    done
    rm -f "$headers"
    if [ "$status" != 200 ]; then
      echo "[board-import-notion] Notion answered $status for $url: $(printf '%s' "$response" | jq --raw-output '.message // empty' 2>/dev/null)" >&2
      return 4
    fi
    printf '%s' "$response"
  }

  query_database() {
    local database="$1" cursor="" response
    while :; do
      response="$(notion_request "https://api.notion.com/v1/databases/$database/query" \
        "$(jq --null-input --compact-output --arg cursor "$cursor" '{page_size: 100} + (if $cursor == "" then {} else {start_cursor: $cursor} end)')")" || exit 4
      printf '%s' "$response" | jq --compact-output '.results[]'
      [ "$(printf '%s' "$response" | jq --raw-output '.has_more')" = true ] || break
      cursor="$(printf '%s' "$response" | jq --raw-output '.next_cursor')"
    done
  }

  block_children() {
    local block="$1" cursor="" url response
    while :; do
      url="https://api.notion.com/v1/blocks/$block/children?page_size=100"
      [ -n "$cursor" ] && url="$url&start_cursor=$cursor"
      response="$(notion_request "$url")" || return 4
      printf '%s' "$response" | jq --compact-output '.results[]'
      [ "$(printf '%s' "$response" | jq --raw-output '.has_more')" = true ] || break
      cursor="$(printf '%s' "$response" | jq --raw-output '.next_cursor')"
    done
  }
fi

block_program='
  def rich: map(if .href then "[\(.plain_text)](\(.href))" else .plain_text end) | join("");
  .type as $type
  | (.[$type] // {}) as $value
  | ($value.rich_text // [] | rich) as $text
  | [ .id, (.has_children | tostring), $type,
      ( if   $type == "heading_1" then "# \($text)"
        elif $type == "heading_2" then "## \($text)"
        elif $type == "heading_3" then "### \($text)"
        elif $type == "to_do" then "- [\(if $value.checked then "x" else " " end)] \($text)"
        elif $type == "bulleted_list_item" or $type == "toggle" then "- \($text)"
        elif $type == "numbered_list_item" then "1. \($text)"
        elif $type == "quote" then "> \($text)"
        elif $type == "callout" then "> \($value.icon.emoji // "")\(if $value.icon.emoji then " " else "" end)\($text)"
        elif $type == "code" then "```\($value.language // "")\n\($text)\n```"
        elif $type == "divider" then "---"
        elif $type == "equation" then "$$\($value.expression)$$"
        elif $type == "child_page" then "[\($value.title)](https://www.notion.so/\(.id | gsub("-"; "")))"
        elif $type == "bookmark" or $type == "embed" or $type == "link_preview" then "<\($value.url)>"
        elif $type == "image" or $type == "file" or $type == "pdf" or $type == "video" then
          "[\($type)](\($value.external.url // $value.file.url // ""))"
        elif $type == "table" or $type == "column_list" or $type == "column" or $type == "synced_block" then ""
        else $text end )
    ] | @json'

page_markdown() {
  local block="$1" indent="${2:-}" line id children type markdown
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    id="$(printf '%s' "$line" | jq --raw-output '.[0]')"
    children="$(printf '%s' "$line" | jq --raw-output '.[1]')"
    type="$(printf '%s' "$line" | jq --raw-output '.[2]')"
    markdown="$(printf '%s' "$line" | jq --raw-output '.[3]')"
    if [ "$type" = table ]; then
      block_children "$id" | jq --raw-output --slurp --arg indent "$indent" '
        map([.table_row.cells[] | map(.plain_text) | join("") | gsub("\\|"; "\\|")])
        | to_entries[]
        | "\($indent)| \(.value | join(" | ")) |",
          (if .key == 0 then "\($indent)|\(.value | map(" --- ") | join("|"))|" else empty end)'
      continue
    fi
    if [ -n "$markdown" ] || [ "$type" = paragraph ]; then
      printf '%s\n' "$markdown" | sed "s/^/$indent/"
    fi
    if [ "$children" = true ] && [ "$type" != child_page ] && [ "$type" != child_database ]; then
      case "$type" in
        heading_*|column_list|column|synced_block) page_markdown "$id" "$indent" ;;
        *) page_markdown "$id" "$indent	" ;;
      esac
    fi
  done < <(block_children "$block" | jq --raw-output "$block_program")
}

if [ "$content" = true ]; then
  if [ "$#" -gt 0 ]; then
    ids=("$@")
  else
    ids=()
    for kind in card epic project; do
      ids+=($("$BOARD_CARD" list --kind "$kind" --json | jq --raw-output '.[] | select(.notion_url) | .id'))
    done
  fi
  total="${#ids[@]}"
  done_count=0
  filled=0
  for id in "${ids[@]}"; do
    done_count=$((done_count + 1))
    url="$("$BOARD_CARD" show "$id" --json | jq --raw-output '.notion_url // empty')"
    page="$(printf '%s' "${url%%\?*}" | grep --only-matching --extended-regexp '[0-9a-f]{32}$' || true)"
    [ -n "$page" ] || continue
    body="$(page_markdown "$page")" || {
      echo "[board-import-notion] $id: page content could not be read, left as it was" >&2
      continue
    }
    if [ -n "$body" ]; then
      "$BOARD_CARD" set "$id" body "$body" >/dev/null
      filled=$((filled + 1))
    fi
    printf '[%s/%s] %s\n' "$done_count" "$total" "$id" >&2
  done
  printf 'copied page content into %s of %s records\n' "$filled" "$total"
  exit 0
fi

board="${1:-Cockpit}"
database_of() { "$BOARD_ID" get "$1" "$board" 2>/dev/null || true; }

tickets_database="$("$BOARD_ID" get tickets-database "$board")" || exit 2
epics_database="$(database_of epics-database)"
projects_database="$(database_of projects-database)"
reference_database="$(database_of reference-tickets-database)"
sprints_view="$(database_of sprints-view)"
sprints_database="$(printf '%s' "$sprints_view" | grep --only-matching --extended-regexp '/[0-9a-f]{32}' | head -1 | tr -d '/' || true)"

workspace="$(mktemp -d)"
trap 'rm -rf "$workspace"' EXIT

fetch() {
  if [ -n "$2" ]; then query_database "$2" > "$workspace/$1.jsonl"; else : > "$workspace/$1.jsonl"; fi
}
fetch tickets "$tickets_database"
fetch epics "$epics_database"
fetch projects "$projects_database"
fetch references "$reference_database"
fetch sprints "$sprints_database"

"$BOARD_CARD" init >/dev/null

jq --null-input --compact-output \
  --slurpfile tickets "$workspace/tickets.jsonl" \
  --slurpfile epics "$workspace/epics.jsonl" \
  --slurpfile projects "$workspace/projects.jsonl" \
  --slurpfile references "$workspace/references.jsonl" \
  --slurpfile sprints "$workspace/sprints.jsonl" '
  def bare: gsub("-"; "");
  def text($property): ($property.rich_text // $property.title // []) | map(.plain_text) | join("") | if . == "" then null else . end;
  def title: .properties | to_entries | map(select(.value.type == "title"))[0].value | text(.);
  def numbered($prefix): sort_by(.created_time) | to_entries | map({key: (.value.id | bare), value: "\($prefix)-\(.key + 1)"}) | from_entries;
  def ticket_number: ({"Bug": "BUG", "Timebox": "TIME"}[.properties.Type.select.name // ""] // "FEAT") as $prefix
    | "\($prefix)-\(.properties["Ticket No."].unique_id.number)";
  def dates: .properties | to_entries
    | map(select((.key | startswith("Date: ")) and .value.type == "date" and .value.date != null) | {key: .key[6:], value: .value.date.start})
    | from_entries;
  def people: (. // []) | map(.name // .id) | join(", ") | if . == "" then null else . end;
  def first_of($map): (. // []) | map($map[.id | bare]) | map(select(. != null)) | first // null;

  ($tickets | map({key: (.id | bare), value: ticket_number}) | from_entries) as $card_ids
  | ($epics | numbered("EPIC")) as $epic_ids
  | ($projects | numbered("PRJ")) as $project_ids
  | ($sprints | numbered("SPR")) as $sprint_ids
  | ($references | numbered("REF")) as $reference_ids

  | ($projects[] | .properties as $p | {
      id: $project_ids[.id | bare], name: (title // "(untitled)"),
      status: ($p.Status.status.name // $p.Status.select.name // null),
      priority: $p.Priority.number, repo: $p.Repo.url,
      created: .created_time, notion_url: .url, dates: {}, body: ""})

  , ($sprints[] | .properties as $p | {
      id: $sprint_ids[.id | bare], name: (title // "(untitled)"), status: null,
      start: $p["Start Date"].date.start, end: $p["End Date"].date.start,
      dev_days: $p["Dev Days"].number, speed: $p.Speed.number,
      created: .created_time, notion_url: .url, dates: {}, body: ""})

  , ($epics[] | .properties as $p | {
      id: $epic_ids[.id | bare], name: (title // "(untitled)"),
      status: ($p.Status.status.name // "Ready for FD by AI"),
      project: ($p["Project "].relation // $p.Project.relation | first_of($project_ids)),
      session: null, claimed_at: null,
      created: .created_time, notion_url: .url, dates: dates, body: ""})

  , ($references[] | .properties as $p | {
      id: $reference_ids[.id | bare], name: (title // "(untitled)"), status: null,
      points: $p.Points.number, why: text($p["Why this score"]), description: text($p.Description),
      domain: $p.Domain.select.name, stack: $p.Stack.select.name,
      card: ($p.Ticket.relation | first_of($card_ids)),
      created: .created_time, notion_url: .url, dates: {}, body: ""})

  , ($tickets[] | .properties as $p | {
      id: ticket_number,
      name: (text($p.Name) // "(untitled)"),
      type: ($p.Type.select.name // "Feature"),
      status: ($p.Status.status.name // "Backlog"),
      epic: ($p.Epic.relation | first_of($epic_ids)),
      sprint: ($p.Sprints.relation | first_of($sprint_ids)),
      due: $p.Due.date.start,
      blocked: $p.Blocked.select.name,
      dependent_on: (($p["Dependent on"].relation // []) | map($card_ids[.id | bare] // .id)),
      dependency_for: (($p["Dependency for"].relation // []) | map($card_ids[.id | bare] // .id)),
      complexity: $p.Complexity.number,
      session: (text($p["Agent: Session Id"]) | if . == null then null else split(" ")[0] end),
      claimed_at: (text($p["Agent: Session Id"]) | if . == null or (split(" ") | length) < 2 then null else split(" ")[-1] end),
      prs: text($p.PRs),
      cost_usd: $p["Session Cost (USD)"].number,
      tokens_k: $p["Session Tokens (k)"].number,
      created: .created_time,
      timebox_mins: $p["Timebox (mins)"].number,
      models: ($p | to_entries | map(select(.key | startswith("Model: ")) | {key: .key[7:], value: text(.value)} | select(.value != null)) | from_entries),
      back_from: ($p | to_entries | map(select((.key | startswith("Back from ")) and .value.number != null and .value.number > 0) | {key: .key[10:], value: .value.number}) | from_entries),
      notion_url: .url,
      dates: dates,
      body: ""})' > "$workspace/records.jsonl"

count=0
while IFS= read -r record; do
  id="$(printf '%s' "$record" | jq --raw-output '.id')"
  if [ "$overwrite" = true ]; then
    "$BOARD_CARD" import <<<"$record" >/dev/null
  else
    case "$id" in
      EPIC-*) "$BOARD_CARD" import --fields project <<<"$record" >/dev/null ;;
      REF-*|PRJ-*|SPR-*) "$BOARD_CARD" import --fields notion_url <<<"$record" >/dev/null ;;
      *) "$BOARD_CARD" import --fields epic,sprint,due <<<"$record" >/dev/null ;;
    esac
  fi
  count=$((count + 1))
done < "$workspace/records.jsonl"

printf 'imported %s records from %s into %s\n' "$count" "$board" "$("$BOARD_CARD" path)"
