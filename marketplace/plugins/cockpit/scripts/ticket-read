#!/usr/bin/env bash
set -euo pipefail

exit_usage=2

usage() {
  echo "usage: ticket-read <ticket-id> [--section <heading>] [property...]" >&2
  exit "$exit_usage"
}

[ "$#" -ge 1 ] || usage

card="$1"
shift

if ! printf '%s' "$card" | grep --quiet --extended-regexp '^[A-Za-z][A-Za-z0-9]*-[0-9]+$'; then
  echo "[ticket-read] '$card' is not a ticket id like COC-123" >&2
  exit "$exit_usage"
fi

board_card="$(dirname "$0")/board-card"

if [ "${1:-}" = "--section" ]; then
  section="${2:-}"
  while [ "${section#\#}" != "$section" ]; do
    section="${section#\#}"
  done
  section="${section# }"
  [ -n "$section" ] || usage
  exec "$board_card" show "$card" --section "$section"
fi

exec "$board_card" show "$card" "$@"
