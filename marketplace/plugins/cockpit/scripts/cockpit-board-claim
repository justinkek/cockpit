#!/usr/bin/env bash
#
# cockpit-board-claim — record that a board serves this checkout.
#
#   usage: cockpit-board-claim <board-name> [checkout]
#
set -euo pipefail

source "${CLAUDE_SHARED_DIR:-$HOME/.claude-shared}/ticket-state-lib.sh"

board="${1:-}"
checkout="${2:-$(cockpit_main_checkout)}"

if [ -z "$board" ]; then
  echo "usage: cockpit-board-claim <board-name> [checkout]" >&2
  exit 2
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "[board-claim] jq is required to read and write the board list" >&2
  exit 1
fi

# An unknown name must be refused rather than written: a typo would otherwise
# create a claim on nothing, and the next session would be asked all over again
# with no clue why the last answer did not stick.
if [ ! -f "$COCKPIT_BOARDS_FILE" ]; then
  echo "[board-claim] no boards configured — record one first: cockpit-board-id set tickets-database <value> <board>" >&2
  exit 1
fi

if ! jq -e --arg name "$board" '.boards | map(select(.name == $name)) | length > 0' \
     "$COCKPIT_BOARDS_FILE" >/dev/null; then
  echo "[board-claim] no board named '$board' — known boards:" >&2
  jq -r '.boards[].name | "  " + .' "$COCKPIT_BOARDS_FILE" >&2
  exit 1
fi

# Through a temp file in the same directory, then one rename: an interrupted run
# leaves the original config intact rather than a truncated one that would take
# every board down at once.
tmp="$(mktemp "$(dirname "$COCKPIT_BOARDS_FILE")/.cockpit-boards.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

jq --tab --arg name "$board" --arg checkout "$checkout" '
  .boards |= map(
    if .name == $name
    then .checkouts = (((.checkouts // .repos // []) + [$checkout]) | unique) | del(.repos)
    else . end)' "$COCKPIT_BOARDS_FILE" > "$tmp"

mv "$tmp" "$COCKPIT_BOARDS_FILE"
trap - EXIT

printf '%s now serves %s\n' "$board" "$checkout"
