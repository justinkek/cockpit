#!/usr/bin/env bash
#
# ticket-waiting-cards — print the cards sitting in a by-AI refinement column,
# or the cards one session is holding.
#
#   usage: ticket-waiting-cards [--claimed-by <session-id>]
#
# One tab-separated line per card:
#
#   <card-id>	<status>	<claim or ->	<name>	<live|stale|->
#
# in pick order: by rank, and a card with no rank by its ticket number, newest
# first.
#
# Two callers, two questions. Bare, it answers the copilot skill's: which cards
# are waiting in a by-AI column. With --claimed-by it answers which cards one
# session is holding, in any column — a claim runs from
# pickup to Done, so a session ending mid-dev holds a card no by-AI listing
# would show.
#
set -euo pipefail

source "${CLAUDE_SHARED_DIR:-$HOME/.claude-shared}/ticket-state-lib.sh"

claimed_by=""
if [ "${1:-}" = "--claimed-by" ]; then
  claimed_by="${2:-}"
  if [ -z "$claimed_by" ]; then
    echo "[waiting-cards] --claimed-by needs a session id" >&2
    exit 2
  fi
fi

# live, stale or `-` for one claim field. The column a card sits in cannot answer
# this: a claim is held from pickup to Done, so a claimed card can be sitting in
# any column with a session still working it.
#
# Fails towards `live`. A claim whose age cannot be measured is never taken off a
# session that might still be there — expiring one wrongly is what put two
# sessions on the same card.
claim_verdict() {
  local claim="$1"
  if [ "$claim" = "-" ]; then
    printf '%s' '-'
  elif ticket_claim_is_stale "${claim%% *}" "$(ticket_claim_epoch "${claim##* }")"; then
    printf '%s' 'stale'
  else
    printf '%s' 'live'
  fi
}

if ! command -v jq >/dev/null 2>&1; then
  echo "[waiting-cards] jq is required to read the board" >&2
  exit 1
fi

cards="$("$(dirname "$0")/board-card" list --json)"

# The claim prints as `-` when empty, so an empty field can never be mistaken
# for a missing column by whatever reads this.
#
# The verdict is appended in shell rather than computed in the jq program: it
# reads a file's modification time, which jq cannot. Appending it keeps the
# four fields before it in the positions a caller parses.
printf '%s' "$cards" | jq --raw-output --arg session "$claimed_by" '
  map(select(
      if $session != "" then .session == $session
      else .status | IN("Ready for BR by AI", "In BR by AI", "Ready for TR by AI", "In TR by AI", "In Dev", "In CR by AI")
      end))
  | sort_by(.rank // -(.id | split("-") | .[1] | tonumber))
  | .[]
  | [ .id,
      (.status // "?"),
      (if (.session // "") == "" then "-" else "\(.session) \(.claimed_at // "")" end),
      .name
    ]
  | @tsv' \
| while IFS=$'\t' read -r f_card f_status f_claim f_name; do
    printf '%s\t%s\t%s\t%s\t%s\n' \
      "$f_card" "$f_status" "$f_claim" "$f_name" "$(claim_verdict "$f_claim")"
  done
