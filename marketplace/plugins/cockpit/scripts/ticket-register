#!/usr/bin/env bash
#
# ticket-register — register the SSOT board ticket a Claude session works on.
#
#   usage: ticket-register <cockpit-ticket-url>
#
set -euo pipefail

source "${CLAUDE_SHARED_DIR:-$HOME/.claude-shared}/ticket-state-lib.sh"

url="${1:-}"
if [ -z "$url" ]; then
  echo "usage: ticket-register <cockpit-ticket-url>" >&2
  exit 1
fi
case "$url" in
  https://*) ;;
  *)
    if ! printf '%s' "$url" | grep --quiet --extended-regexp '^[A-Z][A-Z0-9]*-[0-9]+$'; then
      echo "ticket-register: expected an https ticket URL or a local stub id, got: $url" >&2
      exit 1
    fi
    ;;
esac

session="$(session_id)"
if [ -n "$session" ]; then
  mkdir -p "$TICKET_STATE_DIR"
  printf '%s\n' "$url" > "$TICKET_STATE_DIR/$session.ticket"
fi

ticket_state_confirm .ticket "$url" "Registered SSOT ticket for this session"
