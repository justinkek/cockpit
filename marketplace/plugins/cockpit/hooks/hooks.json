{
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/tab-status.sh working"
					},
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/remind-back-from-column.sh"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/tab-status.sh done"
					},
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/record-running-step.sh clear"
					},
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/advance-after-dev.sh"
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pull-main.sh"
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-end-release-claims.sh"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Edit|Write|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/require-dev-status.sh"
					}
				]
			},
			{
				"matcher": "Read|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/redirect-default-profile-reads.sh"
					}
				]
			},
			{
				"matcher": "Edit|Write|NotebookEdit|Bash|Agent",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/require-rename.sh"
					},
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/require-ticket.sh"
					}
				]
			},
			{
				"matcher": "mcp__.*[Nn]otion.*",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/deny-notion-writes.sh"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/redirect-state-to-read-write.sh"
					},
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/spawn-plugin-guard.sh guard-tech-steps.sh"
					},
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/guard-ticket-comment-length.sh"
					}
				]
			},
			{
				"matcher": "Skill",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/record-running-step.sh record"
					},
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pull-main-before-refinement.sh"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/remind-ticket-status.sh"
					},
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/auto-populate-pr.sh"
					},
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/require-blocked-comment.sh"
					}
				]
			}
		],
		"Notification": [
			{
				"matcher": "permission_prompt",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/tab-status.sh needs"
					}
				]
			}
		]
	}
}
