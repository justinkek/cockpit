#!/usr/bin/env bash
set -euo pipefail

for required in gh git; do
  command -v "$required" >/dev/null 2>&1 || exit 0
done

git rev-parse --git-dir >/dev/null 2>&1 || exit 0

branch_is_behind() {
  local status=0
  git merge-base --is-ancestor "origin/$1" HEAD >/dev/null 2>&1 || status=$?
  [ "$status" -eq 1 ]
}

catch_up_with_base() {
  local interrupted_operation pull_request base review_count

  for interrupted_operation in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD; do
    if [ -e "$(git rev-parse --git-path "$interrupted_operation")" ]; then
      return 0
    fi
  done

  pull_request="$(gh pr view --json state,baseRefName,reviews --jq 'select(.state == "OPEN") | "\(.baseRefName) \(.reviews | length)"' 2>/dev/null || true)"
  [ -n "$pull_request" ] || return 0

  base="${pull_request%% *}"
  review_count="${pull_request##* }"

  git fetch origin "$base" --quiet >/dev/null 2>&1 || return 0

  branch_is_behind "$base" || return 0

  if [ -n "$(git status --porcelain)" ]; then
    printf '[pr-catch-up] behind origin/%s, left alone - the working tree has uncommitted changes.\n' "$base"
    return 3
  fi

  if [ "$review_count" -eq 0 ]; then
    if ! git rebase "origin/$base" >/dev/null 2>&1; then
      git rebase --abort >/dev/null 2>&1 || true
      printf '[pr-catch-up] behind origin/%s, the rebase stopped on a conflict and was undone.\n' "$base"
      return 4
    fi

    if ! git push --quiet --force-with-lease --force-if-includes >/dev/null 2>&1; then
      printf '[pr-catch-up] rebased onto origin/%s, and the push the pull request needs was refused.\n' "$base"
      return 5
    fi

    printf '[pr-catch-up] rebased onto origin/%s and pushed - the pull request matches the branch.\n' "$base"
    return 0
  fi

  if ! git merge --no-edit "origin/$base" >/dev/null 2>&1; then
    git merge --abort >/dev/null 2>&1 || true
    printf '[pr-catch-up] behind origin/%s, the merge stopped on a conflict and was undone.\n' "$base"
    return 4
  fi

  if ! git push --quiet >/dev/null 2>&1; then
    printf '[pr-catch-up] merged origin/%s in, and the push the pull request needs was refused.\n' "$base"
    return 5
  fi

  printf '[pr-catch-up] merged origin/%s in and pushed - the pull request keeps its review comments.\n' "$base"
}

interval="${PR_CATCH_UP_INTERVAL:-}"

if [ -z "$interval" ]; then
  status=0
  catch_up_with_base || status=$?
  exit "$status"
fi

previous_line=""

while true; do
  line="$(catch_up_with_base || true)"

  if [ -n "$line" ] && [ "$line" != "$previous_line" ]; then
    printf '%s\n' "$line"
  fi

  previous_line="$line"
  sleep "$interval"
done
