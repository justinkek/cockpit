#!/usr/bin/env bash
set -euo pipefail

upstream="https://github.com/justinkek/cockpit.git"

checkout_here() {
  local toplevel
  toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
  [ -f "$toplevel/install.sh" ] && [ -d "$toplevel/agents/claude" ] || return 1
  printf '%s' "$toplevel"
}

if [ -n "${COCKPIT_SANDBOX_REMOTE:-}" ]; then
  source="$COCKPIT_SANDBOX_REMOTE"
  reference="$(git -C "$source" rev-parse --abbrev-ref HEAD 2>/dev/null || printf 'default branch')"
  clone_options=()
elif source="$(checkout_here)"; then
  reference="$(git -C "$source" rev-parse --abbrev-ref HEAD)"
  clone_options=()
else
  source="$upstream"
  reference="main"
  clone_options=(--branch main)
fi

if [ "${1:-}" = "--print-source" ]; then
  printf '%s\t%s\n' "$source" "$reference"
  exit 0
fi

fresh="$(mktemp -d)"

if [ "$source" != "$upstream" ] && [ -n "$(git -C "$source" status --porcelain 2>/dev/null)" ]; then
  printf '%s\n' "$source has uncommitted changes; a clone takes committed state only." >&2
fi

printf '%s\n' "cloning $reference from $source" >&2
git clone --quiet "${clone_options[@]+"${clone_options[@]}"}" "$source" "$fresh/cockpit"

HOME="$fresh" bash "$fresh/cockpit/install.sh" --apply
HOME="$fresh" bash "$fresh/.claude-shared/sync.sh" --yes

printf '\n%s\n%s\n\n' \
  "A new user's install is at $fresh, on $reference at $(git -C "$fresh/cockpit" rev-parse --short HEAD)." \
  "Quit it to come back here; the directory is deleted then." >&2

cd "$fresh/cockpit"

HOME="$fresh" PATH="$fresh/.local/bin:$PATH" "$fresh/.local/bin/cockpit" || true

rm -rf "$fresh"
